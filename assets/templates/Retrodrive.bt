//------------------------------------------------
//--- 010 Editor v14.0beta1 Binary Template
//
//      File: Retrodrive.bt
//   Authors: Robert Offner MSc.
//   Version: 1.1
//   Purpose: Parses a Variety of old Floppy Images (FLEX, FDOS, CP/M, es65, CP68, DOS68, D64, D71, D81, ATR, Apple ][,...).
//  Category: Drives
// File Mask: *.img, *.dsk, *.d64, *d71, *.d81, *.atr
//  ID Bytes: // None. Script guesses the Variant (see the switch-case at the end of file)
//   History:
//  1.1  2023-11-03 R. Offner: cleanup, first Apple ][ Implementation.
//  1.0  2023-11-01 R. Offner: first Atari Implementaion, blind header added (not in image but in file), struct positions should be fixed now, CP/M restructured
//  0.9  2023-11-01 R. Offner: first Commodore D81 Implementaion. No Partitions or Subdirs though.
//  0.8  2023-10-30 R. Offner: fixed calc in OFF_to_CHS, added variable sectorcount, first Commodore D64 and D71 Implementaion.
//  0.7  2023-10-28 R. Offner: added DOS68 Format (chained Rootdir Entries)
//  0.6  2023-10-27 R. Offner: added Questionbox if there are more Images with the same size.
//  0.5  2023-10-23 R. Offner: removed skew and made one script to UnSkew a file (UnSkew_Image.1sc)
//  0.4  2023-10-20 R. Offner: added es65 Format, added skew for CP/M.
//  0.3  2023-10-17 R. Offner: added NONE Variant to make it easier to add new formats.
//  0.2  2023-10-10 R. Offner: cleanup, make blocks more universal, CP/M Support added.
//  0.1  2023-10-08 R. Offner: Initial release with FLEX1, FLEX2 and FDOS
// COPYRIGHT NOTE:
// a lot of the code has been taken from the Drive.bt Template
// additional Information:
// D64 format: http://unusedino.de/ec64/technical/formats/d64.html
// FDOS, CP68, DOS68, FLEX1 and FLEX2: https://deramp.com/downloads/swtpc/software/
// ATRARI: http://fileformats.archiveteam.org/wiki/Atari_File_Management_Subsystem
//------------------------------------------------
                         // Variablename
struct IMGFILE;          // imgfile
struct DRIVE;            // drive
struct BOOTSECTOR;       // bootsector
struct FLEX_SIR;         // flex_sir
struct ROOTDIR;          // rootdir
struct SHORTENTRY;       // shortentry
struct DIRENTRYSET;      // direntryset
struct FLEX_CLUSTER;     // cluster
struct D64_CLUSTER;      // cluster
struct SECTORPLAIN;      // sector
struct SECTOR_GENERIC;   // sector
struct CONTROLBLOCK;     // controlblock
struct DOS68_CHAIN;      // dos68_ddb
struct APPLE_CHAIN;      // apple_chain
struct D81_HDR;          // hdr
struct ATARI_VTOC;       // vtoc
struct ATARI_CLUSTER;    // cluster
struct CPMRECORD;        // record

typedef enum <UBYTE> {
    NONE=0,
    FLEX1=1, 
    FLEX2=2,
    FDOS,
    DOS68,
    CP68,
    CPM1,
    CPM2,
    ES65,
    D64,
    D81,
    ATARI1,
    APPLE1,
    NEWFORMAT
 }VARIANT;

// Helper Functions 
UINT64 GETIDX_ES65(UBYTE id, UINT64 pos){
    local UINT64 ret, i <hidden=true>;
    for(i=pos;i<400;i++){
        if (rootdir.es65_map[i] == id){
            //Printf("Found ID: %u @ %u\r", id, i);
            return i;
        }
    }
    return 0xFFFF; // not found
    //Printf("Filename: %s Nr: %i Track: %i Head: %i Sect: %i Offset: %0X\n", fn, seq, cyl, head, sect, ret);
}

// returns filesize by counting the sectors in the sector map
uint16 GET_ES65_FS(ROOTDIR &f, UBYTE id){
    local uint16 ret, i <hidden=true>;
    ret = 0;
    for(i=12;i<400;i++){
    //Printf("Map: %u ID: %i\r",f.es65_map[i], id);
        if (f.es65_map[i] == id) ret++;
    }
    return ret * imgfile.bps;
}

INT64 CHS_to_OFF(UBYTE cyl, UBYTE head, UBYTE sect){
    local INT64 ret <hidden=true> = 0;
    local INT64 c, s;
    local UBYTE i;
    // Commodore weirdness. Tracks are nubered 1-40 for side 0
    // and 41-80 for side 1. Sectors are nubered from 0-39
    if ((imgfile.variant == D64) || 
        (imgfile.variant == D81)){ 
        if (imgfile.s == 0){ // use sectab
            c = (INT64)cyl-1;
            //if (head > 0) { c -= imgfile.c; }
            //Printf("InC: %u S: %u Off: %06X\r", c, sect, ret);
            for (i=0; i<imgfile.c; i++){
                s = (INT64)imgfile.sectab[i];
                c --;
                //Printf("Sectab: %u\r", imgfile.sectab[i]);
                if (c < 0) break;
                ret += imgfile.bps * s;
            }
            //Printf("C: %u S: %u Off: %06X\r", i, sect, ret);
            if (i >= imgfile.c){ // second Side
                for (i=0; i<imgfile.c; i++){
                    s = (INT64)imgfile.sectab[i];
                    c --;
                    //Printf("C: %u\r", c);
                    if (c < 0) break;
                    ret += imgfile.bps * s;
                }
                ret += (INT64)(sect) * imgfile.bps;
            }
            else{
                ret += (INT64)(sect) * imgfile.bps;
            }
            //Printf("C: %u S: %u Off: %06X\r", i, sect, ret);
            return ret + imgfile.blind_header;;
        }
        else{ // all tracks have same ammount of sectors
            ret = (((INT64)(cyl-1) * imgfile.s * imgfile.bps) + (sect * imgfile.bps));
            return ret + imgfile.blind_header;;
        }
    }
    else{
        if (sect > imgfile.s) { sect -= imgfile.s; } //FLEX counts the other side in additional sectors
        ret = (((INT64)cyl * imgfile.s * imgfile.h) + (sect - 1 + head * imgfile.s)) * (INT64)imgfile.bps;
        //Printf("Filename: %s Nr: %i Track: %i Head: %i Sect: %i Offset: %0X\n", fn, seq, cyl, head, sect, ret);
        return ret + imgfile.blind_header;;
    }
}

void OFF_to_CHS(UBYTE &c, UBYTE &h, UBYTE &s, INT64 pos){
    local INT64 secdata, sec, off, i, j <hidden=true>;
    pos = pos - imgfile.blind_header;
    if ((imgfile.variant == D64) || 
        (imgfile.variant == D81)){ 
        if (imgfile.s == 0){ // use sectab
            off = pos;
            for (i=0; i<imgfile.c; i++){
                sec = (INT64)imgfile.sectab[i];
                if (off < (imgfile.bps * sec)) {
                    break;
                }
                off -= imgfile.bps * sec;
            }
            //Printf("Off: %d Side: %i\r", off, hd);
            if (i < imgfile.c){ // first side
                h = 0;
                c = i+1;
                s = (UBYTE)(((off / imgfile.bps) % sec)); // Sector
            }
            else{ // second side
                //off += imgfile.bps * sec;
                for (j=0; j<imgfile.c; j++){
                    sec = (INT64)imgfile.sectab[j];
                    
                    if (off < (imgfile.bps * sec)) {
                        //off += imgfile.bps * sec;
                        //Printf("Brk: %06X idx: %i OLDTrk: %i\r", off, j, i);
                        break;
                    }
                off -= imgfile.bps * sec;
                }
                //Printf("In: %d idx: %i\r", off, j);
                h = 1;
                c = j+1;
                s = (UBYTE)(1 + ((off / imgfile.bps) % sec)); // Sector
                //Printf("In: %06X C: %u S: %u Off: %06X\r",pos, j, s, off);
            }
            //Printf("In: %06X C: %u S: %u Off: %06X\r",pos, c, sec, off);
            return;
        }
        else{ // all tracks have same ammount of sectors
            secdata =  imgfile.s * imgfile.bps;
            c = (UBYTE)(pos / (secdata)) + 1; // Track
            h = (c>40?1:0);
            s = (UBYTE)(((pos / imgfile.bps) % (INT64)imgfile.s)); // Sector
        }
    }
    else{    
        secdata =  imgfile.s * imgfile.bps;
        c = (UBYTE)(pos / (imgfile.h * secdata)); // Track
        h = (UBYTE)(pos / secdata) % imgfile.h;
        s = (UBYTE)(1 + ((pos / imgfile.bps) % (INT64)imgfile.s)); // Sector
        //if (h == 1) s += imgfile.s;
    }
}

void GET_NEXTCPMSECTOR(UBYTE &c, UBYTE &h, UBYTE &s){
    s++;
    if (s <= (imgfile.s)){ // first side (1,2,3,4,5)
        //Printf("FS\r");
    }
    else if (s > imgfile.s){ // end of side (11)
        c = (h==1) ? c+1 : c;
        h = (h==1) ? 0 : 1;
        s = 1;
        //Printf("End of SS\r");
    }
    else {
        //Printf("SS\r");
    }
}

typedef struct {
    local UBYTE i <hidden=true>;
    for (i=0; i<122; i++){
        UBYTE  DataTrack;
        UBYTE  DataSector;
    }
} APPLE_TSL_ENTRY <optimize=false>;

typedef struct {
    UBYTE  not_used1 <bgcolor=cDkGray>;
    UBYTE  NextTSLTrack;
    UBYTE  NextTSLSector;
    UBYTE  not_used2[2] <bgcolor=cDkGray>;
    uint16 SectorOffset;
    UBYTE  not_used3[5] <bgcolor=cDkGray>;
    APPLE_TSL_ENTRY  tsl_entry;

} APPLE_TSL <optimize=false>;

// ########################  Dir Entry Set  ##########################
// This struct makes the directory entry plus the data clusters.
typedef struct {
    local uint16 i,lastpos, j <hidden=true>;
    local UBYTE fs, ft, head,c,h,s,tcb, tslcnt, t <hidden=true>;
    local UBYTE map[16];
    local uint16 SectorSequenceNumber , recordcnt, lrecord <hidden=true>;
    local INT64 pos, addr, blockstart, blockend, nextstart, nextend, off, idx, sec <hidden=true>;

    // Read Long/Short directory entries
    SHORTENTRY shortentry;
    // Get first and last track and sector
    //head = imgfile.h - 1;
    head = 0;
    lastpos = 0;
    tcb = 0;
    tslcnt = 0; t = 0;
    pos = FTell(); // 428
//############################# Here are the Data Blocks following    
    if ((imgfile.variant == NONE)){
        //Printf("Pos: %u", rootdir.pos);
        blockstart = (INT64)imgfile.bootsect + imgfile.blind_header + (imgfile.dir_entries * sizeof(shortentry));
        FSeek(blockstart);        
        SECTORPLAIN sector(imgfile.bps);
    }
    else if ((imgfile.variant == FLEX1) || (imgfile.variant == FLEX2)){
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && ((UBYTE)shortentry.FileName[0] != 0)) { // Not deleted!
            fs = shortentry.FirstSector;
            head = (fs > imgfile.s) ? 1 : 0;
            blockstart = CHS_to_OFF(shortentry.FirstTrack, head, fs);
            FSeek(blockstart);
            //Printf("1Offset: %04X\r", blockstart);
            FLEX_CLUSTER cluster(imgfile.variant == FLEX1 ? 128 : 256);
            for (i=0; i<shortentry.TotalSectors-1; i++){
                fs = cluster.NextSector;
                ft = cluster.NextTrack;
                head = (fs > imgfile.s) ? 1 : 0;
                addr = CHS_to_OFF(ft, head, fs);
                //Printf("Offset: %04X\r", addr);
                FSeek(addr);
                FLEX_CLUSTER cluster(imgfile.variant == FLEX1 ? 128 : 256);
            }
        }
    }
    else if (imgfile.variant == FDOS){ // FDOS uses 0-based sector numbering
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0xE5)) { // Not deleted!
            blockstart = CHS_to_OFF(shortentry.FirstTrack, head, shortentry.FirstSector+1);
            FSeek(blockstart);
            for (i=0; i<shortentry.TotalSectors; i++){
                SECTORPLAIN sector(imgfile.bps);
            }
        }
    }
    else if (imgfile.variant == APPLE1){ // 
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0xE5)) { // Not deleted!
            blockstart = CHS_to_OFF(shortentry.FirstTSLTrack, head, shortentry.FirstTSLSector+1);
            FSeek(blockstart);
            do {
                APPLE_TSL tsl <bgcolor=cLtRed, read=GET_CHS(startof(this))>;
                tslcnt ++;
            } while (tsl.NextTSLTrack > 0);
            for (i=0; i<122; i++){
                ft = tsl[t].tsl_entry.DataTrack[i];
                fs = tsl[t].tsl_entry.DataSector[i];
                //Printf("Track: %d Sector: %d\r", ft, fs);
                if ((ft == 0)) break;
                blockstart = CHS_to_OFF(ft, 0, fs+1);
                FSeek(blockstart);
                SECTORPLAIN sector(imgfile.bps) <bgcolor=cLtGreen>;
            }
        }
    }
    else if (imgfile.variant == CP68){
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0xE5)) { // Not deleted!
            blockstart = CHS_to_OFF(shortentry.FirstTrack, head, shortentry.FirstSector);
            FSeek(blockstart);
            for (i=0; i<shortentry.TotalSectors; i++){
                SECTORPLAIN sector(imgfile.bps);
            }
        }
    }
    else if (imgfile.variant == DOS68){ // DOS68 uses Track + 0x80 and Sector + 0x3F
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0xE5)) { // Not deleted!
            blockstart = CHS_to_OFF(shortentry.FirstTrack-0x80, head, shortentry.FirstSector-0x3F);
            FSeek(blockstart);
            for (i=0; i<shortentry.TotalSectors; i++){
                SECTORPLAIN sector(imgfile.bps);
            }
        }
    }
    else if (imgfile.variant == ATARI1){ // 
        if (shortentry.FileStatus < 0x80) { // Not deleted!
            blockstart = (shortentry.FirstSector-1) * imgfile.bps + imgfile.blind_header;
            FSeek(blockstart);
            for (i=0; i<shortentry.TotalSectors; i++){
                ATARI_CLUSTER sector(imgfile.bps);
                blockstart = (ATARI_SECT_CONV(sector.NextSector)-1) * imgfile.bps + imgfile.blind_header;
                FSeek(blockstart);
            }
        }
    }
    else if (imgfile.variant == ES65){
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0x20)) { // Not deleted!
            //Printf("Name: %s\r", shortentry.FileName);
            for (i=0; i<400; i++){
                idx = GETIDX_ES65(shortentry.FileID, (i==0 ? 10 : idx+1));
                if (idx == 0xFFFF) break;
                //if (shortentry.FileID == 8) Printf("Index1: %04X\r", imgfile.bps * idx);
                FSeek(imgfile.bps * idx);
                j = ReadByte(FTell());
                
                if (((j == 'C') || (j == 'E')) && ((i == 0) || (tcb == 0))){ // shows control block
                    CONTROLBLOCK controlblock(imgfile.bps);
                    tcb = controlblock.SectorsCopy;
                    Printf("tcb: %u idx: %u\r", tcb, idx);
                }
                else {
                    tcb--;
                    SECTORPLAIN sector(imgfile.bps);
                }
            }
        }
    }
    else if ((imgfile.variant == D81) ||
             (imgfile.variant == D64)) {
        if (((UBYTE)shortentry.FileName[0] != 0xFF) && 
            ((UBYTE)shortentry.FileName[0] != 0)  && 
            ((UBYTE)shortentry.FileName[0] != 0x20)) { // Not deleted!
            //Printf("Name: %s\r", shortentry.FileName);
            fs = shortentry.FirstSector;
            ft = shortentry.FirstTrack;
            blockstart = CHS_to_OFF(ft, 0, fs);
            FSeek(blockstart);
            //Printf("Start: %06X FT: %u FS: %u\r", blockstart, ft, fs);
            for (i=0; i<shortentry.TotalSectors; i++){
                D64_CLUSTER cluster;
                fs = cluster.NextSector;
                ft = cluster.NextTrack;
                //head = (ft >= imgfile.c) ? 1 : 0;
                addr = CHS_to_OFF(ft, 0, fs);
                //Printf("Track: %u Sect: %u Off: %06X\r", ft, fs, addr);
                FSeek(addr);
                if (ft == 0) break; // should not happen
                //Printf("Off: %06X NT: %u NS: %u\r", addr, ft, fs);
            }
        }
    }
//    else if ((imgfile.variant == CPM1) || (imgfile.variant == CPM2)){ 
//        if (((UBYTE)shortentry.UserNumber != 0xE5) && (shortentry.AllocationTable[0] != 0)) { // Not deleted!
//            //Printf("Start: %s\r", GET_CHS(blockstart, blockstart));
//            blockstart = ((INT64)shortentry.AllocationTable[0] * imgfile.dir_clust_sz) + imgfile.bootsect + imgfile.blind_header;
//            nextend = blockstart + imgfile.dir_clust_sz;
//            for (i=1; i<(imgfile.variant == CPM1 ? 16 : 8); i++) { // one AllocTab Entry =: one Logical Block
//                nextstart = ((INT64)shortentry.AllocationTable[i] * imgfile.dir_clust_sz) + imgfile.bootsect + imgfile.blind_header;
//                //Printf("i: %i\r", i);
//                if (shortentry.AllocationTable[i] == 0) break;
//                lastpos = i;
//                if ((nextend ) == nextstart){ //continuous block
//                    nextend = nextstart + imgfile.dir_clust_sz;
//                    //Printf("cont: %i\r", i);
//                }
//                else {
//                    //Printf("non cont: %i\r", i);
//                    break;
//                }
//            }
//            //Printf("%s lastpos: %i\r", shortentry.FileName, lastpos);
//            FSeek(blockstart); 
//            OFF_to_CHS(c, h, s, blockstart); 
//            off = blockstart;
//            for (j=0; j<=lastpos; j++){
//                //Printf("Window: %04X - %04X\r", off, nextend);
//                
//                for (sec=0; sec<imgfile.dir_clust_sz/imgfile.bps; sec++){
//                    //Printf("sec: %i\r", sec);
//                    SECTOR_GENERIC sector <format=hex>;
//                    //Printf("OffsetS: %04X C:%i H:%i S:%i - ", off, c, h, s);
//                    GET_NEXTCPMSECTOR(c,h,s);
//                    off = CHS_to_OFF(c,h,s);
//                    //if ((off >= blockstart) && off < nextend) {
//                        FSeek(off);
//                        OFF_to_CHS(c, h, s, off);
//                    //}
//                    //Printf("OffsetE: %04X C:%i H:%i S:%i \r", off, c, h, s);
//                }
//            }
//        }
//    }
    else if ((imgfile.variant == CPM1) || (imgfile.variant == CPM2)){ 
        if (((UBYTE)shortentry.UserNumber != 0xE5) && (shortentry.AllocationTable[0] != 0)) { // Not deleted!
            //Printf("Start: %s\r", GET_CHS(blockstart, blockstart));
            recordcnt = 0;
            for (i=0; i<(imgfile.variant == CPM1 ? 16 : 8); i++) { // one AllocTab Entry =: one Logical Block (Ex.: 2048Byte)
                if (shortentry.AllocationTable[i] == 0) break;
                off = ((INT64)shortentry.AllocationTable[i] * imgfile.dir_clust_sz) + imgfile.bootsect + imgfile.blind_header;
                FSeek(off);
                OFF_to_CHS(c, h, s, off);
                //Printf("StartOffset: %06X C:%i H:%i S:%i \r", off, c, h, s);
                for (sec=0; sec<imgfile.dir_clust_sz/imgfile.bps; sec++){ // Ex.: 2048 / 1024
                    for (lrecord=0; lrecord<(imgfile.bps/imgfile.record);lrecord++){
                        recordcnt ++;
                        if (recordcnt > (shortentry.ExtentCounter*128 + shortentry.TotalRecords)) break;
                        CPMRECORD record <format=hex>;
                    }
                    GET_NEXTCPMSECTOR(c,h,s);
                    off = CHS_to_OFF(c,h,s);
                    FSeek(off);
                    OFF_to_CHS(c, h, s, off);
                    //Printf("OffsetE: %06X C:%i H:%i S:%i \r", off, c, h, s);
                }

            }
        }
    }
    FSeek(pos);

} DIRENTRYSET <optimize=false, read=ReadDIRENTRYSET, comment=ReadRecordCount>;

string ReadRecordCount( DIRENTRYSET &f){
    local string str <hidden=true> ="";
    local UINT64 filesize, records <hidden=true>;
    if ((imgfile.variant == CPM1) ||
            (imgfile.variant == CPM2) ){

        if (f.shortentry.UserNumber == 0xE5) return("");
        else{
            if ((f.shortentry.ExtentCounter)){
                records = (UINT64)f.shortentry.ExtentCounter * imgfile.record + (UINT64)f.shortentry.TotalRecords;
                filesize = records * imgfile.record;
                SPrintf(str, "Multi Record File. Size: %u Rec. %u Bytes.", records, filesize);

            }
            else {
                filesize = ((UINT64)f.shortentry.TotalRecords * imgfile.record);
                SPrintf(str, "Size: %u Rec. %u Byte", f.shortentry.TotalRecords, filesize);
            }
        }
    }
    else if ((imgfile.variant == D64) ||
            (imgfile.variant == D81)) {
        if (((UBYTE)f.shortentry.FileName[0] == 0) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xFF) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xE5) || 
            ((UBYTE)f.shortentry.FileName[0] == 0x20))
            SPrintf(str, "");
        else
            SPrintf(str, "FileSize: <= %i Bytes", f.shortentry.TotalSectors * (imgfile.bps-2));
    }
    else if ((imgfile.variant == FLEX1) ||
             (imgfile.variant == FLEX2)) {
        if (((UBYTE)f.shortentry.FileName[0] == 0) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xFF) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xE5) || 
            ((UBYTE)f.shortentry.FileName[0] == 0x20))
            SPrintf(str, "");
        else
            SPrintf(str, "FileSize: %i Bytes", f.shortentry.TotalSectors * (imgfile.bps-4));
    }
    else if ((imgfile.variant == CP68)  ||
             (imgfile.variant == FDOS)  ||
             (imgfile.variant == DOS68)) {
        if (((UBYTE)f.shortentry.FileName[0] == 0) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xFF) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xE5) || 
            ((UBYTE)f.shortentry.FileName[0] == 0x20))
            SPrintf(str, "");
        else
            SPrintf(str, "FileSize: %i Bytes", f.shortentry.TotalSectors * imgfile.bps);
    }
    else if (imgfile.variant == APPLE1) {
        if ((f.shortentry.FirstTSLTrack == 0xFF) || (f.shortentry.FirstTSLTrack == 0))
            SPrintf(str, "");
        else
            SPrintf(str, "FileSize: %i Bytes", (f.shortentry.TotalSectors) * imgfile.bps);
    }
    else if (imgfile.variant == ATARI1) {
        if (f.shortentry.FileStatus >= 0x80)
            SPrintf(str, "DELETED");
        else
            SPrintf(str, "FileSize: %i Bytes", f.shortentry.TotalSectors * imgfile.bps);
    }
    else if ((imgfile.variant == ES65)){
        if (((UBYTE)f.shortentry.FileName[0] == 0) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xFF) || 
            ((UBYTE)f.shortentry.FileName[0] == 0xE5) || 
            ((UBYTE)f.shortentry.FileName[0] == 0x20))
            SPrintf(str, "");
        else
            SPrintf(str, "FileSize: %i Bytes", GET_ES65_FS(parentof(f), f.shortentry.FileID));        
    }
    return str;
}

string GetAppleFilename(char  afn[30]){
    local char str[30] <hidden=true>;
    local UBYTE i <hidden=true>;
    for (i=0; i<30; i++){ //Apple II Filename is 30 Characters
        str[i] = afn[i] & 0x7F;
    }
    return str;

}

wstring ReadDIRENTRYSET( DIRENTRYSET &f ) {
    if ((imgfile.variant == NONE)){
        return "--FILE--";
    }
    
    else if ((imgfile.variant == FDOS))
        if (((UBYTE)f.shortentry.FileName[0] == 0) || ((UBYTE)f.shortentry.FileName[0] == 0xFF) || ((UBYTE)f.shortentry.FileName[0] == 0xE5)) 
            return "--FREE--";
        else
            return f.shortentry.FileName;
    
    else if ((imgfile.variant == DOS68) ||
             (imgfile.variant == CP68)  ||
             (imgfile.variant == FLEX2) || 
             (imgfile.variant == FLEX1) || 
             (imgfile.variant == ATARI1))
        if (((UBYTE)f.shortentry.FileName[0] == 0) || ((UBYTE)f.shortentry.FileName[0] == 0xFF) || ((UBYTE)f.shortentry.FileName[0] == 0xE5)) 
            return "--FREE--";
        else
            return f.shortentry.FileName+'.'+f.shortentry.FileExtension;
    
    else if ((imgfile.variant == CPM1) ||
             (imgfile.variant == CPM2) )
        if ((f.shortentry.UserNumber == 0xE5)) 
            return "--FREE--";
        else
            return f.shortentry.FileName+'.'+f.shortentry.FileExtension;
    
    else if ((imgfile.variant == D64) ||
            (imgfile.variant == D81) ||
            (imgfile.variant == ES65)) 
        if (((UBYTE)f.shortentry.FileName[0] == 0) || ((UBYTE)f.shortentry.FileName[0] == 0x20)) 
            return "--FREE--";
        else
            return f.shortentry.FileName;

    else if (imgfile.variant == APPLE1)
        if (((UBYTE)f.shortentry.FileName[0] == 0) || ((UBYTE)f.shortentry.FileName[0] == 0x20)) 
            return "--FREE--";
        else
            return GetAppleFilename(f.shortentry.FileName);

    else return "ERROR! No imgfile.variant selected!";
}

// ########################  Data Cluster  ##########################
//  C = LBA ÷ (HPC × SPT)    - LBA: offset, HPC: max. Heads, SPT: Sectors/Track
//  H = (LBA ÷ SPT) mod HPC  - 
//  S = (LBA mod SPT) + 1    - 
//
string GET_CHS(INT64 pos){ //, INT64 pos_start){ //pos is the actual offset of this sector
    local string str <hidden=true>;
    local UBYTE c,h,s <hidden=true>;
    local INT64 blk,secdata, clustersize <hidden=true>;
    OFF_to_CHS(c,h,s,pos);
    clustersize = imgfile.bps;
    if (imgfile.dir_clust_sz != 0) clustersize = imgfile.dir_clust_sz;
    if ((imgfile.variant == CPM1) ||
        (imgfile.variant == CPM2)) {
        blk = (pos - imgfile.bootsect - imgfile.blind_header) / clustersize;
    }
    else
        blk = (pos - imgfile.blind_header) / clustersize;
    if (imgfile.variant == ATARI1){

        SPrintf(str, "C: %u S: %u Sector total: %u", c, s, blk+1);
    }
    else {
        SPrintf(str, "C: %u H: %u S: %u Block: 0x%0X %u", c, h, s, blk, blk);
    }
    //Printf("%s C: %d S: %d\r", imgfile.rootdir.direntryset.shortentry.FileName, c, s);
    return str;
}

