// ########################  ATARI Cluster  ############################
// FLEX Cluster has next Cluster at the first two bytes and Sequence Number
uint16 ATARI_SECT_CONV(uint16 s){
    local uint16 NS <hidden=true> = 0;
    NS = ((s >> 8) & 0xFF);
    //NS += (s % 0x0300);
    NS += (s & 0x03) * 256;
    return NS;
}

string GET_ATARI_POS (uint16 s){
    local string str <hidden=true>;
    local uint16 NS <hidden=true> = 0;
    NS = (s & 0xFC) >> 2;
    SPrintf(str, "Position in Dir: %u", NS);
    return str;
}

typedef struct (int16 Size){ 
    UBYTE  data[Size-3] <format=hex>;
    uint16 NextSector <read=Str("%d", ATARI_SECT_CONV(this)), comment=GET_ATARI_POS>;
    UBYTE ShortSector <format=hex, comment="Bit7 signals Sector not filled">;
} ATARI_CLUSTER <optimize=false, read=GET_CHS(startof(this))>;

