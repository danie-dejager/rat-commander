//■■■■■■■■■■■■■■■■■■■■■■    FUNCTIONS     ■■■■■■■■■■■■■■■■■■■■■■■■■

/* ***************************************************
   Process uncompressed PF structure

   Params: iPos     Initial Position in file
   Return: Offset   Last position read in file
*/
uint64 fDecodePF ( uint64 iPos ) {
    FSeek(iPos);
    FileHeader header;
    switch (header.version) {
        case 30:
        case 31:
            Win10_FileInfomation FileInfo;
            FSeek(FileInfo.MetricsOffset);
            Win10_FileMetricsArray FileMetrics;
            FSeek(FileInfo.ChainsOffset);
            Win10_TraceChainArray TraceChain;
            FSeek(FileInfo.NameStringOffset);
            Win10_FileNameStrings FileName;
            FSeek(FileInfo.VolumesInformationOffset);
            Win10_VolumeInformation VolumeInfo;
            Trailing Data;
            break;
        case 26: 
            Win8_FileInfomation FileInfo;
            FSeek(FileInfo.MetricsOffset);
            Win8_FileMetricsArray FileMetrics;
            FSeek(FileInfo.ChainsOffset);
            Win8_TraceChainArray TraceChain;
            FSeek(FileInfo.NameStringOffset);
            Win8_FileNameStrings FileName;
            FSeek(FileInfo.VolumesInformationOffset);
            Win8_VolumeInformation VolumeInfo;
            Trailing Data;
            break;
        case 23: 
            Win7_FileInfomation FileInfo;
            FSeek(FileInfo.MetricsOffset);
            Win7_FileMetricsArray FileMetrics;
            FSeek(FileInfo.ChainsOffset);
            Win7_TraceChainArray TraceChain;
            FSeek(FileInfo.NameStringOffset);
            Win7_FileNameStrings FileName;
            FSeek(FileInfo.VolumesInformationOffset);
            Win7_VolumeInformation VolumeInfo;
            Trailing Data;
            break;
        case 17:
            Winxp_FileInformation FileInfo;
            FSeek(FileInfo.MetricsOffset);
            Winxp_FileMetricsArray FileMetrics;
            FSeek(FileInfo.ChainsOffset);
            Winxp_TraceChainArray TraceChain;
            FSeek(FileInfo.NameStringOffset);
            Winxp_FileNameStrings FileName;
            FSeek(FileInfo.VolumesInformationOffset);
            Winxp_VolumesInformation VolumeInfo;
            Trailing Data;
            break;
            
        default:
            Printf("Error: unrecognised PF version %d, aborted\n",header.version);
            break;
    };
    return FTell();
};


/* ***************************************************
   Process compressed PF structure

   Params: iPos     Initial Position in file
   Return: Offset   Last position read in file
*/
uint64 fDecodeCompressedPF ( uint64 iPos ) {
    FSeek(iPos);

    // Read in raw file
    CompressedPF   Header;
    local long     ret;

    // Decode
    local ulong  CompressBufferWorkSpaceSize[1];
    local ulong  CompressFragmentWorkSpaceSize[1];
    local ulong  FinalUncompressedSize;
    local byte   UnCompressedBuffer[Header.UnCompressedSz] <format=hex>;

    //get the size of what our workspace needs to be
    ret = RtlGetCompressionWorkSpaceSize(COMPRESSION_FORMAT_XPRESSHUFF, CompressBufferWorkSpaceSize, CompressFragmentWorkSpaceSize);

    if (ret != 0) {
        Printf("Error: RtlGetCompressionWorkSpaceSize() failed, return code %08d\n",ret);
    } else {
        if (CompressFragmentWorkSpaceSize[0]>0) {

            local byte WorkSpace[CompressFragmentWorkSpaceSize[0]];

            local ulong dstSize[1] = 256;

            ret = RtlDecompressBufferEx(COMPRESSION_FORMAT_XPRESSHUFF, UnCompressedBuffer, Header.UnCompressedSz, Header.CompressedBuffer, Header.UnCompressedSz, dstSize, WorkSpace);
            if (ret == 0) {
                Printf("Error: RtlGetCompressionWorkSpaceSize() failed, return code %08d\n",ret);
            };
        
            // Get curent file working directory and create an output folder
            local char sSRCDIR[] = FileNameGetPath(GetFileName());
            local char sFileName[]=FileNameGetBase(GetFileName(), false ); 

            local int hNewFile,hCurFile;
            local char sfileout[],sfiledir[];
            SPrintf(sfileout,"%s_unpacked.pf",sFileName);

            Printf("\nCreating file:\t%s\n",sfileout);

            // Save File
            hCurFile=GetFileNum();
            hNewFile=FileNew("Hex",true);
            FileSelect(hNewFile);
            WriteBytes(UnCompressedBuffer,0,Header.UnCompressedSz);
            
            if (DEBUG) {
                Printf("\n\nDEBUG: file write disabled, execute template on %s manually\n",sfileout);
            } else {
                Printf("\n\nUncompressed PF written to %s\n",sfileout);
                FileSave(sfileout);
               
// Bug: 2026/08/19 Closing and reopening the unpacked file caused 010Editor to crash
                if ( AUTOPROCESS ) {
                    Printf("Reloading file to execute PF template\n");
                    FileClose();

                    // Reopen file and run PF template
                    hNewFile=FileOpen(sfileout,true,"Hex",false);
                    FileSelect(hNewFile);
                } else {
                    FileSelect(hCurFile);
                }
            }
        } else {
            // Should never get here unless its not a compressed PF or another compression algo was used
            Printf("\n\nError: compressed structure did not decompress (zero length or wrong compression type), process aborted\n");

        }
    }
    return FTell();
};



//■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
//■■■■■■■■■■■■■■■■■■■■■■      MAIN       ■■■■■■■■■■■■■■■■■■■■■■■■■

LittleEndian();

local uint32 iSig     <format=hex>;
local uint64 iLastPos <format=hex>;

iSig=ReadUInt(0);


if ( DEBUG ) {
    Printf("\nDEBUG: Signature at 0x0 offset is %08x\n",iSig);
}

if (iSig == 0x044D414d) {       // MAM\0x04 == Compressed PF
    Printf("\n\nNOTICE:\tThis script uses two external functions from c:\\windows\\system32\\ntdll.dll to decompress the contents.\n\tYou maybe prompted twice to allow these calls to be executed.\n\tThis can be permanently enabled under Tools > Options > Permissions and change form Ask to allow for this script\n\n");
    Printf("Type: Compressed PF, decompressing and processing result\n");
    iLastPos=fDecodeCompressedPF(0);
} else {
    iSig=ReadUInt(4);
    if ( DEBUG ) {
        Printf("DEBUG: Signature at 0x4 offset is %08x\n",iSig);
    }
    if (iSig == 0x41434353) {       // SCCA == Standard PF
        Printf("Type: Compressed PF, decompressing and processing result\n");
        iLastPos=fDecodePF(0);
    } else {
        Printf("Error: unrecognised PF file signature %08x\n",iSig);
    }
};
