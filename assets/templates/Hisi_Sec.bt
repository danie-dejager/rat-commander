#define ENCRYPTED_KEYINFO_LEN 256
#define SIGNATURE_LEN_256 256
#define SIGNATURE_LEN_512 512
#define HEADER_SZ 16

typedef struct header{
    unsigned int magic1;
    unsigned short magic2;
    unsigned short version;
    unsigned int contentLen;
    unsigned int key_version;
};

header sechdr;
unsigned char enckeyinfo[ENCRYPTED_KEYINFO_LEN];
unsigned char signature[SIGNATURE_LEN_512];
unsigned char encdata[FileSize()-SIGNATURE_LEN_512-ENCRYPTED_KEYINFO_LEN-HEADER_SZ];
