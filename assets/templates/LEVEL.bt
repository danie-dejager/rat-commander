//------------------------------------------------
//--- 010 Editor v13.0.1 Binary Template
//
//      File: LEVEL.bt
//   Authors: pavidloq (Fred-31), xXCooBloyXx
//   Version: 0.1.1
//   Purpose: Supercell level format for their old game(-s).
//  Category: Game
// File Mask: *.level
//  ID Bytes: 
//   History: 
//   0.1.1   2024-07-24 pavidloq: Made the template more pretty.
//   0.1.0   2024-07-24 xXCooBloyXx: Implemented almost full file reading, base for meshes by Fred-31's SBM 010 template.
//------------------------------------------------


// Iterators
local int i = 0;
local int j = 0;
local int k = 0;


// Endian
BigEndian();


// Base data types
typedef struct {
    ushort size;
    if (size > 0)
        char data[size];
} String <read=stringRead>;

string stringRead(String& v) {
    if (v.size > 0)
        return v.data;
    
    return "";
}


typedef struct {
    float elements[16];
} Matrix4x4;


// Mesh geometry
typedef struct {
    short x;
    short y;
    short z;
    
    short normalX;
    short normalY;
    short normalZ;
    
    short u;
    short v;
} Vertex;


typedef struct {
    for (i = 0; i < verticesCount; i++) {
        Vertex vertex;
    }
} Vertices;


typedef struct {
    ushort vertexIndexA;
    ushort vertexIndexB;
    ushort vertexIndexC;
} Triangle;


typedef struct {
    ushort indicesCount;
    for (i = 0; i < indicesCount / 3; i++) {
        Triangle triangle;
    }
} Triangles;


// Skin
typedef struct {
    String name;
    Matrix4x4 inverseBindMatrix;
} Joint;


typedef struct {
    for (i = 0; i < jointsCount; i++) {
        Joint joint;
    }
} Joints;


typedef struct {
    ubyte jointIndexA;
    ubyte jointIndexB;
    ubyte jointIndexC;
    ubyte jointIndexD;
    
    ubyte weightA;
    ubyte weightB;
    ubyte weightC;
    ubyte weightD;
} VertexWeight;


typedef struct {
    for (i = 0; i < verticesCount; i++) {
        VertexWeight vertexWeight;
    }
} VertexWeights;


typedef struct {
    Joints joints;
    
    Matrix4x4 bindShapeMatrix;
    
    VertexWeights vertexWeights;
} Skin;


// Animation
typedef struct {
    short rotationX;
    short rotationY;
    short rotationZ;
    short rotationW;
    
    float translationX;
    float translationY;
    float translationZ;
} Frame;


typedef struct {
    ushort framesCount;
    for (j = 0; j < framesCount; j++) {
        Frame frame;
    }
} Frames;


typedef struct {
    String jointName;
    String jointParentName;
    
    Frames frames;
} Animation <read=animationRead>;

string animationRead(Animation& v) {
    string result;
    if (v.jointName.size > 0) {
        if (v.jointParentName.size > 0) {
            SPrintf(result, "%s -> %s", v.jointName.data, v.jointParentName.data);
        } else {
            SPrintf(result, "%s", v.jointName.data);
        }
        
        return result;
    }
    
    return "";
}


typedef struct {
    ushort animationsCount;
    for (i = 0; i < animationsCount; i++) {
        Animation animation;
    }
} Animations;


// Mesh
typedef struct {
    String name;
    
    ushort verticesCount;
    
    float vertexScale;
    ushort unk;
    
    ushort jointsCount;
    
    Vertices vertices;
    
    Triangles triangles;
    
    if (jointsCount > 0)
        Skin skin;
    
    Animations animations;
} Mesh <read=meshRead>;

string meshRead(Mesh& v) {
    if (v.name.size > 0)
        return v.name.data;
    
    return "";
}

// Model
typedef struct {
    String name;
    
    ushort unk4; // - 1
    ushort unk5; // - 1

    if (modelsCount > 0) {
        ubyte unk6;
    }
    ubyte meshesCount;
    
    if (meshesCount > 0) {
        ushort unk7;
    }

    for (j = 0; j < meshesCount; j++) {
        Mesh mesh;
    }
} Model <read=modelRead>;

string modelRead(Model& v) {
    if (v.name.size > 0)
        return v.name.data;
    
    return "";
}

typedef struct {
    ushort modelsCount;
    for (k = 0; k < modelsCount; k++) {
        Model model;
    }
} Models;

// MapBlock
typedef struct {
    ubyte unk15;
    local int unk16 = 0;
    do {
        ubyte unk17;
        unk16 = unk17 & 0x7F | (unk16 << 7);
    } while ((unk17 & 0x80) != 0);
    mapBlocksCount = mapBlocksCount - unk16;
} MapBlock;

typedef struct {
    if (mapBlocksCount > 0) {
        do {
            MapBlock mapBlock;
        } while (mapBlocksCount > 0);
    }
} MapBlocks;


typedef struct {
    ushort width;
    ushort height;
    float scaleFactor;

    mapBlocksCount = width * height;
    MapBlocks blocks;
} Map;


// Texture altases
typedef struct {
    uint size;
    ubyte data[size];
} Texture;


typedef struct {
    String name;
    ushort x;
    ushort y;
    ushort width;
    ushort height;
} Sprite;


typedef struct {
    ushort size;
    
    ushort count;
    for (i = 0; i < count; i++) {
        Sprite sprite;
    }
} Sprites;


typedef struct {
    Texture texture;
    Sprites sprites;
} TextureAtlas;


// Main
struct FILE {
    ushort unk1;
    ushort unk2;
    
    Models models;

    TextureAtlas atlas1;
    TextureAtlas atlas2;
    
    local int mapBlocksCount = 0;
    
    Map map;

    ubyte count;
    
    Texture texture1;

    mapBlocksCount = map.width * map.height;
    MapBlocks mapBlocks;

    Texture texture2;

    ubyte tileLayersCount;
    
    mapBlocksCount = map.width * map.height;
    MapBlocks mapBlocks;
} file;

