typedef enum <uint32> {
	UF2_FLAG_NOFLASH        = 0x00000001,
	UF2_FLAG_FILECONTAINER  = 0x00001000,
	UF2_FLAG_FAMILY_ID      = 0x00002000,
	UF2_FLAG_MD5_CHKSUM     = 0x00004000,
	UF2_FLAG_EXTENSION_TAGS = 0x00008000
} UF2_FLAG <edit=flags, format=hex>;

string FlagsComment( UF2_FLAG FLAGS )
{
	string Flagcomment;

	if( FLAGS & UF2_FLAG_NOFLASH)
		Flagcomment += "not main flash - this block should be skipped when writing the device flash\n";
	if( FLAGS & UF2_FLAG_FILECONTAINER)
		Flagcomment += "file container - see documentation\n";
	if( FLAGS & UF2_FLAG_FAMILY_ID)
		Flagcomment += "familyID present - when set, the fileSize/familyID holds a value identifying the board family (usually corresponds to an MCU)\n";
	if( FLAGS & UF2_FLAG_MD5_CHKSUM)
		Flagcomment += "MD5 checksum present - see documentation\n";
	if( FLAGS & UF2_FLAG_EXTENSION_TAGS)
		Flagcomment += "extension tags present - see documentation\n";

	if (Flagcomment == "")
		Flagcomment  = "No flags set";

	return Flagcomment;
}



//---------------------------------------------
// local uint32 UF2_FIRST_MAGIC = 0x0A324655;
local uint32 UF2_SECOND_MAGIC = 0x9E5D5157;
local uint32 UF2_FINAL_MAGIC = 0x0AB16F30;
local uint32 UF2_BLOCK_SIZE = 0x200;
local uint32 UF2_DATA_BLOCK_SIZE = 0x1dc;

typedef struct {
	char		magicStart0[4] <style=sHeading2Accent>;
	uint32		magicStart1 <style=sHeading2Accent>;
	UF2_FLAG 	flags <comment=FlagsComment>;
	uint32		targetAddr;
	uint32		payloadSize;
	uint32		blockNo;
	uint32		numBlocks <format=hex>;
	UF2_FAMILY	fileSize <comment=FamiliesComment>; // or familyID;
    struct {
    	uint8		payload[payloadSize] <style=sDataAccent>;
    	uchar		data[UF2_DATA_BLOCK_SIZE-payloadSize];
    } data <style=sData, format=hex>;
	uint32		magicEnd <style=sHeading3>;
} UF2_Block <style=sHeading2>;



//---------------------------------------------
LittleEndian();

// Do some sanity checks on the block data
local int64 sizeFromFile = FileSize();
if( sizeFromFile < UF2_BLOCK_SIZE )
{
	Warning( "File size is less than a single UF2 block. Template stopped." );
	return -1;
}

// All these checks are done on locals and using Read* to not pollute the output window and preserve the file position
local char magic0[4];
ReadBytes(magic0, 0, 4);
local uint32 magic1 = ReadUInt(1 * sizeof(uint32));
local uint32 magic2 = ReadUInt(UF2_BLOCK_SIZE - sizeof(uint32));
if( magic0 != "UF2\n" || magic1 != UF2_SECOND_MAGIC || magic2 != UF2_FINAL_MAGIC  )
{
	Warning( "File is not a UF2. Template stopped." );
	return -1;
}

// We are assuming that the first block is the same as the rest
// This does not need to be the case according to the spec
local uint32 flags = ReadUInt(2 * sizeof(uint32));
local uint32 targetAddr = ReadUInt(3 * sizeof(uint32));
local uint32 numBlocks = ReadUInt(6 * sizeof(uint32));
local uint32 fileSize = ReadUInt(7 * sizeof(uint32));

if( sizeFromFile != numBlocks * UF2_BLOCK_SIZE )
{
	Printf( "fileSize = 0x%x, numBlocks = 0x%x, UF2_BLOCK_SIZE = 0x%x\n", fileSize, numBlocks, UF2_BLOCK_SIZE);
	Warning( "Reported file size not consistent with number of blocks. Output may be incorrect." );
	// return -1;
}

if (flags & UF2_FLAG_FAMILY_ID )
{
	Printf( "familyID (0x%x) = %s \n", fileSize, FamiliesComment(fileSize));
}
else if ( flags & 0xffffffff )
{
	Warning( "Flags are set which influence data this parser does not support. Check the bytes after block.data[payloadSize] and see upstream docs for more information." );
	// return -1;
}

//---------------------------------------------
// The actual parsing of the file contents

typedef struct (int numBlocks) {
    for( int i = 0; i < numBlocks; i++)
        UF2_Block block;
} UF2_File <style=sHeading1>;
UF2_File file(numBlocks);


