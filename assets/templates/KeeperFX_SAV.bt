/**
 * Structure which stores data copied between levels.
 * This data is not lost between levels of a campaign.
 */
struct IntralevelData {
    unsigned char bonuses_found[BONUS_LEVEL_STORAGE_COUNT];
    
	//struct CreatureStorage transferred_creatures[PLAYERS_COUNT][TRANSFER_CREATURE_STORAGE_COUNT]; //010 Editor note: multi-dimensional arrays are not supported, we change it to a struct (workaround proposed on the 010 Editor manual)
	typedef struct {
		struct CreatureStorage transferred_creatures[PLAYERS_COUNT];
	} CREATURE_STORAGE[TRANSFER_CREATURE_STORAGE_COUNT];
	CREATURE_STORAGE creatureStorage;

	//long campaign_flags[PLAYERS_FOR_CAMPAIGN_FLAGS][CAMPAIGN_FLAGS_PER_PLAYER]; //010 Editor note: multi-dimensional arrays are not supported, we change it to a struct (workaround proposed on the 010 Editor manual)
	typedef struct {
		long campaign_flags[PLAYERS_FOR_CAMPAIGN_FLAGS];
	} CAMPAIGN_FLAGS[CAMPAIGN_FLAGS_PER_PLAYER];
	CAMPAIGN_FLAGS campaignFlags;
};

