string PaddingCommentFunc(char &padding)
{
  return "This member doesn't exist in the original KeeperFX source code but the compiler produces padding bytes (as pragma pack() directive was used) like this one, so this is necessary";
}

/* This function helps to detect if one of the main structs is not well parsed (if the size specified by its chunk header does not match
the size of the main struct after 010 Editor parsed it) and jumps to the next main struct in that case */
void maybeSkipBytes(int64 startOfHeaderStruct, int64 lenOfDataBlock, unsigned long lenOfHeaderBlock, string blockName) {
	local int64 currPos = FTell();
	local int64 lastByte = startOfHeaderStruct + lenOfHeaderBlock;
	local string reason;
  SPrintf(reason, "This is due to that an unexpected KeeperFX savegame version has been loaded here.\nAre you really loading a savegame from KeeperFX v0.4.9.2762 or compatible version (with same savegame size: %d bytes)?\n", EXPECTED_SAVEGAME_SIZE);
	if (currPos < lastByte) {
    local string smallStruct;
    SPrintf(smallStruct, "%s block is INCORRECT, %d bytes has not been parsed for this struct (its FileChunkHeader says it must be %d bytes long but it's %d).\n%s", blockName, lastByte - currPos, lenOfHeaderBlock, lenOfDataBlock, reason);
    Printf(smallStruct);
    Warning(smallStruct);
    FSkip(lenOfHeaderBlock - lenOfDataBlock);
	} else if (currPos > lastByte) {
		local string biggerStruct;
    SPrintf(biggerStruct, "%s block is INCORRECT, %d bytes exceed the expected size for this struct (its FileChunkHeader says it must be %d bytes long but it's %d).\n%s", blockName, currPos - lastByte, lenOfHeaderBlock, lenOfDataBlock, reason);
		Printf(biggerStruct);
    Warning(biggerStruct);
    FSeek(startOfHeaderStruct + lenOfHeaderBlock + lenOfDataBlock);
	}
}

while(!FEof()) {
	if (FTell() + sizeof(FileChunkHeader) > FileSize()) {
    local string incompleteChunkErr;
    SPrintf(incompleteChunkErr, "Incomplete chunk header found at position %ld, more bytes are needed. These leftover bytes can probably be from a higher savegame version\n", FTell());
    Printf(incompleteChunkErr);
		Warning(incompleteChunkErr);
		SetCursorPos(FTell());
		SetSelection( FTell(), FileSize() - FTell());
		return;
	}
	FileChunkHeader hdr;
	switch(hdr.id) {
		case SGC_InfoBlock:
			Printf("INFO (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			CatalogueEntry INFO;
      maybeSkipBytes(startof(INFO), sizeof(INFO), hdr.len, "INFO");
			break;
		case SGC_GameAdd:
			Printf("GADD (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			GameAdd GADD;
			maybeSkipBytes(startof(GADD), sizeof(GADD), hdr.len, "GADD");
			break;
		case SGC_GameOrig:
			Printf("OLDS (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			Game OLDS;
			maybeSkipBytes(startof(OLDS), sizeof(OLDS), hdr.len, "OLDS");
			break;
		case SGC_PacketHeader:
			Printf("PHDR (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			PacketSaveHead packetSaveHead;
			maybeSkipBytes(startof(packetSaveHead), sizeof(packetSaveHead), hdr.len, "PHDR");
			break;
		case SGC_PacketData: //010 Editor note: TODO: is this entire case correct? See game_saves.c file from KeeperFX
			Printf("PCKT (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			Printf("Incompatible PacketData chunk\n");
			FSkip(hdr.len);
			break;
		case SGC_IntralevelData:
			Printf("ILVL (%ld bytes) at position %ld\n", hdr.len, startof(hdr));
			IntralevelData intraLevelData;
			maybeSkipBytes(startof(intraLevelData), sizeof(intraLevelData), hdr.len, "ILVL");
			break;
		default:
      local string unrecognizedChunkErr;
			SPrintf(unrecognizedChunkErr, "Unrecognized chunk, ID = %08lx at position %ld or these additional bytes are from a higher savegame version\n",hdr.id, startof(hdr.id));
      Printf(unrecognizedChunkErr);
      Warning(unrecognizedChunkErr);
			SetCursorPos(FTell() - sizeof(hdr));
		  SetSelection(FTell() - sizeof(hdr), sizeof(hdr));
      return;
			//break;
	}
	Printf("\n");
}
