//------------------------------------------------
//--- 010 Editor v13.0.1 Binary Template
//
//      File: BTCBlock.bt
//   Authors: Larry Friedman
//     Email: lfriedman45@gmail.com
//   Version: 1.5
//   Purpose: Decode Bitcoin Core block
//  Category: Misc
// File Mask: *.dat
//  ID Bytes: F9 BE B4 D9  // Bitcoin Core Magic bytes
//   History:  
//   1.5   2023-02-23  L. Friedman: Fix bug: Undefined variable exposed if EXTENDED_VERSION_2 not defined.
//   1.4   2023-02-20  L. Friedman: Fix bug: multiple Stack item objects not processed; limit parse recursion. 
//   1.3   2023-01-02  L. Friedman: Add optional decoding of pushed data and Witness stack items.
//   1.1   2022-12-15  L. Friedman: Add optional parsing of Script (default: ON).
//   1.0   2022-12-09  L. Friedman: Initial Release.
//    
//------------------------------------------------

// Bitcoin Core blknnnnn.dat files contain varying numbers of Bitcoin blocks comprising
// the Bitcoin blockchain. Each block contains Bitcoin transactions. There may be from
// 1 up to many thousands of transactions in a block. This Template decodes a block into
// its component objects. It should work on any Bitcoin node implementation that uses the
// Bitcoin Core format for blockchain data.


/************************************  PARSING AND DECODING  ******************************/
// Parsing Script and decoding other objects requires a lot of processing. The extent of 
// processing is optional and controlled by '#define' statements below.
//
// Template version 1.1 parses Bitcoin Script found in ScriptSig (if present) and ScriptPubKey
// fields.
//
// Template version 1.3  examines data that are pushed looking for either objects (such as
// keys or signatures) or Script. In this process it is possible that pushed data will be
// misinterpreted as Script when in fact it is not. There is no semantic knowledge in the
// parsing so this error can happen. But the error is rare and usually pretty obvious upon 
// examination. 
//
// Template version 1.4 limits recursive parsing of pushed data. Fixes bug: multiple objects
// in Witness Stack items were not processed causing eventual crash.


#define EXTENDED_VERSION_1
// This '#define' enables parsing Bitcoin Script found in ScriptSigs and ScriptPubKeys 
// for display in the Template Results window.
//
// Remove or corrupt the '#define' to inhibit parsing and decoding. Inhibiting this in 
// effect reverts this Template to version 1.0. This will speed up processing significantly.


#define EXTENDED_VERSION_2
// This '#define' enables decoding of pushed data and Witness stack items neither of which
// are necessarily Script. Requires EXTENDED_VERSION_1.
//
// Remove or corrupt the '#define' to inhibit pushed data and Witness stack item decoding
// leaving only parsing of Script. This will speed up processing.


/******************************************************************************************/

#define CHOOSE_BTC_BLOCK
// This '#define' causes the code to prompt for a specific block number in the file
// for display. NOTE: This is NOT the Bitcoin block number (height). It is the block 
// number relative to the number of blocks in the specific Bitcoin Core data file. 
// Remove or corrupt the '#define' to default to block 0.

#define USE_0X_HEX_FORMAT
// The values displayed in hex vs. decimal are those whose displayed format makes
// certain Bitcoin entities more meaningful. Author prefers displaying hex values 
// with the "0x" prefix rather than the "h" suffix. Remove or corrupt to use the 
// "h" suffix formatting for the hex values treated uniquely.


#ifdef USE_0X_HEX_FORMAT
local string Fmtstr = "0x%X";
#else
local string Fmtstr = "%xh";
#endif

typedef uchar btcUchar<read=btcU8>;
string btcU8 (uchar n) {
  return Str(Fmtstr, n);
}

typedef uint16 btcUint16<read=btcU16>;
string btcU16 (uint16 n) {
  return Str(Fmtstr, n);
}

typedef uint32 btcUint32<read=btcU32>;
string btcU32 (uint32 n) {
  return Str(Fmtstr, n);
}


typedef uint32  BTCLEN;


/*********************************  PARSING AND DECODING SUPPORT **************************/
#ifdef EXTENDED_VERSION_1

#ifdef EXTENDED_VERSION_2
// Very likely that pushed data beyond one level of parsing isn't really Script even though it 
// may consist of legal opcodes by chance. Particularly true of very short pushed items. 
// Impose a recursion limit.
local uchar PRLEVEL = 0;     // Current run time pushed data parse recursion level
local uchar PRLIMIT = 1;     // Limit decode recursion.

local uchar ISOP_RETURN;
#endif

// Some easy to identify objects that can be found in data pushed in Script    
// or as Witness Stack items.
local enum <uchar> DATAOBJECT 
      {
        doDERSig, // DER style signature 
        doSSig,   // Probably a Schnorr signature
        doMofN,   // 'm of n' multisignature object
        doHASH20, // Data of length 20 assumed to be a hash, not Script.
        doHASH32, // Data of length 32 assumed to be a hash, not Script. 
        doCPK,    // Compressed public key
        doUPK,    // Uncompressed public key
        do1BYTE,  // Special case for a single byte Witness Stack item
        doIDK     // No recognized object found (I Don't Know)
      };

// Parse/decode context. 
local enum <uchar> CONTEXT  
      {
        cSCRIPTSIG,        // ScriptSig 
        cSCRIPTPK,         // ScriptPubKey
        cWITNESS,          // Witness. Parse without moving file pointer. Might not be Script.
        cVIRTUAL=cWITNESS, // Synonym for cWITNESS. For coding clarity when probing pushed data. 
        cREPARSE           // Used after virtual parse success to parse known good syntax.
      };

// Support for parsing and displaying Script opcodes and Sighash flags 
local uchar opcTableSize     = 75;
local uchar sighashTableSize = 12;

typedef struct IDStruct {
  uint16 id;
  char   String[];
} ;

local IDStruct sighashflag[sighashTableSize];

   // Search function depends on increasing order of id.
   sighashflag[0].id  =   1; sighashflag[0].String  = "SIGHASH_ALL";
   sighashflag[1].id  =   2; sighashflag[1].String  = "SIGHASH_NONE";
   sighashflag[2].id  =   3; sighashflag[2].String  = "SIGHASH_SINGLE";
   sighashflag[3].id  =  65; sighashflag[3].String  = "SIGHASH_ALL";
   sighashflag[4].id  =  66; sighashflag[4].String  = "SIGHASH_NONE";
   sighashflag[5].id  =  67; sighashflag[5].String  = "SIGHASH_SINGLE";
   sighashflag[6].id  = 129; sighashflag[6].String  = "SIGHASH_ALL/ANY1PAY";
   sighashflag[7].id  = 130; sighashflag[7].String  = "SIGHASH_NONE/ANY1PAY";
   sighashflag[8].id  = 131; sighashflag[8].String  = "SIGHASH_SINGLE/ANY1PAY";
   sighashflag[9].id  = 193; sighashflag[9].String  = "SIGHASH_ALL/ANY1PAY";
   sighashflag[10].id = 194; sighashflag[10].String = "SIGHASH_NONE/ANY1PAY";
   sighashflag[11].id = 195; sighashflag[11].String = "SIGHASH_SINGLE/ANY1PAY";


local IDStruct opcode[opcTableSize];

   // Search function depends on increasing order of id.
   opcode[0].id  =   0; opcode[0].String  = "OP_0  ";
   opcode[1].id  =  76; opcode[1].String  = "OP_PUSHDATA1  ";
   opcode[2].id  =  77; opcode[2].String  = "OP_PUSHDATA2  ";
   opcode[3].id  =  78; opcode[3].String  = "OP_PUSHDATA4  ";
   opcode[4].id  =  79; opcode[4].String  = "OP_1NEGATE  ";
   opcode[5].id  =  97; opcode[5].String  = "OP_NOP  ";
   opcode[6].id  =  99; opcode[6].String  = "OP_IF  ";
   opcode[7].id  = 100; opcode[7].String  = "OP_NOTIF  ";
   opcode[8].id  = 103; opcode[8].String  = "OP_ELSE  ";
   opcode[9].id  = 104; opcode[9].String  = "OP_ENDIF  ";
   opcode[10].id = 105; opcode[10].String = "OP_VERIFY  ";
   opcode[11].id = 106; opcode[11].String = "OP_RETURN  ";
   opcode[12].id = 107; opcode[12].String = "OP_TOTALSTACK  ";
   opcode[13].id = 108; opcode[13].String = "OP_FROMALTSTACK  ";
   opcode[14].id = 109; opcode[14].String = "OP_2DROP  ";
