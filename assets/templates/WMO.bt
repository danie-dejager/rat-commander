// ============= MODD Chunk ======================

string OfsDoodadFileNameMODNFinder(int rec){
    if( exists(WMO_File.MODN) && (rec<FileSize())){
	    string a;        
        local int64 OfsMODN = startof(WMO_File.MODN);        
        local string sRefDoodadName = ReadString(OfsMODN+0x8+rec);
	    SPrintf(a, "%d->%s\n", rec, sRefDoodadName);
	    return a;
    }else{
        return Str("%d->N/A", rec);
    } 
}

typedef struct{
    uint32 NameIndex: 24<read=Str("%s",OfsDoodadFileNameMODNFinder(this))>;         // reference offset into MODN, or MODI, depending on version and presence. Note that if MODN is used it is a byte offset to the beginning of filepath 0-terminated string, for MODI it is an index.
    uint32 Flag_AcceptProjTex: 1; // If set, the doodad can have textures projected onto it, e.g. the npc selection circle
    uint32 Flag_0x2: 1;           // MapStaticEntity::field_34 |= 1 (if set, MapStaticEntity::AdjustLighting is _not_ called). When enabled uses wmo interior lighting function, when disabled uses exterior lighting
    uint32 Flag_0x4: 1;
    uint32 Flag_0x8: 1;
    uint32 Unk1: 4;                // unused as of 7.0.1.20994
    C3Vector Position;             // (X, Z, -Y)
    C4Vector Orientation;          // (X, Y, Z, W)
    float Scale;                   // scale factor
    C4ByteColor Color;             // (B,G,R,A) overrides pc_sunColor
                                   // when A is != 0xff && A < 255, A is a MOLT index and that's used instead the RGB given here, taking distance and intensity into account
                                   // If A > MOLT count, then MOLT[0] is used
                                   // If A == 255, the shading direction vector is based on the center of the group and not the sun direction vector, the look-at vector from group bounds center to doodad position
}sMODD_Entry<read=Str("%s ", ExtractFilename(OfsDoodadFileNameMODNFinder(NameIndex)))>;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) sMODD_Entry DoodadDefList[Hdr.Size/40]<optimize=false>;
}sMODD<read=Str("%d : DoodadDefList", Hdr.Size/40)>;

