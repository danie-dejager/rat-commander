typedef enum<uint16>{
    Flag_XAxis = 0x0,
    Flag_YAxis = 0x1,
    Flag_ZAxis = 0x2,
    Flag_AxisMask = 0x3,
    Flag_Leaf = 0x4,
    Flag_NoChild = 0xFFFF
}E_MOBN_FLAGS;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size!=0){
        struct{
            for(int i=0; i<(Hdr.Size/16); i++){
                struct{
                    E_MOBN_FLAGS Flags; // See above enum. 4: leaf, 0 for YZ-plane, 1 for XZ-plane, 2 for XY-plane
                    int16 NegChild;   // index of bsp child node (right in this array)
                    int16 PosChild;
                    uint16 nFaces;    // num of triangle faces in MOBR
                    uint32 FaceStart; // index of the first triangle index(in MOBR)
                    float PlaneDist;
                }MOBN_Entry;
            }
        }sMOBN_Container; //<open=true>;
    }
}sMOBN<read=Str("%d : BSP Nodes", Hdr.Size/16)>;

