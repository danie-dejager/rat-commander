//------------------------------------------------
//--- 010 Editor v15.0.1 Binary Template
//
//      File: WMO.bt
//   Authors: Alastor Strix'Efuartus
//   Version: 1.2.0
//   Purpose: Parses a Blizzard ".WMO" (World Model Object)
//  Category: Game
// File Mask: *.WMO
//  ID Bytes: 52 45 56 4D
//   History: WMO is a chunked structure there are two types of WMO files Root and Group
//   1.2.0 2026-08-05 Alastor: wowdev WMO chunk coverage, modern light/volume refs, and named raw fallbacks
//   1.1.0 2026-08-05 Alastor: Sequential, bounds-checked chunk discovery with raw unknown-chunk fallback
//   1.0.0 2026-01-22 Alastor: Finalized the template to fully working state
//	 0.0.1 2025-04-24 Alastor: MVER Chunk reading
//------------------------------------------------

// ============== Helper Functions ==================

string ExtractFilename(string path){
    local int i;
    local int lastSlash = -1;
    
    // Manually find last backslash position
    for (i = 0; i < Strlen(path); i++){
        if (path[i] == '\\') {
            lastSlash = i;
        }
    }
    
    // Return substring after last backslash
    if(lastSlash >= 0){
        return SubStr(path, lastSlash+1, Strlen(path)-lastSlash-1);
    }
    return path;
}

string Rev4Char(string input){
    if (Strlen(input) != 4){
        Printf("Error: Input string must be exactly 4 characters long\n");
        return "";
    }

    local char reversed[4]; // Manually reverse the characters
    reversed[0] = input[3];
    reversed[1] = input[2];
    reversed[2] = input[1];
    reversed[3] = input[0];

    return reversed;
}

typedef struct{
    CHAR Magic[4];
    local string sRN = Str("%s%s%s%s", Magic[3], Magic[2], Magic[1], Magic[0]);        
    uint Size<format=hex>;
}sHdr<name=Str("%s_Header", sRN), read=Str("Size: %LXh", Size), fgcolor=cYellow, comment="Chunk Header">;    

typedef struct{
    sHdr Hdr;
    if(Hdr.Size > 0){
        ubyte Data[Hdr.Size]<open=false, optimize=true>;
    }
}sUnknownChunk<read=Str("%d raw bytes", Hdr.Size), open=false, comment="Unknown WMO chunk">;

typedef struct{
    // Byte 1 (0x000000FF)
    uint32 BSPTree_0x1         :1;   // Has BSP tree (MOBN and MOBR chunk)
    uint32 HasLightMap_0x2     :1;   // Has light map (MOLM, MOLD) (UNUSED: 20740)
    uint32 HasVertexColor_0x4  :1;   // Has vertex colors (MOCV chunk)
    uint32 EXTERIOR_0x8        :1;   // Outdoor group - affects doodad culling
    
    // Byte 2 (0x000000F0)
    uint32 Unk_0x10            :1;   // (UNUSED: 20740)
    uint32 Unk_0x20            :1;   // (UNUSED: 20740)
    uint32 EXTERIOR_LIT_0x40   :1;   // Use exterior lighting for this group
    uint32 UNREACHABLE_0x80    :1;   // Group is unreachable
    
    // Byte 3 (0x0000FF00)
    uint32 SkyInInterior_0x100 :1;   // Show exterior sky in interior group
    uint32 HasLights_0x200     :1;   // Has lights (MOLR chunk)
    uint32 LOD_0x400           :1;   // Load for LoD != 0 (_lod* groups)
    uint32 HasDoodads_0x800    :1;   // Has doodads (MODR chunk)
    
    // Byte 4 (0x0000F000)
    uint32 LIQUIDSURFACE_0x1000     :1; // Has water (MLIQ chunk)
    uint32 INTERIOR_0x2000          :1; // Indoor group
    uint32 Unk_0x4000               :1; // (UNUSED: 20740)
    uint32 QueryMountAllowed_0x8000 :1; // Pre-WotLK mount query flag
    
    // Byte 5 (0x00FF0000)
    uint32 ALWAYSDRAW_0x10000  :1;   // Always draw group (clears 0x8 after creation)
    uint32 Unk_0x20000         :1;   // Has MORI and MORB chunks
    uint32 ShowSkybox_0x40000  :1;   // Show skybox (if MOSB present)
    uint32 OceanLiquid_0x80000 :1;   // is_not_water_but_ocean (LiquidType related)
    
    // Byte 6 (0x00F00000)
    uint32 Unk_0x100000            :1;
    uint32 IsMountAllowed_0x200000 :1; // Mount allowed in this area
    uint32 Unk_0x400000            :1; // (UNUSED: 20740)
    uint32 Unk_0x800000            :1;
    
    // Byte 7 (0xFF000000)
    uint32 CVERTS2_0x1000000       :1; // Has second MOCV chunk (alpha blending only)
    uint32 TVERTS2_0x2000000       :1; // Has two MOTV chunks
    uint32 ANTIPORTAL_0x4000000    :1; // Create occluders (requires UNREACHABLE)
    uint32 UnkRenderFlag_0x8000000 :1; // Disables batch rendering but keeps doodads
    
    // Byte 8 (0xFF00000000)
    uint32 Unk_0x10000000           :1; // (UNUSED: 20740)
    uint32 EXTERIOR_CULL_0x20000000 :1; // Exterior culling flag (20740+)
    uint32 TVERTS3_0x40000000       :1; // Has three MOTV chunks (for shader 18)
    uint32 Unk_0x80000000           :1; // Seen in kultiras WMOs
    
    // Extended flags (flags2)
    //uint32 canCutTerrain_0x100000000     :1; // Can cut terrain
    //uint32 shadowMapGen_0x200000000      :1; // Shadow map generation flag
    //uint32 shadowMapDepth_0x400000000    :1; // Shadow map depth flag
    //uint32 shadowMapReserved_0x800000000 :1; // Shadow map reserved flag
} bGroupFlags;

typedef struct{
    // ( Byte 0x0000000F )
    ubyte Has_BSP_0x1               :1; // Has BSP tree (MOBN and MOBR chunk).
    ubyte Has_LIGHTMAP_0x2          :1; // Has light map (MOLM, MOLD). (UNUSED: 20740) possibly: subtract mohd.color in mocv fixing 
    ubyte Has_VERTEXCOLOR_0x4       :1; // Has vertex colors (MOCV chunk).
    ubyte Outdoor_0x8               :1; // EXTERIOR - Outdoor - also influences how doodads are culled. If camera is AABB present in a group with this flag, and not present in any group with SMOGroup::INTERIOR, render all exteriors
    // ( Byte 0x000000F0 )
    ubyte Unk_Unused_0x10           :1; // (UNUSED: 20740)
    ubyte Unk_Unused_0x20           :1; // (UNUSED: 20740)
    ubyte Exterior_Lit_0x40         :1; // EXTERIOR_LIT -- "Do not use local diffuse lightning". Applicable for both doodads from this wmo group(color from MODD) and water(CWorldView::GatherMapObjDefGroupLiquids). If group has SMOGroup::INTERIOR flag and this flag then exterior lighting is used for the group)
    ubyte Unk_Unreachable_0x80      :1; // UNREACHABLE
    // ( Byte 0x00000F00 )
    ubyte RenderExtSkyIndoor_0x100  :1; // Show exterior sky in interior WMO group (Used for interiors of city in stratholme_past.wmo)
    ubyte Has_Lights_0x200          :1; // Has lights (MOLR chunk)
    ubyte Has_MPBV_MPBP_MPBI_MPBG_0x400 :1; // <= Cataclysm: Has MPBV, MPBP, MPBI, MPBG chunks, neither 0.5.5, 3.3.5a nor Cataclysm alpha actually use them though, but just skips them. Legion+(?): SMOGroup::LOD: Also load for LoD != 0 (_lod* groups). Seems to disable shadow casting when on
    ubyte Has_Doodads_0x800         :1; // Has doodads (MODR chunk)
    // ( Byte 0x0000F000 )
    ubyte Has_Water_0x1000          :1; // LIQUIDSURFACE -- Has water (MLIQ chunk)
    ubyte Is_Indoor_0x2000          :1; // INTERIOR -- Indoor
    ubyte Unk_0x4000                :1; // (UNUSED: 20740)
    ubyte QueryMountAllowed_0x8000  :1; // QueryMountAllowed in pre-WotLK
    // ( Byte 0x000F0000 )
    ubyte AlwaysDraw_0x10000        :1; // ALWAYSDRAW - clear 0x8 after CMapObjGroup::Create() in MOGP and MOGI
    ubyte Has_MORI_MORB_0x20000     :1; // (UNUSED: 20740) Has MORI and MORB chunks.
    ubyte Show_Skybox_0x40000       :1; // Show skybox -- automatically unset if MOSB not present
    ubyte Is_Not_Ocean_0x80000      :1; // is_not_water_but_ocean, LiquidType related, see below in the MLIQ chunk.
    // ( Byte 0x00F00000 )
    ubyte Unk_0x100000              :1; //
    ubyte IsMountAllowed_0x200000   :1; // IsMountAllowed
    ubyte Unk_0x400000              :1; // (UNUSED: 20740)
    ubyte Unk_0x800000              :1; //
    // ( Byte 0x0F000000 )
    ubyte Has_TWO_MOCV_0x1000000    :1; // CVERTS2: Has the second MOCV chunks: If the flag 0x4 isn't set this is the only MOCV chunk in the group. Whether the flag 0x4 is set or not: only the alpha values from this chunk are used (to blend the textures). FixColorVertexAlpha must not be used on this chunk !
    ubyte Has_TWO_MOTV_0x2000000    :1; // TVERTS2: Has two MOTV chunks: Just add two.
    ubyte AntiPortal_0x4000000      :1; // ANTIPORTAL: Just call CMapObjGroup::CreateOccluders() independent of groupname being "antiportal". requires intBatchCount == 0, extBatchCount == 0, UNREACHABLE.
    ubyte NoBatchRender_0x8000000   :1; // unk. requires intBatchCount == 0, extBatchCount == 0, UNREACHABLE. When set seems to disable rendering of batches, but still renders doodads
    // ( Byte 0xF0000000 )
    ubyte Unk_0x10000000            :1; // (UNUSED: 20740)
    ubyte ExteriorCull_0x20000000   :1; // >> 20740ᵘ EXTERIOR_CULL
    ubyte TVerts3_0x40000000        :1; // TVERTS3: Has three MOTV chunks, eg. for MOMT with shader 18.
    ubyte Flags2_0x80000000         :1; // Seen in world/wmo/kultiras/human/8hu_warfronts_armory_v2_000.wmo vv flags2
    
    //ubyte CanCutTerrain_0x100000000  :1; // canCutTerrain
    //ubyte depSHADOWMAPGEN_0x30000000 :1; // depSHADOWMAPGEN | depSHADOWMAPGEN_DEPTH as per "(m_groupFlags & (SMOGroup::depSHADOWMAPGEN | SMOGroup::depSHADOWMAPGEN_DEPTH)) == 0" and *(_DWORD *)(a1 + 36) & 0x30000000. yes, this clashes with EXTERIOR_CULL, but that's in the same version. weird.
}sMOGP_FLAGS;

typedef struct{
    uint32 CanCutTerrain_0x1 :1; // ≥ Mists has portal planes to cut
    uint32 Unk_0x2  :1;
    uint32 Unk_0x4  :1;
    uint32 Unk_0x8  :1;
    uint32 Unk_0x10 :1;
    uint32 Unk_0x20 :1;
    uint32 IsSplitGroupParent_0x40 :1; // ≥ SL since around 9.2.0
    uint32 IsSplitGroupChild_0x80 :1;  // ≥ SL since around 9.2.0
    uint32 Flags2_Attachment_Mesh :1;  // ≥ 9.2, ≤ 11.0
}sMOGPGroupFlags2;

// ============= Data Types =====================

// C2iVector --------------------------------------------------------------------

typedef struct{
	int x;
	int y;
}C2iVector<read=C2iVectorRead, write=C2iVectorWrite, optimize=false>;

string C2iVectorRead(C2iVector& rec){
	string a;
	SPrintf(a, "(%d %d)\n", rec.x, rec.y);
	return a;
}

void C2iVectorWrite(C2iVector& rec, string s){
	SScanf(s, "(%d %d)", rec.x, rec.yz);
}

// C2Vector --------------------------------------------------------------------

typedef struct{
	float x;
	float y;
}C2Vector<read=C2VectorRead, write=C2VectorWrite, optimize=false>;

string C2VectorRead(C2Vector& rec){
	string a;
	SPrintf(a, "(%f %f)\n", rec.x, rec.y);
	return a;
}

void C2VectorWrite(C2Vector& rec, string s){
	SScanf(s, "(%f %f)", rec.x, rec.yz);
}

// C4Byte ----------------------------------------------------------------

typedef struct{
	unsigned char x;
	unsigned char y;
	unsigned char z;
	unsigned char w;
}C4Byte<read=C4ByteRead, optimize=false>;

string C4ByteRead(C4Byte& rec){
	string a;
	SPrintf(a, "(%u %u %u %u)\n", rec.x, rec.y, rec.z, rec.w);
	return a;
}

// C3Vector --------------------------------------------------------------------

typedef struct{
	float x;
	float y;
	float z;
}C3Vector<read=C3VectorRead, write=C3VectorWrite, optimize=false>;

string C3VectorRead(C3Vector& rec){
	string a;
	SPrintf(a, "(%f %f %f)\n", rec.x, rec.y, rec.z);
	return a;
}

void C3VectorWrite(C3Vector& rec, string s){
	SScanf(s, "(%f %f %f)", rec.x, rec.y, rec.z);
}

// C4Vector --------------------------------------------------------------------

typedef struct{
  float x;
  float y;
  float z;
  float w;
}C4Vector<read=C4VectorRead, write=C4VectorWrite, optimize=false>;

string C4VectorRead(C4Vector& rec){
  string a;
  SPrintf(a, "(%f %f %f %f)\n", rec.x, rec.y, rec.z, rec.w);
  return a;
}

void C4VectorWrite(C4Vector& rec, string s){
  SScanf(s, "(%f %f %f %f)", rec.x, rec.y, rec.z, rec.w);
}

// C4ByteColor ----------------------------------------------------------------

typedef struct{
	uchar B;
	uchar G;
	uchar R;
	uchar A;
}C4ByteColor<read=C4ByteColorRead, optimize=false, edit=color>;

string C4ByteColorRead(C4ByteColor& rec){
	string a;
	SPrintf(a, "#%02LX%02LX%02LX %d%%\n", rec.R, rec.G, rec.B, (rec.A/255)*100);
	return a;
}

// =============================== Individual Chunks ================================

// ============= MVER Chunk =====================
typedef struct{
    sHdr Hdr;
    struct{
        if((Hdr.Size/4)==1){
            uint Version;
        }else{
            uint Version[Hdr.Size/4];
        }        
    }sMVER_Container<open=true, read=Str("%d : Ver", ReadUInt(startof(Version)))>;
}sMVER<read=Str("%d : Ver", ReadUInt(startof(sMVER_Container.Version)))>;

// ============= MOMO Chunk ===================== ≤ PreVanilla (0.5.5.3494).

typedef struct{
    sHdr Hdr;
}sMOMO<read=Str("Wrapper")>;

// ============= MOHD Chunk =====================

typedef struct{
    sHdr Hdr;
    struct{
        uint32 nTextures;     // n Textures (BLP Files)
        uint32 nGroups;       // n WMO groups
        uint32 nPortals;      // n Portals
        uint32 nLights;       // n Lights
        uint32 nDoodadNames;  // n M2 models imported
        uint32 nDoodadDefs;   // n Doodads (M2 instances)
        uint32 nDoodadSets;   // n Doodad sets
        C4ByteColor AmbColor; // Color settings for base (ambient) color. See the flag at /*03Ch*/
        uint32 WMO_Id;        // (column 2 in WMOAreaTable.dbc)
	    C3Vector BoundingBoxMin;
	    C3Vector BoundingBoxMax;
        uint32  padding;
    }sMOHD_Container<open=true, read=Str("%d : WMO ID", WMO_Id)>;    
}sMOHD<read=Str("%d : WMO ID", sMOHD_Container.WMO_Id)>;

// ============= MOTX Chunk =====================

typedef struct{
    string TextureName;
    local uint8 nPadding = 0;
    local uint64 oldpos = FTell();
    local byte ByteBuffer = ReadByte(oldpos);
    while(ByteBuffer==0x0){
        nPadding++;
        oldpos++;
        ByteBuffer = ReadByte(oldpos);
    };
    if(nPadding>0) byte Padding[nPadding];
}sWMOFileName<read=TextureName, write=WMOTexWrite>;

void WMOTexWrite( sWMOFileName &f, string s ){
    SScanf(s, "%s", f.TextureName);
}  

typedef struct{
    sHdr Hdr;
    struct{
        if(Hdr.Size!=0){
            local int nTextures = 0;
            local int ofsTexListEnd = FTell() + Hdr.Size;
            while(FTell() < ofsTexListEnd ){        
                sWMOFileName Texture;
                nTextures++;
            }
        }
    }sMOTX_Container<open=true, read=Str("%d : Texture Files", nTextures), optimize=false>;
}sMOTX<read=Str("%d : Texture Files", sMOTX_Container.nTextures), optimize=false>;

// ============= MOMT Chunk =====================

string OfsTextureRead(uint32 rec){
    if( exists(WMO_File.MOTX) && (rec<FileSize())){
	    string a;        
        local int64 OfsMOTX = startof(WMO_File.MOTX);        
        local string sRefferedTex = ReadString(OfsMOTX+0x8+rec);
	    SPrintf(a, "%d->%s\n", rec, sRefferedTex);
	    return a;
    }else{
        return Str("%d->N/A", rec);
    }
}

typedef struct{
    uint32 UNLIT_0x0    : 1;  // disable lighting logic in shader (but can still use vertex colors)
    uint32 UNFOGGED_0x1 : 1;  // disable fog shading (rarely used)
    uint32 UNCULLED_0x2 : 1;  // two-sided
    uint32 EXTLIGHT_0x4 : 1;  // darkened, the intern face of windows are flagged 0x08
    uint32 SIDN_0x8     : 1;  // (bright at night, unshaded) (used on windows and lamps in Stormwind, for example) (see emissive color)
    uint32 WINDOW_0x10  : 1;  // lighting related (flag checked in CMapObj::UpdateSceneMaterials)
    uint32 CLAMP_S_0x20 : 1;  // tex clamp S (force this material's textures to use clamp s addressing)
    uint32 CLAMP_T_0x40 : 1;  // tex clamp T (force this material's textures to use clamp t addressing)
    uint32 UNK_0_0x80   : 1;
    uint32 Padding      : 23; // unused as of 7.0.1.20994
}sFlagsMOMT;

typedef struct{
    sHdr Hdr;
    struct{
        for(int32 i=0; i < (Hdr.Size/64); i++){
            struct{
                //uint32 Version;
                sFlagsMOMT Flags;
                uint32 Shader;
                uint32 BlendMode;             // Blending: see EGxBlend
                uint32 OfsTexture1<read=OfsTextureRead(this)>;   // offset into MOTX; ≥(8.1.0.27826) Filedata ID
                C4ByteColor SidnColor;        // Emissive color; see below (emissive color)
                C4ByteColor FrameSidnColor;   // Sidn emissive color; set at runtime; gets sidn-manipulated emissive color; see below (emissive color)
                uint32 OfsTexture2<read=OfsTextureRead(this)>;
                C4ByteColor DiffColor;
                uint32 GroundType;
                float  Unk_f1;
                float  Unk_f2;
                uint32 Unk_n[5];
                //OfsTextureMOMT OfsTexture3;
                //uint32 Color2;
                //sFlagsMOMT Flag2;
            }Material<read=Str("%s", ExtractFilename(OfsTextureRead(OfsTexture1)))>;
        }
    }sMOMT_Container<open=true, optimize=true, read=Str("%d : Materials", ReadUInt( startof(this)-0x4)/64 )>;
}sMOMT<read=Str("%d : Materials", Hdr.Size/64)>;

// ============= MOM3 Chunk ====================== ≥ WarWithin (11.0.0.54210)
// Payload is an M3 m3SI material block. It remains raw until the embedded M3
// material graph can be parsed without guessing at version-dependent fields.

// ============= MOUV Chunk ====================== ≥ Legion (7.3.0.24473)

typedef struct{
    sHdr Hdr;
    //for(int16 i=0; i < (MOMT.MOMT_Header.Size/64); i++){
    for(int16 i=0; i < (Hdr.Size/16); i++){
         C2Vector Translation_speed[2];
    }
}sMOUV<read=Str("%d : nMapObjectUV", (Hdr.Size/16))>;

// ============= MOGN Chunk ======================

typedef struct{
    string GroupName;
}sGroupName<read=GroupName, write=MOGNGroupNameWrite>;

void MOGNGroupNameWrite( sGroupName &f, string s){
    SScanf(s, "%s", f.GroupName);
};

typedef struct{
    sHdr Hdr;
    struct{
        local uint8 nGroupNames = 0;
        local uint64 OfsMOGNEnd = FTell() + Hdr.Size;
        while(FTell() < OfsMOGNEnd){
            sGroupName GroupNames;    
            nGroupNames++;
        }
    }sMOGN_Container<open=true, read=Str("%d : GroupNames", nGroupNames)>;
}sMOGN<read=Str("%d : GroupNames", sMOGN_Container.nGroupNames)>;

// ============= MOGI Chunk ======================

typedef struct{
    bGroupFlags Flags;
	C3Vector BoundingBoxMin;
	C3Vector BoundingBoxMax;
    int32 NameOffset<read=sMOGIRead(this)>;
}sMOGI_Entry;

typedef struct{
    sHdr Hdr;
    struct{
        if(Hdr.Size>0){
            for(int32 i=0; i < (Hdr.Size/32); i++){
                sMOGI_Entry MOGI_data<read=sMOGIRead(NameOffset)>;
            }
        }
    }sMOGI_Container<open=true, read=Str("%d : Group Informations", ReadUInt((startof(this)-0x4))/32 )>;
}sMOGI<read=Str("%d : Group Informations", (Hdr.Size/32)) >;

string sMOGIRead(int ofsIntoMOGN){
    string a;
    if(ofsIntoMOGN > -1){
        SPrintf(a, "%d->%s\n", ofsIntoMOGN, ReadString(startof(WMO_File.MOGN)+ofsIntoMOGN+0x8));
    }else{
        SPrintf(a, "%s\n", "Empty");
    };
	return a;
}

// ============= MOSB Chunk ======================

typedef struct{
    sHdr Hdr;
    char SkyboxName[Hdr.Size];
}sMOSB<read=sMOSBRead>;

string sMOSBRead(sMOSB& rec){
	string a;
    local string sSkyBoxName = rec.SkyboxName;
    if(Strlen(sSkyBoxName)>4){
        SPrintf(a, "%s\n", rec.SkyboxName);
    }else{
        SPrintf(a, "Empty\n");
    };
	return a;
}

// ============= MOSI Chunk ====================== ≥ Battle (8.1.0.27826). Could have been added earlierᵘ.

typedef struct{
    sHdr Hdr;
    uint32 SkyboxFileID;
}sMOSI<read=Str("%d : Skybox FID", SkyboxFileID)>;

// ============= MOPV Chunk ======================

typedef struct{
    C3Vector Portal[4];
}sPortal;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) C3Vector PortalVertices[Hdr.Size/12];
}sMOPV<read=Str("%d : Portals", ((Hdr.Size/12)+1)/4)>;

// ============= MOPT Chunk ======================

typedef struct{
    uint16 StartVertex;
    uint16 Count;
    C4Vector Plane;
}sPortalInfo;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) sPortalInfo PortalInfo[Hdr.Size/20]<read=Str("s: %d c: %d", StartVertex, Count)>;
}sMOPT<read=Str("%d : PortalData", Hdr.Size/20)>;

// ============= MOPR Chunk ======================

typedef struct{
    uint16 portalIndex; // Into MOPT
    uint16 groupIndex;  // The other one
    int16  side;        // Positive or negative.
    uint16 filler;
}sMOPR_Entry;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) sMOPR_Entry PortalRefs[Hdr.Size/8]<read=Str("pIdx: %d gIdx: %d", portalIndex, groupIndex)>;
}sMOPR<read=Str("%d : PortalRefs", Hdr.Size/20)>;

// ============= MOPE Chunk ====================== ≥ WarWithin (11.1.0.58221).

typedef struct{
    sHdr Hdr;
    if(Hdr.Size!=0){
        struct{
            for(int i=0; i<(Hdr.Size/16); i++){
                uint32 PortalIndex;  // into MOPT
                uint32 unk1;
                uint32 unk1;
                uint32 unk3;
            }
        }sMOPE_Container<open=true>;
    }
}sMOPE<read=Str("%d : PortalIndex", Hdr.Size/16)>;

// ============= MOVV Chunk ====================== ≥ Battle (8.1.0.28294) optional

typedef struct{
    C3Vector VisBlockVerts;
}sMOVV_Entry;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) sMOVV_Entry VisibleBlockVerts[Hdr.Size/12];
}sMOVV<read=Str("%d : VisibleBlockVerts", Hdr.Size/20)>;

// ============= MOVB Chunk ======================

typedef struct{
    uint16 FirstVertex;
    uint16 Count;
}sMOVB_Entry<read=Str("%d#->%d#", FirstVertex, Count)>;

typedef struct{
    sHdr Hdr;
    if(Hdr.Size>0) sMOVB_Entry VisibleBlock[Hdr.Size/4];
}sMOVB<read=Str("%d : VisibleBlock", Hdr.Size)>;

// ============= MOLT Chunk ======================

typedef enum <uint8>{
    OMNI_LGT = 0,
    SPOT_LGT = 1,
    DIRECT_LGT = 2,
    AMBIENT_LGT = 3,
}eLightType;

typedef struct{
    eLightType Type;
    uint8 UseAtten;
    uint8 pad[2];
    C4ByteColor Color;
    C3Vector Position;
    float Intensity;
    C4Vector Rotation;
    float AttenStart;
    float AttenEnd;
