// ============= MNLD Chunk ======================

typedef struct{
    sHdr Hdr;
    if(Hdr.Size!=0){
        struct{
            for(int i=0; i<(Hdr.Size/184); i++){
                struct{
                   int Type;                  // 0 = Point light (sphere), 1 = Spot light (cone) 
                   int LightIndex;            // Appears to be same as index in mapobject_new_light_defs[]
                   int Flags;                 // 0x1 - use blend between outerColor and innerColor, otherwise innerColor is used for whole light
                                              // 0x2 - The light casts shadows
                   int DoodadSet;             // Doodad Set this light belongs to
                   C4Byte InnerColor;         // Inner color
                   C3Vector Position;         // Light position in WMO
                   C3Vector Rotation;         // Euler rotation in radians, for spot light rotates the light, for point light rotates the light cookie
                   float AttenStart;          // Start attenuation
                   float AttenEnd;            // End attenuation
                   float Intensity;           // Light intensity
                   C4Byte OuterColor;         // Outer color. Only used when 0x1 flag is set
                   float BlendStart;          // Gradient start distance from emitter position, for mixing start and end color when 0x1 flag is set
                   float BlendEnd;            // Gradient end distance from emitter position,  for mixing start and end color when 0x1 flag is set
                   char Gap0[4];              // empty
                   float FlickerIntensity;    // Flickering light intensity
                   float FlickerSpeed;        // Flickering light speed
                   int FlickerMode;           // 0 = off, 1 = sine curve, 2 = noise curve, 3 = noise step curve
                   C3Vector Field_54;         // Only found 0's so far
                   char Gap1[4];              // empty
                   uint LightCookieFileID;    // file ID for light cookie texture. For point light it's a cube map
                   char Gap2[20];             // empty
                   float Falloff;             // Exponent for falloff parameter of spot lights. Defines how fast the light diminishes starting from center
                   float InnerAngle;          // Start of drop-off gradient, in radians. Starts at center, ends at edge. Controls the rate at which light intensity decreases from the center to the edge of the spot light beam
                   float OuterAngle;          // End of drop-off gradient, in radians. Both start and end drop-off angles have to be smaller than radius else sharp edge
                   hfloat Scale;              // scale in half-float format. Used only when 0x2 flag is set
                   hfloat IntesityMultiplier; // Multiplier for intensity in half-float format. If set to 0.0f - it's correct to 1.0f by client automatically
                   int Unused_0;              // This field and fields below currently are not used by client
                   int Unused_1;
                   int Unused_2;
                   int Unused_3;
                   int Unused_4;
                   int Unused_5;
                   int Unused_6;
                   int Unused_7;
                   int Unused_8;
                   int Unused_9;
                   int Unused_10;
                }MNLD_Entry<read=(Str("DoodadSet: %d", DoodadSet))>;
            }
        }sMNLD_Container; //<open=true>;
    }
}sMNLD<read=Str("%d : MapObjectNewLightDefs", Hdr.Size/184)>;

// ========================= WMO GROUP CHUNKS BELOW ==============================

// ============= MOGP Chunk ======================

typedef struct{ //Group Header
    sHdr Hdr;
    struct{
        uint32 GroupNameOffset;	 // Offset into MOGN
	    uint32 DescNameOffset;   // Offset into MOGN
	    sMOGP_FLAGS Flags;	     // Flags
	    C3Vector BoundingBoxMin; // As with flags, same as in corresponding MOGI entry
	    C3Vector BoundingBoxMax; // Bounding box corner 2
	    uint16 PortalStart;	     // Index into MOPR
	    uint16 PortalCount;	     // number of MOPR items used after portalStart
	    uint16 TransBatchCount;	 // Number of batches A
	    uint16 IntBatchCount;	 // Number of batches B
	    uint32 ExtBatchCount;	 // Number of batches C
	    ubyte FogIndices[4];     // Up to four indices into the WMO fog list
	    uint32 LiquidType;	     // LiquidType related, see below in the MLIQ chunk.
	    uint32 WmoGroupID;	     // WMO group ID (column 4 in WMOAreaTable.dbc)
	    sMOGPGroupFlags2 Flags2; // Always 0 ?
	    uint32 Unk2;		     // UNUSED: 20740
        
        
        //WRONG and WIP
        if(MVER.sMVER_Container.Version==14){
            uint16 vertStart;
            uint16 vertCount;
            uint16 batchStart;
            uint16 batchCount;
        }
        
        
    }sMOGP_Container<open=true>;
}sMOGP<read=Str("WMO Group HDR")>;

// ================ MOGX Chunk ======================

typedef struct{
    sHdr Hdr;
    if(Hdr.Size!=0){
        struct{
            uint32 QueryFaceStart[Hdr.Size/4];
        }sMOGX_Container<open=true>;
    }
}sMOGX<read=Str("%d : Polygon_GroundType", Hdr.Size/4)>;

// ================ MOPY Chunk ======================

typedef struct{
    sHdr Hdr;
    if(Hdr.Size!=0){
        struct{
            for(int i=0;i<(Hdr.Size/2); i++){
                struct{               
                    uint8 F_Unk_0x1: 1;
                    uint8 F_NoCamCollide_0x2: 1;
                    uint8 F_Details_0x4: 1;
                    uint8 F_Collision_0x8: 1;     // Turns off rendering of water ripple effects. May also do more. Should be used for ghost material triangles.
                    uint8 F_Hint_x010: 1;
                    uint8 F_Render_0x20: 1;
                    uint8 F_Cull_Objects_0x40: 1; // tested on 1.12, flag enables/disables game object culling. might be wrong, previously UNK_0x40
                    uint8 F_Collide_Hit_0x80: 1;
                    uint8 Material_Id;            // index into MOMT, 0xff for collision faces
                }_MOPY<read=Str("Material Id: %d", Material_Id)>;
            }
        }sMOPY_Container<open=true>;
    }
}sMOPY<read=Str("%d : Materials_Trs 2b/trs", Hdr.Size/2)>;

// ============= MPY2 Chunk ====================== ≥ DF (10.0.0.46181)

