            union{
                struct{
                    uint8 Flow1;
                    uint8 Flow2;
                    uint8 Flow1Pct;
                    uint8 Filler;
                    float Height;
                }WaterVert;
                struct{
                    int16 s;
                    int16 t;
                    float Height;
                }MagmaVert;
            }LiquidVertexList[LiquidVerts.x * LiquidVerts.y];

            struct{
                uint8 LegacyLiquidType: 4; // For older WMOs, used to set liquid type.
                uint8 Unk1: 1;
                uint8 Unk2: 1;
                uint8 Fishable: 1;
                uint8 Shared: 1;
            }LiquidTileList[LiquidTiles.x * LiquidTiles.y];

        }sMLIQ_Container; //<open=true>;
    }
}sMLIQ;

