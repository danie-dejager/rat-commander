//======================================================//
//                  WMO File Reading                    //
//======================================================//

int ChunkSelector(string sChunkName){
	switch(sChunkName){
		case Rev4Char("MVER"): sMVER MVER<fgcolor=0x80FF00, comment="Version">; return 1;
		case Rev4Char("MOHD"): sMOHD MOHD<fgcolor=0x80FF00, comment="Header">; return 1;
		case Rev4Char("MOTX"): sMOTX MOTX<fgcolor=0x80FF00, comment="TextureFiles">; return 1;
		case Rev4Char("MOMT"): sMOMT MOMT<fgcolor=0x80FF00, comment="Materials">; return 1;
		case Rev4Char("MOM3"): sUnknownChunk MOM3<fgcolor=0x80FF00, comment="M3 material data (raw)">; return 1;
		case Rev4Char("MOGN"): sMOGN MOGN<fgcolor=0x80FF00, comment="GroupNames">; return 1;
		case Rev4Char("MOGI"): sMOGI MOGI<fgcolor=0x80FF00, comment="GroupInformations">; return 1;
		case Rev4Char("MOSB"): sMOSB MOSB<fgcolor=0x80FF00, comment="SkyboxName">; return 1;
		case Rev4Char("MOPV"): sMOPV MOPV<fgcolor=0x80FF00, comment="Portal">; return 1;
		case Rev4Char("MOPT"): sMOPT MOPT<fgcolor=0x80FF00, comment="PortalData">; return 1;
		case Rev4Char("MOPR"): sMOPR MOPR<fgcolor=0x80FF00, comment="PortalRefs">; return 1;
		case Rev4Char("MOLT"): sMOLT MOLT<fgcolor=0x80FF00, comment="Lights">; return 1;
		case Rev4Char("MODN"): sMODN MODN<fgcolor=0x80FF00, comment="DoodadsNameList">; return 1;
		case Rev4Char("MOVB"): sMOVB MOVB<fgcolor=0x80FF00, comment="VisibleBlock">; return 1;
		case Rev4Char("MOVV"): sMOVV MOVV<fgcolor=0x80FF00, comment="VisibleBlockVerts">; return 1;
		case Rev4Char("MODS"): sMODS MODS<fgcolor=0x80FF00, comment="DoodadSetList">; return 1;
		case Rev4Char("MODD"): sMODD MODD<fgcolor=0x80FF00, comment="DoodadDefList">; return 1;
		case Rev4Char("MFOG"): sMFOG MFOG<fgcolor=0x80FF00, comment="FogList">; return 1;
		case Rev4Char("MFOB"): sUnknownChunk MFOB<fgcolor=0x80FF00, comment="Fog data (raw, layout undocumented)">; return 1;
		case Rev4Char("MCVP"): sMCVP MCVP<fgcolor=0x80FF00, comment="ConvexVolumePlanes">; return 1;
		case Rev4Char("MOUV"): sMOUV MOUV<fgcolor=0x80FF00, comment="MapObjectUV">; return 1;
		case Rev4Char("MOSI"): sMOSI MOSI<fgcolor=0x80FF00, comment="SkyboxFileID">; return 1;
		case Rev4Char("GFID"): sGFID GFID<fgcolor=0x80FF00, comment="GroupFileDataID">; return 1;
		case Rev4Char("MODI"): sMODI MODI<fgcolor=0x80FF00, comment="Doodad_ID">; return 1;
		case Rev4Char("MOMO"): sMOMO MOMO<fgcolor=0x80FF00, comment="Wrapped">; return 1;
		case Rev4Char("MOIN"): sMOIN MOIN<fgcolor=0x80FF00, comment="IndexList">; return 1;
		case Rev4Char("MOGP"): sMOGP MOGP<fgcolor=0x80FF00, comment="WMO_GroupHDR">; return 1;
		case Rev4Char("MOGX"): sMOGX MOGX<fgcolor=0x80FF00, comment="Polygon_GrndType">; return 1;
		case Rev4Char("MOPY"): sMOPY MOPY<fgcolor=0x80FF00, comment="Materials_Trs 2b/trs">; return 1;
		case Rev4Char("MPY2"): sMPY2 MPY2<fgcolor=0x80FF00, comment="Materials_Trs 4b/trs">; return 1;
		case Rev4Char("MOVI"): sMOVI MOVI<fgcolor=0x80FF00, comment="MapObject Vertex Indices">; return 1;
		case Rev4Char("MOVT"): sMOVT MOVT<fgcolor=0x80FF00, comment="Vertices Chunk">; return 1;
		case Rev4Char("MONR"): sMONR MONR<fgcolor=0x80FF00, comment="Normals Chunk">; return 1;
		case Rev4Char("MOTV"): sMOTV MOTV<fgcolor=0x80FF00, comment="Texture Coordinates">; return 1;
		case Rev4Char("MOBA"): sMOBA MOBA<fgcolor=0x80FF00, comment="Render batches">; return 1;
		case Rev4Char("MODR"): sMODR MODR<fgcolor=0x80FF00, comment="Doodad references">; return 1;
		case Rev4Char("MOBN"): sMOBN MOBN<fgcolor=0x80FF00, comment="BSP Nodes">; return 1;
		case Rev4Char("MOBR"): sMOBR MOBR<fgcolor=0x80FF00, comment="Face Indices">; return 1;
		case Rev4Char("MOBS"): sMOBS MOBS<fgcolor=0x80FF00, comment="Map Object Shadow Batches">; return 1;
		case Rev4Char("MPBV"): sMPBV MPBV<fgcolor=0x80FF00, comment="Unk uint16">; return 1;
		case Rev4Char("MOCV"): sMOCV MOCV<fgcolor=0x80FF00, comment="Vertex colors 1">; return 1;
		case Rev4Char("MOC2"): sMOC2 MOC2<fgcolor=0x80FF00, comment="Vertex colors 2">; return 1;
		case Rev4Char("MLIQ"): sMLIQ MLIQ<fgcolor=0x80FF00, comment="Liquids">; return 1;
		case Rev4Char("MORI"): sMORI MORI<fgcolor=0x80FF00, comment="Trs_Strip_Indices">; return 1;
		case Rev4Char("MORB"): sMORB MORB<fgcolor=0x80FF00, comment="TriangleStripBatches">; return 1;
		case Rev4Char("MOLR"): sMOLR MOLR<fgcolor=0x80FF00, comment="Light References">; return 1;
		case Rev4Char("MGI2"): sMGI2 MGI2<fgcolor=0x80FF00, comment="MapObject_Grp_Info_V2">; return 1;
		case Rev4Char("MOLV"): sMOLV MOLV<fgcolor=0x80FF00, comment="LightMapVertexList">; return 1;
		case Rev4Char("MFED"): sMFED MFED<fgcolor=0x80FF00, comment="FogExtraData">; return 1;
		case Rev4Char("MAVG"): sMAVG MAVG<fgcolor=0x80FF00, comment="GlobalAmbientVolumes">; return 1;
		case Rev4Char("MAVD"): sMAVD MAVD<fgcolor=0x80FF00, comment="AmbientVolumes">; return 1;
		case Rev4Char("MBVD"): sMBVD MBVD<fgcolor=0x80FF00, comment="AmbientBoxVolumes">; return 1;
		case Rev4Char("MDDI"): sMDDI MDDI<fgcolor=0x80FF00, comment="DoodadAdditionalInfo">; return 1;
		case Rev4Char("MPVD"): sUnknownChunk MPVD<fgcolor=0x80FF00, comment="ParticulateVolumes (raw)">; return 1;
		case Rev4Char("MNLD"): sMNLD MNLD<fgcolor=0x80FF00, comment="MapObject_New_Light_Defs">; return 1;
		case Rev4Char("MNLR"): sMNLR MNLR<fgcolor=0x80FF00, comment="NewLightReferences">; return 1;
		case Rev4Char("MFVR"): sMFVR MFVR<fgcolor=0x80FF00, comment="FogVolumeReferences">; return 1;
		case Rev4Char("MBVR"): sMBVR MBVR<fgcolor=0x80FF00, comment="BoxVolumeReferences">; return 1;
		case Rev4Char("MAVR"): sMAVR MAVR<fgcolor=0x80FF00, comment="AmbientVolumeReferences">; return 1;
		case Rev4Char("MPVR"): sMPVR MPVR<fgcolor=0x80FF00, comment="ParticulateVolumeReferences">; return 1;
		case Rev4Char("MOMX"): sMOMX MOMX<fgcolor=0x80FF00, comment="Unk">; return 1;
		case Rev4Char("MOVX"): sMOVX MOVX<fgcolor=0x80FF00, comment="VertexList">; return 1;
		case Rev4Char("MPBG"): sMPBG MPBG<fgcolor=0x80FF00, comment="MPB_Vertices">; return 1;
		case Rev4Char("MPBI"): sMPBI MPBI<fgcolor=0x80FF00, comment="MPB_Indices">; return 1;
		case Rev4Char("MPBP"): sMPBP MPBP<fgcolor=0x80FF00, comment="Unk">; return 1;
		case Rev4Char("MOPB"): sMOPB MOPB<fgcolor=0x80FF00, comment="PrepassBatches">; return 1;
		case Rev4Char("MOP2"): sMOP2 MOP2<fgcolor=0x80FF00, comment="PointLightAnimations">; return 1;
		case Rev4Char("MOS2"): sMOS2 MOS2<fgcolor=0x80FF00, comment="SpotlightAnimations">; return 1;
		case Rev4Char("MLSS"): sMLSS MLSS<fgcolor=0x80FF00, comment="MapObjectLightSetSpotlights">; return 1;
		case Rev4Char("MLSP"): sMLSP MLSP<fgcolor=0x80FF00, comment="MapObjectLightSetPointLights">; return 1;
		case Rev4Char("MOLP"): sMOLP MOLP<fgcolor=0x80FF00, comment="MapObjectPointLights">; return 1;
		case Rev4Char("MDAL"): sMDAL MDAL<fgcolor=0x80FF00, comment="ReplacementHdrCol">; return 1;
		case Rev4Char("MOLS"): sMOLS MOLS<fgcolor=0x80FF00, comment="MapObjectSpotLights">; return 1;
		case Rev4Char("MOLM"): sMOLM MOLM<fgcolor=0x80FF00, comment="LightMapList">; return 1;
		case Rev4Char("MOPE"): sMOPE MOPE<fgcolor=0x80FF00, comment="PortalIndex">; return 1;
		case Rev4Char("MLSO"): sMLSO MLSO<fgcolor=0x80FF00, comment="MapObjectSpotLightAnimSets">; return 1;
		case Rev4Char("MLSK"): sMLSK MLSK<fgcolor=0x80FF00, comment="MapObjectPointLightAnimSets">; return 1;
		case Rev4Char("MOLD"): sMOLD MOLD<fgcolor=0x80FF00, comment="LightMapTexList">; return 1;
		case Rev4Char("MOPL"): sMOPL MOPL<fgcolor=0x80FF00, comment="TerrainCuttingPlanes">; return 1;
		case Rev4Char("MOTA"): sMOTA MOTA<fgcolor=0x80FF00, comment="MapObjectTangentArray">; return 1;
		case Rev4Char("MOQG"): sMOQG MOQG<fgcolor=0x80FF00, comment="QueryFace">; return 1;
		case Rev4Char("MDDL"): sMDDL MDDL<fgcolor=0x80FF00, comment="GroupData">; return 1;
        return -1;
	}
    return -1;
}

struct{
    local int64 FileEnd = FileSize();
    local int64 ScanEnd = FileEnd;
    local int64 ChunkOffset = 0;
    local int64 ChunkEnd = 0;
    local int64 ParsedEnd = 0;
    local int64 Remaining = 0;
    local uint32 ChunkSize = 0;
    local string ChunkName = "";
    local string DisplayName = "";
    local int SelectorResult = 0;
    local int ParsedChunkCount = 0;
    local int ContainerDepth = 0;
    local int64 ContainerEnds[16];

    while(ChunkOffset < FileEnd){
        while(ContainerDepth > 0 && ChunkOffset == ScanEnd){
            ContainerDepth--;
            if(ContainerDepth > 0){
                ScanEnd = ContainerEnds[ContainerDepth - 1];
            }else{
                ScanEnd = FileEnd;
            }
        }

        Remaining = ScanEnd - ChunkOffset;
        FSeek(ChunkOffset);

        if(Remaining < 8){
            Printf("Trailing data at 0x%LX: only 0x%LX byte(s), not enough for a WMO chunk header.\n", ChunkOffset, Remaining);
            ubyte TrailingBytes[Remaining]<open=false, optimize=true>;
            ChunkOffset = ScanEnd;
            continue;
        }

        ChunkName = ReadString(ChunkOffset, 4);
        ChunkSize = ReadUInt(ChunkOffset + 4);
        DisplayName = Rev4Char(ChunkName);

        if((int64)ChunkSize > Remaining - 8){
            Printf("Truncated %s chunk at 0x%LX: declared 0x%X payload bytes, only 0x%LX remain.\n",
                   DisplayName, ChunkOffset, ChunkSize, Remaining - 8);
            FSeek(ChunkOffset);
            ubyte TruncatedChunk[Remaining]<open=false, optimize=true>;
            break;
        }

        ChunkEnd = ChunkOffset + 8 + ChunkSize;
        Printf("%s at 0x%LX: size 0x%X\n", DisplayName, ChunkOffset, ChunkSize);
        FSeek(ChunkOffset);

        SelectorResult = ChunkSelector(ChunkName);
        if(SelectorResult != 1){
            sUnknownChunk UnknownChunk;
            Printf("No detailed parser for %s; payload kept as raw bytes.\n", DisplayName);
        }

        ParsedEnd = FTell();
        if(ChunkName == Rev4Char("MOMO") && ChunkSize > 0 && ContainerDepth < 16){
            ContainerEnds[ContainerDepth] = ChunkEnd;
            ContainerDepth++;
            ScanEnd = ChunkEnd;
            ChunkOffset += 8;
            ParsedChunkCount++;
            Printf("Entering bounded MOMO wrapper payload at 0x%LX.\n", ChunkOffset);
            continue;
        }

        if(ChunkName == Rev4Char("MOGP") && ParsedEnd > ChunkOffset + 8 && ParsedEnd < ChunkEnd && ContainerDepth < 16){
            ContainerEnds[ContainerDepth] = ChunkEnd;
            ContainerDepth++;
            ScanEnd = ChunkEnd;
            ChunkOffset = ParsedEnd;
            ParsedChunkCount++;
            Printf("Entering bounded MOGP child chunks at 0x%LX.\n", ChunkOffset);
            continue;
        }

        if(ParsedEnd != ChunkEnd){
            Printf("Parser boundary correction for %s: ended at 0x%LX, declared end is 0x%LX.\n",
                   DisplayName, ParsedEnd, ChunkEnd);
        }

        FSeek(ChunkEnd);
        ChunkOffset = ChunkEnd;
        ParsedChunkCount++;
    }

    Printf("Parsed %d WMO chunk(s).\n", ParsedChunkCount);
}WMO_File<open=true>;
