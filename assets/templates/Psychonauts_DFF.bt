struct {
    char signature[4];
    uint32 asciiMapSize;
    uint32 coordMapSize;
} HEADER;

struct {
    char asciiCharacter;
} ASCII_MAP[HEADER.asciiMapSize] <optimize=false, comment=asciiCharacter>;

struct {
    uint16 x_start;
    uint16 y_start;
    uint16 x_end;
    uint16 y_end;
    uint16 x_base;
    uint16 y_base;
} COORD_MAP[HEADER.coordMapSize] <optimize=false>;

struct {
    uint32 unknown;
    uint32 width;
    uint32 height;
    struct {
       byte ImageLine[width];
    } IMAGEDATA[height] <optimize=false>;
} TEXTURE;
