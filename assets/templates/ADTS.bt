//------------------------------------------------
//--- 010 Editor v14.0 Binary Template
//
//   File: ADTS.bt
//   Author: zhoubo
//   Version: 0.3
//   Purpose: Parse AAC's ADTS(Audio Data Transport Stream) audio files.
//   Category: Audio
//   File Mask: *.aac
//   ID Bytes: FF //ADTS Syncword
//   History: 
//   0.3     2024-02-09 zhoubo: use BitfieldDisablePadding(Unpadded Bitfields) for odd header bytes(7,9 bytes) color, and remove FSeek.
//   0.2     2024-02-05 zhoubo: fix some comment & color.
//   0.1     2022-06-13 zhoubo: Init release. only ADTS, not support ADIF,LATM.
//
//------------------------------------------------

// More information available at:
//  1. https://wiki.multimedia.cx/index.php?title=ADTS
//  2. https://en.wikipedia.org/wiki/Advanced_Audio_Coding
//  3. https://en.wikipedia.org/wiki/AAC
//  4. https://juejin.cn/post/7032170229732442148

BigEndian();

// Forward declarations:

struct ADTS_HEADER;
struct ADTS_FRAME;

// Constants:

// Enums:

// Funtions:

string GetMPEGVersionComment(UBYTE &MPEG_Version)
{
    local string comment = "";
    switch (MPEG_Version)
    {
    case 0:          comment = "MPEG-4"; break;
    case 1:          comment = "MPEG-2"; break;
    }
    return comment;
}

string GetProtectionAbsentComment(UBYTE &Protection_absence)
{
    local string comment = "";
    switch (Protection_absence)
    {
    case 0:          comment = "ADTS has 9 bytes with CRC"; break;
    case 1:          comment = "ADTS has 7 bytes without CRC"; break;
    }
    return comment;
}

string GetProfileComment(UBYTE &Profile)
{
    local string comment = "";
    switch (Profile)
    {
    case 0x00:       comment = "AAC Main"; break;
    case 0x01:       comment = "AAC LC (Low Complexity)"; break;
    case 0x10:       comment = "AAC SSR (Scalable Sample Rate)"; break;
    case 0x11:       comment = "AAC LTP (Long Term Prediction)"; break;
    }
    return comment;
}

string GetSamplingFrequencyIndexComment(UBYTE &Sampling_frequency_index)
{
    local string comment = "";
    switch (Sampling_frequency_index)
    {
    case 0x0:        comment = "96000Hz"; break;
    case 0x1:        comment = "88200Hz"; break;
    case 0x2:        comment = "64000Hz"; break;
    case 0x3:        comment = "48000Hz"; break;
    case 0x4:        comment = "44100Hz"; break;
    case 0x5:        comment = "32000Hz"; break;
    case 0x6:        comment = "24000Hz"; break;
    case 0x7:        comment = "22050Hz"; break;
    case 0x8:        comment = "16000Hz"; break;
    case 0x9:        comment = "12000Hz"; break;
    case 0xa:        comment = "11025Hz"; break;
    case 0xb:        comment = "8000Hz"; break;
    case 0xc:        comment = "7350Hz"; break;
    case 0xd:        comment = "Reserved"; break;
    case 0xe:        comment = "Reserved"; break;
    case 0xf:        comment = "FORBIDDEN (malformed)"; break;
    }
    return comment;
}

string GetChannelConfigurationComment(UBYTE &Channel_configuration)
{
    local string comment = "";
    switch (Channel_configuration)
    {
    case 0:          comment = "Defined in AOT Specifc Config"; break;
    case 1:          comment = "1 channel: front-center"; break;
    case 2:          comment = "2 channels: front-left, front-right"; break;
    case 3:          comment = "3 channels: front-center, front-left, front-right"; break;
    case 4:          comment = "4 channels: front-center, front-left, front-right, back-center"; break;
    case 5:          comment = "5 channels: front-center, front-left, front-right, back-left, back-right"; break;
    case 6:          comment = "6 channels: front-center, front-left, front-right, back-left, back-right, LFE-channel"; break;
    case 7:          comment = "8 channels: front-center, front-left, front-right, side-left, side-right, back-left, back-right, LFE-channel"; break;
    }
    return comment;
}

string GetBufferFullnessComment(USHORT &ADTS_buffer_fullness)
{
    local string comment = "";
    switch (ADTS_buffer_fullness)
    {
    case 0x7FF:      comment = "VBR (most software ignore this field)"; break;
    default:         comment = "rate..?? (most software ignore this field)"; break;
    }
    return comment;
}

string GetRawDataBlockComment(UBYTE &Number_of_AAC_frames_minus_1)
{
    local string comment = "";
    switch (Number_of_AAC_frames_minus_1)
    {
    case 0x0:        comment = "has 1 AAC data block"; break;
    default:         comment = "data block number + 1"; break;
    }
    return comment;
}


//-----------------------------------
// Define structures used in AAC files
//
// [1.adts_fixed_header information]
// Syncword:                     12bits, sync header, always 0xFFF。
// MPEG_Version:                 1bit,   0 means MPGE-4, 1 means MPGE-2
// Layer:                        2bits,  alwayas ”00”
// Protection_absence:           1bit,   0 means ADTS Header 9 bytes; 1 means ADTS Header 7 bytes
// Profile:                      2bit,   AAC level : Main,LC,SSR,LTP
// Sampling_frequency_index:     4bits,  Sampling Frequencies
// Private_bit:                  1bit
// Channel_configuration:        3bits,  channel number...
// Originality:                  1bit
// Home:                         1bit
//
// [2.adts_variable_header information]
// Copyright_id_bit:             1bit
// Copyright_id_start:           1bit
// AAC_frame_length:             13bits, AAC frame length : ADTS Header(7 or 9 bytes) + sizeof(AAC Frame)
// ADTS_buffer_fullness:         11bits, 0x7FF means VBR
// Number_of_AAC_frames_minus_1: 2bits,  ADTS Frame numbers : Number_of_AAC_frames_minus_1 + 1
//
// [3.CRC information]
// CRC16:                        16bits, when Protection_absence=0

typedef struct 
{
    SetForeColor(cGreen);
    // ADTS_FIXED_HEADER
    USHORT Syncword : 12                   <format=hex, comment = "always 0xFFF">;
    UBYTE MPEG_Version : 1                 <format=decimal, comment = GetMPEGVersionComment>;
    UBYTE Layer : 2                        <comment = "always 0">;
    UBYTE Protection_absence : 1           <comment = GetProtectionAbsentComment>;

    SetForeColor(cLtBlue);
    UBYTE Profile : 2                      <format=hex, comment = GetProfileComment>;
    UBYTE Sampling_frequency_index : 4     <format=hex, comment = GetSamplingFrequencyIndexComment>;
    UBYTE Private_bit : 1;
    UBYTE Channel_configuration : 3        <comment = GetChannelConfigurationComment>;
    UBYTE Originality : 1;
    UBYTE Home : 1;

    // ADTS_VARIABLE_HEADER
    UBYTE Copyright_id_bit : 1;
    UBYTE Copyright_id_start : 1;
    USHORT AAC_frame_length : 13;
    USHORT ADTS_buffer_fullness : 11       <format=hex, comment = GetBufferFullnessComment>;
    UBYTE Number_of_AAC_frames_minus_1 : 2 <comment = GetRawDataBlockComment>;

    // ADTS_CRC_HEADER
    if (0 == Protection_absence) // Header with CRC
    {
        USHORT CRC16                       <format=hex>;
    }
    else // Header without CRC
    {
    }

    SetForeColor(cNone);
} ADTS_HEADER;


typedef struct
{
    ADTS_HEADER Header;

    if (0 == Header.Protection_absence) // Header with CRC 2 bytes
    {
        // SetBackColor( cNone );
        UBYTE Data[Header.AAC_frame_length - 9];
    }
    else // Header without CRC
    {
        // SetBackColor( cNone );
        UBYTE Data[Header.AAC_frame_length - 7];
    }
} ADTS_FRAME;

//---------------------------------------------

BitfieldDisablePadding(); // use BitfieldDisablePadding for odd bytes

while (!FEof())
{
    ADTS_FRAME adtsFrame <name = "ADTS Frame">;
    if(adtsFrame.Header.Syncword != 0xFFF)
    {
        Warning( "File is not a valid AAC's ADTS file. stop!!!" );
        return -1;
    }
}
