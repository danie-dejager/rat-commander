	return a;
}

// C4ByteWeights ---------------------------------------------------------------

typedef struct{
	unsigned char Bone1;
	unsigned char Bone2;
	unsigned char Bone3;
	unsigned char Bone4;
}C4ByteWeights<read=C4ByteWeightsRead, optimize=false>;

string C4ByteWeightsRead(C4ByteWeights& rec){
	string a;
	SPrintf(a, "(%u %u %u %u)\n", rec.Bone1, rec.Bone2, rec.Bone3, rec.Bone4);
	local short SumWeights = rec.Bone1 + rec.Bone2 + rec.Bone3 + rec.Bone4;
	if(SumWeights<255){
		Printf("Warning: Weights do not add up to 255 but %d\n", SumWeights);
	}
	return a;
}

//------------------------------------------------------------------------------

void M2TrackSubValType(string VarType){
	switch(VarType){
		case "Timestamp":
			uint32 Timestamp<fgcolor=0xFFFFFF, bgcolor=0x000000>;
			break;
		case "sTimestamp":
			ushort Timestamp<fgcolor=0xFFFFFF, bgcolor=0x000000>;
			break;
		case "C2Vector":
			C2Vector val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "C3Vector":
			C3Vector val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
        case "C4Vector":
			C4Vector val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "C3VectorBF":
			C3Vector Point<fgcolor=0x00FFFF, bgcolor=cNone>;
			C3Vector TanIn<fgcolor=0x00FFFF, bgcolor=cNone>;
			C3Vector TanOut<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "uint32":
			uint32 val<fgcolor=0xFF8080, bgcolor=cNone>;
			break;
		case "int32":
			int32 val<fgcolor=0xFF8080, bgcolor=cNone>;
			break;
		case "float":
			float val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "byte":
			byte val<fgcolor=0xFF8080, bgcolor=cNone>;
			break;
		case "ubyte":
			ubyte val<fgcolor=0xFF8080, bgcolor=cNone>;
			break;
		case "uint16":
			uint16 val<fgcolor=0xFF8080, bgcolor=0x000000>;
			break;
		case "int16":
			int16 val<fgcolor=0xFF8080, bgcolor=cNone>;
			break;
		case "C4CompQuat":
			C4sVector val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "C4CompQuatVector":
			C4CompQuatVector val<fgcolor=0x00FFFF, bgcolor=cNone>;
			break;
		case "RGB":      // Float of 0.0 to 255.0 used in Particles
            struct{
			    float R; //0
			    float G; //256
			    float B; //65536
            }RGB<read=Str("#%02X%02X%02X", this.R, this.G, this.B), fgcolor=(this.R+(this.G*256)+(this.B*65536)), bgcolor=cBlack>;
            break;
		case "C3RGB":    // Float of 0.0 to 1.0 used in Ribbons
			struct{
				float R<read=Str("%d", this*256), write=(this = Atof(value)/256.0)>; //0
				float G<read=Str("%d", this*256), write=(this = Atof(value)/256.0)>; //256
				float B<read=Str("%d", this*256), write=(this = Atof(value)/256.0)>; //65536
			}C3RGB<read=Str("#%02X%02X%02X", this.R*255, this.G*255, this.B*255), fgcolor=((this.R*255) + (this.G*65536) + (this.B*16777216)), bgcolor=cBlack>; // Don't judge me
			break;
	}
}

typedef struct(uint32 SequenceID){
	int32 nValues<fgcolor=cLtGreen, bgcolor=0x000000>;
	int32 ofsValues<fgcolor=cLtGreen, bgcolor=0x000000, format=hex>;
	local uint OfsSeq = ReadUInt(0x20+ofsMD21_8);
	local uint SeqFlag = ReadUInt(OfsSeq+ofsMD21_8 + (SequenceID*0x40) + 0xC);
	local uint locSeqID = SequenceID;
	if((nValues!=0) && (ofsValues!=0) && (SeqFlag&0x20)){
		local int oldpos=FTell();
		FSeek(ofsValues + ofsMD21_8);
		local int i=0;
		while(i < nValues){
			M2TrackSubValType(G_SumAnimSeqVarType);
			i++;
		}
		FSeek(oldpos);
	}
}sM2TrackSubValSeq<read=M2TrackSubValSeq_nValRead, optimize=false>;

string M2TrackSubValSeq_nValRead(sM2TrackSubValSeq& rec){
	string a;
	local uint OfsSeq = ReadUInt(0x20+ofsMD21_8);
	local uint SeqFlag = ReadUInt(OfsSeq+ofsMD21_8 + (rec.locSeqID*0x40) + 0xC);
	local uint16 SeqAnimID = ReadUInt(OfsSeq+ofsMD21_8 + (rec.locSeqID*0x40));
	local uint16 SeqSubAnimID = ReadUInt(OfsSeq+ofsMD21_8 + (rec.locSeqID*0x40)+0x2);
	local string locFileName = FileNameGetBase(GetFileName(), false);

	if(SeqFlag&0x20){
		if(rec.nValues > 0){
			SPrintf(a, "(Values: %d)\n", rec.nValues);
		}else{
			SPrintf(a, "Empty\n");
		}
	}else{
		if(rec.nValues > 0){
			SPrintf(a, "(Values: %d --> %s%04d-%02d.anim )\n", rec.nValues, locFileName, SeqAnimID, SeqSubAnimID);
		}else{
			SPrintf(a, "Empty\n");
		}
	}
	return a;
}
 // TODO change the variable type
void M2TrackBase(string M2TrackType, string TempVarType){
	G_SumAnimSeqVarType = TempVarType;
	if(M2TrackType=="T"){   // Full Timestamp Block
		if(xpac <= TBC){    // TBC insert for Interpolation Ranges
			uint32 nInterpolationRanges<comment="TBC">;
			uint32 ofsnInterpolationRanges<format=hex, comment="TBC">;
			G_nKeys = nInterpolationRanges;
			G_OfsKeys = ofsnInterpolationRanges;
			if((nInterpolationRanges!=0) && (ofsnInterpolationRanges!=0)){
				struct{
 					oldpos=FTell();
					FSeek(G_OfsKeys + ofsMD21_8);
					i=0;
					while(i < G_nKeys){
						M2TrackSubValType("uint32");
						i++;
					}
					FSeek(oldpos);
				}InterpolationRanges;
			}
		}
		uint32 nTimestampPairs;
		uint32 ofsTimestampPairs<format=hex>;
		G_nKeys = nTimestampPairs;
		G_OfsKeys = ofsTimestampPairs;
		if((nTimestampPairs!=0) && (ofsTimestampPairs!=0)){
 			oldpos=FTell();
            FSeek(G_OfsKeys + ofsMD21_8);
			struct{
                //Printf("G_OfsKeys: %LX\n", G_OfsKeys);
                //Printf("ofsMD21_8: %LX\n", ofsMD21_8);
                //Printf("G_OfsKeys+ofsMD21_8: %LX\n", G_OfsKeys + ofsMD21_8);
				i=0;
				while(i < G_nKeys){
					if(xpac <= TBC){   // TBC insert
						M2TrackSubValType(G_SumAnimSeqVarType);
					}else{
						sM2TrackSubValSeq SumAnimSeq(i);
					}
					i++;
				}
			}Timestamps;
			FSeek(oldpos);
		}
	}else if(M2TrackType=="sT"){	  // Timestamp Block without sub sequences
		uint32 nTimestampPairs;
		uint32 ofsTimestampPairs<format=hex>;
		G_nKeys = nTimestampPairs;
		G_OfsKeys = ofsTimestampPairs;
		if((nTimestampPairs!=0) && (ofsTimestampPairs!=0)){
 			oldpos=FTell();
			struct{
				FSeek(G_OfsKeys + ofsMD21_8);
				i=0;
				while(i < G_nKeys){
					M2TrackSubValType(G_SumAnimSeqVarType);
					i++;
				}
			}sTimestamps;
			FSeek(oldpos);
		}
	}else if(M2TrackType=="V"){	      // Full Values Block
		uint32 numberOfKeyFramePairs;
		uint32 offsetToKeyFramePairs<format=hex>;
		G_nKeys = numberOfKeyFramePairs;
		G_OfsKeys = offsetToKeyFramePairs;
		if((numberOfKeyFramePairs!=0) && (offsetToKeyFramePairs!=0)){
 			oldpos=FTell();
			FSeek(G_OfsKeys + ofsMD21_8);
			struct{
				i=0;
				while(i < G_nKeys){
					if(xpac >= TBC){  // TBC insert
						sM2TrackSubValSeq SumAnimSeq(i);
					}else{
						M2TrackSubValType(G_SumAnimSeqVarType);
					}
					i++;
				}
 			}Values<optimize=false>;
			FSeek(oldpos);
		}
	}else if(M2TrackType=="sV"){	  // Values Block without sub sequences
		uint32 numberOfKeyFramePairs;
		uint32 offsetToKeyFramePairs<format=hex>;
		G_nKeys = numberOfKeyFramePairs;
		G_OfsKeys = offsetToKeyFramePairs;
		if((numberOfKeyFramePairs!=0) && (offsetToKeyFramePairs!=0)){
 			oldpos=FTell();
			struct{
				FSeek(G_OfsKeys + ofsMD21_8);
				i=0;
				while(i < G_nKeys){
					M2TrackSubValType(G_SumAnimSeqVarType);
					i++;
				}
			}Values;
			FSeek(oldpos);
		}
	}else if(M2TrackType=="T_short"){ // Timestamps without any sequences
		uint32 numberOfKeyFramePairs;
		uint32 offsetToKeyFramePairs<format=hex>;
	}else if(M2TrackType=="V_short"){ // Values without any sequences
		if(xpac <= TBC){			  // TBC insert
			uint32 Start_Timestamp<comment="TBC">;
			uint32 End_Timestamp<comment="TBC">;
		}
		uint32 nTimestampPairs;
		uint32 ofsTimestampPairs<format=hex>;
	}else{
	    local int EmptyStruct=0;
	}
}

typedef struct(string M2Track1_Type, string M2Track1_Var, string M2Track2_Type, string M2Track2_Var, byte Header){
	local int oldpos = 0;
	local int i;
	if(Header==1){	                  // Headless M2Tracks used only in Particles
		InterpolationType Interpolation;
		int16 LoopID;
	}
	M2TrackBase(M2Track1_Type, M2Track1_Var);
	M2TrackBase(M2Track2_Type, M2Track2_Var);
}M2Track<read=M2Track_Pairs_Read, optimize=false>;

string M2Track_Pairs_Read(M2Track& rec){
  string a;
  if((exists(rec.nTimestampPairs) && exists(rec.numberOfKeyFramePairs))){
	  if((rec.nTimestampPairs>0) || (rec.numberOfKeyFramePairs>0)){
		  SPrintf(a, "(Timestamps: %d KeyFrames: %d)\n", rec.nTimestampPairs, rec.numberOfKeyFramePairs);
	  }else{
		  SPrintf(a, "Empty\n");
	  }
	  return a;
  }else if(exists(rec.nTimestampPairs)){
	  if((rec.nTimestampPairs>0)){
		  SPrintf(a, "(Timestamps: %d)\n", rec.nTimestampPairs);
	  }else{
		  SPrintf(a, "Empty\n");
	  }
	  return a;
  }else{
	  SPrintf(a, "Empty\n");
	  return a;
  }
}

typedef struct{
	CHAR	 Identifier[4]; // Some kind of ID, starts with '$'. Some identifiers below.
	uint32	 Data;			// This data is passed when the event is fired.
	uint32	 ParentBone;	// Somewhere it has to be attached.
	C3Vector Position;		// Relative to that bone of course.
	M2Track  Timer("T", "Timestamp", "Empty", "Empty", 1)<fgcolor=0xA3FF87, bgcolor=0x1E1E1E>;
}sEvents<read=ReadEvent>;

string ReadEvent(sEvents &a){
	string s;
	s = Str("%c%c%c%c", a.Identifier[0], a.Identifier[1], a.Identifier[2], a.Identifier[3]);
	local uchar s_UCas[1024] = s;
	local int16 strl = Strlen(s);
	for(byte i=0; i < strl; i++){ s_UCas[i] = ToUpper(s_UCas[i]); }
	if(a.Data!=0){ s += Str(" - %d", a.Data); }
	switch(s_UCas){
		case "$AH0": s += Str(" - CustomAttack(CreatureSoundDataID)"); break;
		case "$AH1": s += Str(" - CustomAttack(CreatureSoundDataID)"); break;
		case "$AH2": s += Str(" - CustomAttack(CreatureSoundDataID)"); break;
		case "$AH3": s += Str(" - CustomAttack(CreatureSoundDataID)"); break;
		case "$BMD": s += Str(" - BowMissleDestination"); break;
		case "$AIM": s += Str(" - MissileFirePos"); break;
		case "$ALT": s += Str(" - Anim_Swap_Event"); break;
		case "$BL0": s += Str(" - FootstepAnimEventHit_Left(Backwards)"); break;
		case "$BL1": s += Str(" - FootstepAnimEventHit_Left(Backwards)"); break;
