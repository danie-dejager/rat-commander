typedef struct{
	E_ATTACHMENT_ID ID;		// Just an id. Is referenced in the lookup-block below too.
	uint32   ParentBone;	// Attachment base
	C3Vector Position;		// Relative to bone; Often this value is the same as bone's pivot point
	M2Track  Data("T", "Timestamp", "V", "int32", 1)<fgcolor=0x0B9AED, bgcolor=cBlack>; // whether or not the attached model is animated when this model is. only a bool is used. default is true
}sAttachments<read=ReadAttachment>;

string ReadAttachment(sAttachments &a){
	string s;
	if(EnumToString(a.ID)!=""){
		SPrintf(s, "%s (%d)", EnumToString(a.ID), a.ID);
	}else{
		SPrintf(s, "%s (%d)", "AT_Undocumented", a.ID);
	}
	return s;
}

typedef struct{
	C3Vector Position;
	C4ByteWeights BoneWeight;
	C4Byte	 BoneIndices;
	C3Vector Normal;
	C2Vector TextureCoords1;
	C2Vector TextureCoords2; //Depending on shader used
}sVertices;

//============================ SKIN SECTION ===================================

typedef struct{
	uint16 Indices_0;   // Three indices which make up a triangle
	uint16 Indices_1;   // an index into the local skin vertex list
	uint16 Indices_2;
}ssIndices<read=IndicesRead, optimize=false>;

string IndicesRead(ssIndices& rec){
	string a;
	SPrintf(a, "(%d %d %d)\n", rec.Indices_0, rec.Indices_1, rec.Indices_2);
	return a;
}

typedef struct{
	byte BoneIndices_0; // Usually 0? Purpose unknown
	byte BoneIndices_1; // 4 indices into the global bone list (see remarks below)
	byte BoneIndices_2;
	byte BoneIndices_3;
}ssBones<read=BonesRead, optimize=false>;

string BonesRead(ssBones& rec){
	string a;
	SPrintf(a, "(%d %d %d %d)\n", rec.BoneIndices_0, rec.BoneIndices_1, rec.BoneIndices_2, rec.BoneIndices_3);
	return a;
}

string SSCheck(int secIDMin, int secIDMax, int secID, string secName, string secVar){
	if( (secID>=secIDMin) & (secID<=secIDMax) ){
		return secName;
	}else{
		return secVar;
	}
}

string SkinSectionName(int ssID){ /* Dont Judge me */
	local string sName = "Unk";
	sName = SSCheck(   0,	 0, ssID, "Skin", sName);
	sName = SSCheck(   1,   99, ssID, "Hair", sName);
	sName = SSCheck( 100,  199, ssID, "Facial1", sName);
	sName = SSCheck( 200,  299, ssID, "Facial2", sName);
	sName = SSCheck( 300,  399, ssID, "Facial3", sName);
	sName = SSCheck( 400,  499, ssID, "Gloves", sName);
	sName = SSCheck( 500,  599, ssID, "Boots", sName);
	sName = SSCheck( 600,  699, ssID, "Shirt", sName);
	sName = SSCheck( 700,  799, ssID, "Ears", sName);
	sName = SSCheck( 800,  899, ssID, "Sleeves", sName);
	sName = SSCheck( 900,  999, ssID, "Kneepads", sName);
	sName = SSCheck(1000, 1099, ssID, "ShirtDoublet", sName);
	sName = SSCheck(1100, 1199, ssID, "Pants", sName);
	sName = SSCheck(1200, 1299, ssID, "Tabard", sName);
	sName = SSCheck(1300, 1399, ssID, "Robe", sName);
	sName = SSCheck(1400, 1499, ssID, "Loincloth", sName);
	sName = SSCheck(1500, 1599, ssID, "Cape", sName);
	sName = SSCheck(1600, 1699, ssID, "FacialJewelry", sName);
	sName = SSCheck(1700, 1799, ssID, "EyeEffects", sName);
	sName = SSCheck(1800, 1899, ssID, "Belt", sName);
	sName = SSCheck(1900, 1999, ssID, "BoneTail", sName);
	sName = SSCheck(2000, 2099, ssID, "Toes", sName);
	sName = SSCheck(2100, 2199, ssID, "Skull", sName);
	sName = SSCheck(2200, 2299, ssID, "Torso", sName);
	sName = SSCheck(2300, 2399, ssID, "Hands", sName);
	sName = SSCheck(2400, 2499, ssID, "Horns", sName);
	sName = SSCheck(2500, 2599, ssID, "Facewear", sName);
	sName = SSCheck(2600, 2699, ssID, "Shoulders", sName);
	sName = SSCheck(2700, 2799, ssID, "Helm", sName);
	sName = SSCheck(2800, 2899, ssID, "ArmUpper", sName);
	sName = SSCheck(2900, 2999, ssID, "ArmsReplace", sName);
	sName = SSCheck(3000, 3099, ssID, "LegsReplace", sName);
	sName = SSCheck(3100, 3199, ssID, "FeetReplace", sName);
	sName = SSCheck(3200, 3299, ssID, "HeadSwap", sName);
	sName = SSCheck(3300, 3399, ssID, "Eyes", sName);
	sName = SSCheck(3400, 3499, ssID, "Eyebrows", sName);
	sName = SSCheck(3500, 3599, ssID, "Piercings", sName);
	sName = SSCheck(3600, 3699, ssID, "Necklaces", sName);
	sName = SSCheck(3700, 3799, ssID, "Headdres", sName);
	sName = SSCheck(3800, 3899, ssID, "DrTail", sName);
	sName = SSCheck(3900, 3999, ssID, "MiscAccessory", sName);
	sName = SSCheck(4000, 4099, ssID, "MiscFeature", sName);
	sName = SSCheck(4100, 4199, ssID, "Noses", sName);
	sName = SSCheck(4200, 4299, ssID, "HairDecoration", sName);
	sName = SSCheck(4300, 4399, ssID, "HornDecoration", sName);
	sName = SSCheck(4400, 4499, ssID, "BodySizeDrac", sName);
	sName = SSCheck(4400, 4499, ssID, "Unk", sName);
