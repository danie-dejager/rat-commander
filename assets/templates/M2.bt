}PABC_C<read=(Str("nBlacklistAnimDatas: %d", (PABC_Size/2)))>;

typedef struct{
	CHAR PADC[4];
	uint PADC_Size<format=hex>;
	uint16 PADC_Entry[PADC_Size/2];
}PADC_C<read=(Str("nParentAnimDatas: %d", (PADC_Size/2)))>;

typedef struct{
	CHAR PSBC[4];
	uint PSBC_Size<format=hex>;
	uint32 nSequenceBounds_Maybe;
	uint32 ofsSequenceBounds_Maybe<format=hex>;
	uint64 unk_padding64;
	struct{
		C3Vector BoundingBoxMin;
		C3Vector BoundingBoxMax;
		float	 BoundingBoxRadius;  //A Bounding Box made out of 2 vectors.
	}SequenceBounds[nSequenceBounds_Maybe];
	//float PSBC_Entry[ ((PSBC_Size - 16) / 4) ];
}PSBC_C<read=(Str("SequenceBounds: %d",nSequenceBounds_Maybe))>;

typedef struct{
    InterpolationType Interpolation;
    int16  LoopID;
    uint32 nTimestampPairs;
    uint32 ofsTimestampPairs<format=hex>;
    if(nTimestampPairs!=0){
		local int oldpos=FTell();
		FSeek(StartOfChunkData + ofsTimestampPairs);
	    struct{
		    for(int i = 0; nTimestampPairs > i; i++){
			    struct{
				    uint32 nValues;
				    uint32 ofsValues<format=hex>;
					local int oldpos=FTell();
				    if(nValues!=0){
					    FSeek(StartOfChunkData + ofsValues);
					    for(int i = 0; nValues > i; i++){
						    uint Timestamp;
					    }
					    FSeek(oldpos);
				    }
			    }Sequence<read=(Str("(Values: %d)", nValues))>;
		    }
	    }Timestamps;
		FSeek(oldpos);
    }    
}PEDC_Entry<read=(Str("(Timestamps: %d)", nTimestampPairs)), optimize=false>;

typedef struct{
	CHAR PEDC[4];
	uint PEDC_Size<format=hex>;
    local uint64 StartOfChunkData=FTell();
	uint32 nEvent;
	uint32 ofsEvent<format=hex>; // uint16 offset ????
	uint64 unk_padding64;
	PEDC_Entry PEDCEntry[nEvent];
}PEDC_C<read=(Str("Events: %d", nEvent))>;

typedef struct{
	CHAR SKID[4];
