	GUILD_BORDER_COL = 17, //Guild Border Color
	GUILD_EMBLEM = 18,	   //Guild Emblem
	EYE_COL = 19,		   //Character Eyes
	JEWEL = 20,		       //Character Jewelry // Accessory
	SECOND_SKIN = 21,	   //Character Secondary Skin
	SECOND_HAIR = 22,	   //Character Secondary Hair
	SECOND_ARMOR = 23,	   //Character Secondary Armor
	UNK_SL = 24,           
	UNK_DF = 25,		   //Seen in DracthyrDragon.m2 (10.0.0+)
	UNK1_DF = 26		   //Seen in DracthyrDragon.m2 (10.0.0+)
}E_TEXTURETYPES;

typedef enum<uint32>{
