typedef enum<uint32>{
	HARDCODED = 0,		   //Texture given in filename
	SKIN = 1,			   //Skin -- Body + clothes
	OBJECT_SKIN = 2,	   //Object Skin -- Item, Capes ("Item\ObjectComponents\Cape\*.blp")
	WEAPON_BLADE = 3,	   //Weapon Blade - on lots of models but not used in the client as far as I see. Armor Reflect?
	WEAPON_HANDLE =4,	   //Weapon Handle
	ENVIRONMENT = 5,	   //(OBSOLETE) Environment (Please remove from source art)
	CHAR_HAIR = 6,		   //Character Hair
	CHAR_FACIAL_HAIR = 7,  //(OBSOLETE) Character Facial Hair (Please remove from source art)
	SKIN_EXTRA = 8, 	   //Skin Extra
	UI_SKIN = 9,		   //Used on inventory art M2s (1): inventoryartgeometry.m2 and inventoryartgeometryold.m2
	TAUREN_MANE = 10,	   //Character Misc // (OBSOLETE) Tauren Mane (Please remove from source art)
