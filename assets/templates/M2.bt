    int IndexCount;
    int IndexOffset;
    int FlagsCount;
    int FlagsOffset;
    FSeek(StartOfChunkData+VertexPosOffset);
    C3Vector VertexPositions[VertexPosCount];
    FSeek(StartOfChunkData+FaceNormOffset);
    C3Vector FaceNormals[FaceNormCount];
    FSeek(StartOfChunkData+IndexOffset);
    short Indices[IndexCount];
    FSeek(StartOfChunkData+FlagsOffset);
    short Flags[FlagsCount];
}PCOL_Entry;

