RequiresVersion(16.0); LittleEndian();

local string startTime = GetCurrentDateTime("hh:mm:ss:zzz");
local int nBoneLimiter = 30; // Change this value to your own needs and prefference
// Conversion between comp ushort and float quaternion used by bone rotations (lossy compression)
local float f_MAX_SHORT = 32767; local float f_One = 1.0;
float stf(ushort Short){ return (Short / f_MAX_SHORT) - f_One; } // float to short
ushort fts(float Float){ return (Float + f_One) * f_MAX_SHORT; } // short to float

local byte ofsMD21_8 = (ReadString(0x0,4) == "MD21") ? 0x8 : 0x0;
local string G_SumAnimSeqVarType;
local uint32 G_nKeys, G_OfsKeys, TexIndicesByIDRecMatch;
local ubyte MessageBoxMask = 0;
local uint64 MD21_C_Pos;

enum Expansion{
	VANILLA = 0,
	TBC = 1,
	WOTLK = 2,
	CATA = 3,
	MOP = 4,
	WOD = 5,
    LEGION = 6,
};

Expansion GetXpac( uint32 M2ver ){
    if(M2ver >= 274) return LEGION;
	if(M2ver >  272) return WOD;
	if(M2ver == 272) return MOP;
	if(M2ver >= 265) return CATA;
	if(M2ver == 264) return WOTLK;
	if(M2ver >= 260) return TBC;
	return VANILLA;
};

local Expansion xpac = GetXpac( ReadUInt(0x4 + ofsMD21_8) );

