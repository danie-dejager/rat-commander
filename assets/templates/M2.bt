	uint PCOL_Size<format=hex>;
	PCOL_Entry PCOLEntry; //[PCOL_Size/Unk];
}PCOL_C<read=(Str("nCollisionMeshs %d", (PCOL_Size)))>; // Collision mesh and information assumed to be specifically for the player housing feature in Midnight

