typedef struct{
   uint16 SkinSectionID;   // Mesh part ID, see below.
   uint16 Level;
   uint16 VertexStart; 	   // Starting vertex number.
   uint16 VertexCount;	   // Number of vertices.
   uint16 IndicesStart<read=Str("%d (%d)", this<<ReadUShort(startof(this)-0x6), (this/3)<<ReadUShort(startof(this)-0x6)), comment="Divide by 3">;	// Starting triangle index (that's 3* the number of triangles drawn so far).
   uint16 IndicesCount<read=Str("%d (%d)", this, this/3), comment="Divide by 3">;	 // Number of triangle indices.
   uint16 BonesCount;	   // Number of elements in the bone lookup table.
   uint16 BonesStart;	   // Starting index in the bone lookup table.
   uint16 BoneInfluences;
   uint16 CenterBoneIndex; // Not sure.
   C3Vector CenterPos;	   // Average position of all the vertices in the sub mesh.
   if(xpac >= TBC){
	   C3Vector SortCenterPos;  // Distance of the vertex farthest from CenterBoundingBox
	   float SortRadius;   // Distance of the vertex farthest from CenterBoundingBox.
   }
}ssSubmeshes<read=SubmeshIDRead, optimize=false>;

string SubmeshIDRead(ssSubmeshes& rec){
	string a;
	SPrintf(a, "%d : %s\n", rec.SkinSectionID, SkinSectionName(rec.SkinSectionID) );
	return a;
}

typedef struct{
	struct{
		ubyte MaterialInversion_0x1 : 1;
		ubyte Transform_0x2 : 1;
		ubyte ProjectedTexture01_0x4 : 1;
		ubyte Unk_0x8: 1;
		ubyte BatchCompatible_0x10: 1;
		ubyte ProjectedTexture02_0x20: 1;
		ubyte TransparencyMultiplier_0x40: 1;
	}TextureUnitFlags<read=Str("%LXh", ReadUByte(startof(this)) )>;
	byte priorityPlane;      // Flags
	uint16 ShaderID<read=Str("%LXh", ReadUShort(startof(this)) ), format=binary>; // shader_id; may index textureCombinerCombos when global flag 0x8 is set.
	uint16 SubmeshIndex;     // Material this texture is part of (index into mat)
	uint16 GeosetIndex;		 // flags2 in newer docs; 0x2 projected, 0x8 applies EDGF edge fade chunk.
	int16 ColorIndex;		 // color or -1
	uint16 MaterialIndex<comment="MaterialID">;	// more flags...
	uint16 MaterialLayer;	 // Texture unit (0 or 1)
	uint16 TextureCount;	 // TextureCount
	uint16 TexComboIndex<comment="TextureLookupID">;	        // Index into Texture lookup table
	uint16 TexCoordComboIndex<comment="TexUnitLookupID">;	    // Index into the texture mapping lookup table.
	uint16 TexWeightComboIndex<comment="TransparencyLookupID">;	// Index into transparency lookup table.
	uint16 TexTransformComboIndex<comment="TexAnimLookupID">;	// Index into uvanimation lookup table.
} ssTextureUnits<read=TextureUnitsRead, optimize=false>;

string TextureUnitsRead(ssTextureUnits& rec){
	string a;
	SPrintf(a, "SubmeshID: %d\n", rec.SubmeshIndex);
	return a;
}

typedef struct(int SkinSectionVal){
	uint32 nVertices<fgcolor=0x00FFFF, bgcolor=0x330033>;
	uint32 ofsVertices<format=hex, fgcolor=0x00FFFF, bgcolor=0x330033>;		// Indices used in this View.
	uint32 nIndices<fgcolor=0x99FFFF, bgcolor=0x330033>;
	uint32 ofsIndices<format=hex, fgcolor=0x99FFFF, bgcolor=0x330033>;		// The triangles made with them.
	uint32 nBoneIndices<fgcolor=0xFF00FF, bgcolor=0x331900>;
	uint32 ofsBoneIndices<format=hex, fgcolor=0xFF00FF, bgcolor=0x331900>;	// Properties of the vertices.
	uint32 nSubmeshes<fgcolor=0x00CCFF, bgcolor=0x330033>;
	uint32 ofsSubmeshes<format=hex,fgcolor=0x00CCFF, bgcolor=0x330033>;		// Submeshes (Geosets) of this View.
	uint32 nTextureUnits<fgcolor=0xFF00BF, bgcolor=0x112200>;
	uint32 ofsTextureUnits<format=hex, fgcolor=0xFF00BF, bgcolor=0x112200>;	// Texture Units.
	uint32 boneCountMax<fgcolor=0xFF00FF, bgcolor=0x331900>;				// Max bones per draw call; some docs also note this can behave like a LOD vertex-data offset.

	local int oldpos = FTell();
	FSeek(ofsVertices);
	uint16 Vertex[nVertices]<fgcolor=0x00FFFF, bgcolor=0x330033>;
	FSeek(ofsIndices);
	ssIndices Indices[nIndices / 3]<fgcolor=0x99FFFF, bgcolor=0x330033, comment="Idx->Vert list">;
	FSeek(ofsBoneIndices);
	ssBones BonesIndices[nBoneIndices]<fgcolor=0xFF00FF, bgcolor=0x331900>;
	FSeek(ofsSubmeshes);
	ssSubmeshes Submeshes[nSubmeshes]<fgcolor=0x00CCFF, bgcolor=0x330033>;
	FSeek(ofsTextureUnits);
	ssTextureUnits TextureUnits[nTextureUnits]<fgcolor=0xFF00BF, bgcolor=0x112200>;
	FSeek(oldpos);
}sSkinProfiles;

//=========================== END OF SKIN SECTION ===================================

typedef struct{
	LIGHT_TYPE Type<fgcolor=0xFF00FF, bgcolor=0x331900>;
	uint16	 ParentBone<fgcolor=0xFF00FF, bgcolor=0x331900>;
	C3Vector Postion<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Ambient_Color("T", "Timestamp", "V", "C3RGB", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Ambient_Intensity("T", "Timestamp", "V", "float", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Diffuse_Color("T", "Timestamp", "V", "C3RGB", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Diffuse_Intensity("T", "Timestamp", "V", "float", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Attenuation_Start("T", "Timestamp", "V", "float", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Attenuation_End("T", "Timestamp", "V", "float", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	M2Track Visibility("T", "Timestamp", "V", "ubyte", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
}sLights;

typedef struct{
	E_RENDERFLAGS TxtCombo_Flag;
	E_RENDERMODES TxtCombo_Blend;
}Texture_Combiner; //<name=(Str("Texture_Combiner_%d", ReadInt(0x130 + ofsMD21_8)))>

typedef struct{
	E_SEQUENCES SequenceID;	    // Animation id in AnimationData.dbc
	uint16 SubSequenceID;	    // Sub-animation id: Which number in a row of animations this one is.
	if(xpac <= TBC){			//  TBC insert
		uint32 Start_Timestamp<comment="TBC">;
		uint32 End_Timestamp<comment="TBC">;
	}else{
		uint32 Length;		    // The length (timestamps) of the animation. I believe this actually the length of the animation in milliseconds.
	}
	float MovingSpeed<read=Str("%.4f yards/s  %.2f%s", this, (this/7.1111)*100, '%')>; 	   // As 2.x says: moving speed for walk/run animations.   (0.071111)
	//E_ANIMATIONLOOP looped;// Most likely. All flags I saw: 0b01101101
	struct{
		uint32 Set_0x80_OnLoad_0x1: 1; //Sets 0x80 when loaded. (M2Init)
		uint32 Unk_0x2: 1;
		uint32 Unk_0x4: 1;
		uint32 Unk_0x8: 1;
		uint32 LoadLowPrioritySequence_0x10: 1; //apparently set during runtime in CM2Shared::LoadLowPrioritySequence for all entries of a loaded sequence (including aliases)
		uint32 AnimationInM2_0x20: 1;			//primary bone sequence -- If set, the animation data is in the .m2 file. If not set, the animation data is in an .anim file. Was named 'looped animation' by schlumpf years ago, without source.
		uint32 AliasNext_0x40: 1;				//has next / is alias (To find the animation data, the client skips these by following aliasNext until an animation without 0x40 is found.)
		uint32 BlendedAnimation_0x80: 1;		//Blended animation (if either side of a transition has 0x80, lerp between end->start states, unless end==start by comparing bone values)
		uint32 SequenceStored_0x100: 1; 		//sequence stored in model ?
		uint32 BlendTimeInAndOut_0x200: 1;		//Signals that uint32_t blendTime is two fields: blendTimeIn and blendTimeOut. (Actual usage and influence of blendTimeIn and blendTimeOut depends on blendTimeOperation, which is not stored in files, but code and context dependent)
		uint32 Unk_0x400: 1;
		uint32 UNK_0x800: 1; //seen in Legion 24500 models
		uint32 UNK_0x1000: 1;
		uint32 UNK_0x2000: 1;
	}SequenceFlags;
	int16 frequency <read=Str("%d (%.2f%s)", this, (this / 32767.0) * 100.0, '%')>; //These two are connected. Most of the time, they are 0.
	uint16	 _padding;
	uint32	 M2Range_Min;
	uint32	 M2Range_Max;	 //But if there is data in one, there is data in both of them.
	uint32	 BlendTime;		 //Values: 0, 50, 100, 150, 200, 250, 300, 350, 500.
	C3Vector BoundingBoxMin;
	C3Vector BoundingBoxMax;
	float	 BoundingBoxRadius; //A Bounding Box made out of 2 vectors.
	int16	 NextAnimation;	 //ID of the following animation of this AnimationID, points to an Index or is -1 if none.
	uint16	 AliasNext;		 //ID in the list of animations.  TODO List picker
}sSequences<read=ReadAnimation>;

string ReadAnimation(sSequences &a){
	if(a.NextAnimation == -1){
		string s;
		if(xpac <= TBC){   // TBC insert
			SPrintf(s, "[%i]: %s", (a.End_Timestamp - a.Start_Timestamp) , EnumToString(a.SequenceID));
		}else{
			SPrintf(s, "[%i]: %s",a.Length, EnumToString(a.SequenceID));
		}
	}else{
		string s;
		if(xpac <= TBC){   // TBC insert
			SPrintf(s, "[%i]: %s", (a.End_Timestamp - a.Start_Timestamp) , EnumToString(a.SequenceID));
		}else{
			SPrintf(s, "[%i]: %s, > %i",a.Length,EnumToString(a.SequenceID), a.NextAnimation);
		}
	}
	return s;
}

typedef struct{
	int16 FallbackAnimationID; // Fallback Animation ID in AnimationData.dbc
	struct{
		int16 PlayNormal	:1;
		int16 PlayBackwards :1;
		int16 FrameByFrame  :1;
		int16 Freeze		:1;
	}Flags<read=Str("N: %d B: %d Fbf: %d F: %d", this.PlayNormal, this.PlayBackwards, this.FrameByFrame, this.Freeze)>;
}sSequenceFallback<read=Str("FbID: %d N: %d B: %d Fbf: %d F: %d", this.FallbackAnimationID, this.Flags.PlayNormal, this.Flags.PlayBackwards, this.Flags.FrameByFrame, this.Flags.Freeze)>;

typedef struct(byte Ext){
	E_BoneIndicesID BoneIndicesID; 		   // Back-reference to the key bone lookup table. -1 if this is no key bone.
	struct{
		uint32 ignoreParentTranslate_0x1		 :1;
		uint32 ignoreParentScale_0x2			 :1;
		uint32 ignoreParentRotation_0x4 		 :1;
		uint32 SPHERICAL_BILLBOARD_0x8			 :1;
		uint32 CYLINDRICAL_BILLBOARD_LOCK_X_0x10 :1;
		uint32 CYLINDRICAL_BILLBOARD_LOCK_Y_0x20 :1;
		uint32 CYLINDRICAL_BILLBOARD_LOCK_Z_0x40 :1;
		uint32 UNK_0x80 						 :1;
		uint32 UNK_0x100						 :1;
		uint32 TRANSFORMED_0x200				 :1;
		uint32 KINEMATIC_BONE_0x400 			 :1<comment="MoP+">; // MoP+: allow physics to influence this bone
		uint32 UNK_0x800						 :1;
		uint32 HELMET_ANIM_SCALED_0x1000		 :1; // set blend_modificator to helmetAnimScalingRec.m_amount for this bone
		uint32 SequenceID_something_0x2000		 :1<comment="BfA+">; // <=bfa+, parent_bone+submesh_id are a sequence id instead?!
	}E_BONESFLAGS;
	int16 parent_bone;						 // Parent bone ID or -1 if there is none.
	uint16 submesh_id;						 // Mesh part ID OR uDistToParent?
	if(xpac >= TBC){						 // TBC insert
		union{ 								 // only BC ?
			struct{
				uint16 uDistToFurthDesc;
				uint16 uZRatioOfChain;
			}CompressData; 					 // No model has ever had this part of the union used.
			E_CRC_BoneName BoneNameCRC; 	 // these are for debugging only. their bone names match those in key bone lookup.
		}CRC<read=(Str("%s (%u)",EnumToString(this.BoneNameCRC), (this.BoneNameCRC) ))>;
	}
	if(Ext==1){
		M2Track Translation("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
        if(xpac >= TBC){
            M2Track Rotation("T", "Timestamp", "V", "C4CompQuatVector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;            
        }else{    
            M2Track Rotation("T", "Timestamp", "V", "C4Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
        }
		M2Track Scaling("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	}else{
		M2Track Translation("T_short", "Timestamp", "V_short", "C3Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
        if(xpac >= TBC){
            M2Track Rotation("T_short", "Timestamp", "V_short", "C4CompQuatVector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;            
        }else{
            M2Track Rotation("T_short", "Timestamp", "V_short", "C4Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;            
        }
		M2Track Scaling("T_short", "Timestamp", "V_short", "C3Vector", 1)<fgcolor=0xFF00FF, bgcolor=0x331900>;
	}
	C3Vector PivotPoint;
}sBone<read=ReadBone>;

string ReadBone(sBone &b){  //if(exists(b.CRC.BoneNameCRC)==1){i = 0;} else {uint32 i;}
	string s;
	if( (b.BoneIndicesID==-1) & (exists(b.CRC.BoneNameCRC)==1) ){
		SPrintf(s, "Parent: [%i] \t %s",b.parent_bone, EnumToString(b.CRC.BoneNameCRC));
	}else if(b.BoneIndicesID==-1){
		SPrintf(s, "Parent: [%i]",b.parent_bone);
	}else if(b.BoneIndicesID!=-1){
		SPrintf(s, "Parent: [%i] \t %s(%i)", b.parent_bone, EnumToString(b.BoneIndicesID), b.BoneIndicesID);
	}
	return s;
}

typedef struct{
	C3Vector BoundingBoxMin;
	C3Vector BoundingBoxMax;
	float	 BoundingBoxRadius;
	C3Vector CollisionBoxMin;
	C3Vector CollisionBoxMax;
	float	 CollisionBoxRadius;
}TheFloats;

typedef struct(uint32 nTextureID){
	local uint32 TextureID = nTextureID;
	E_TEXTURETYPES type;
	E_TEXTUREFLAGS flags;
	uint32 FileName_length;
	uint32 FileName_offset<format=hex>;
	if(FileName_length != 0 || FileName_offset != 0){
		local int oldpos = FTell();
		FSeek(FileName_offset + ofsMD21_8);
		string texture;
		FSeek(oldpos);
	}
}sTexture<read=readsTexture, write=writesTexture>;

string readsTexture(sTexture & o){
	if(o.type == 0){
		string s;
		if( (o.FileName_length != 0) & (o.FileName_offset != 0) ){
			SPrintf(s, "%s", o.texture);
		}else{
			local int64 pos = FindFirst("TXID", true, false, 0, 0.0, 1, ReadUInt(0x4));
			if(pos != -1){
				local uint32 TXIDSize = ReadUInt(pos+0x4);
				if(o.TextureID<=TXIDSize/4){
					local uint32 TxidXnTextureMatch = ReadUInt(pos+(o.TextureID*4)+0x8);
					SPrintf(s, Str("TXID: %d", TxidXnTextureMatch));
				}else{
					SPrintf(s, "TXID");
				}
			}else{
				SPrintf(s, "Missing TXID Chunk");
			}
		}
		return s;
	}else{
		return EnumToString(o.type);
	}
}

void writesTexture(sTexture & o, string s){	   // TODO adding large sized textures
	if(o.type==0){
		SScanf(s, "%s", o.texture);
	}
	Printf("size: %d\n", Strlen(o.texture));
}

typedef int16 TexIndicesByIDRec<read=readTexComboIDX>;
typedef int16 TexComboIDRec<read=readTexComboIDX>;

string readTexComboIDX( TexComboIDRec v ){
	string s;
	if(v!=-1){
		local uint32 ofsTexturesTemp = M2_file.ofsTextures;
		local E_TEXTURETYPES TextureType = ReadUInt(ofsTexturesTemp + ( v * 0x10) + ofsMD21_8);
		if(TextureType!=0){
			SPrintf( s, "%d  : %s", v, EnumToString(TextureType) );
		}else{
			local uint32 TexLen = ReadUInt(0x8 + ofsTexturesTemp + ( v * 0x10) + ofsMD21_8);
			local uint32 TexOfs = ReadUInt(0xC + ofsTexturesTemp + ( v * 0x10) + ofsMD21_8);
			if(TexLen>1){
				local string TextureFileName = ReadString(TexOfs + ofsMD21_8, TexLen);
				SPrintf( s, "%d  : %s", v, FileNameGetBase(TextureFileName) );
			}else{
				local int64 pos = FindFirst("TXID", true, false, 0, 0.0, 1, ReadUInt(0x4));
				if(pos != -1){
					local uint32 TXIDSize = ReadUInt(pos+0x4);
					if(v<=TXIDSize/4){
						local uint32 TxidXnTextureMatch = ReadUInt(pos+(v*4)+0x8);
						SPrintf(s, Str("TXID: %d", TxidXnTextureMatch));
					}else{
						SPrintf(s, "TXID");
					}
				}else{
					SPrintf(s, "Missing TXID Chunk");
				}
			}
		}
	}else{
		SPrintf( s, "%d", v );
	}
	return s;
}

typedef struct{
	int32 ID;
	struct{
		uint32 Lit_ByLight_0x1			 :1; //Particles are affected by lighting;
		uint32 Unk_0x2					 :1; //
		uint32 Billboarded_0x4			 :1; //On emission, particle orientation is affected by player orientation
		uint32 TravelUp_0x8 			 :1; //Particles travel "up" in world space, rather than model.
		uint32 NoTrail_0x10 			 :1; //Do not Trail
		uint32 UnLit_0x20				 :1; //Unlightning
		uint32 BurstMulti_0x40			 :1; //Use Burst Multiplier
		uint32 ModelSpace_0x80			 :1; //Particles in Model Space (Causes animation of the particle emitter to be carried over to the particles.[1])
		uint32 Unk_0x100				 :1; //
		uint32 Randomizer_0x200 		 :1; //Spawn position randomized in some way?
		uint32 Pinned_0x400 			 :1; //STYLE: Pinned Particles, their quad enlarges from their creation position to where they expand.
		uint32 Unk_0x800				 :1; //
		uint32 XYQuad_Allign_0x1000 	 :1; //XYQuad Particles. They align to XY axis facing Z axis direction. (Causes the particles to be a type of tail that orients to the XY grid.[1])
		uint32 GroundClamp_0x2000		 :1; //Clamp to ground; call CParticleEmitter2::ProjectParticle
		uint32 Unk_0x4000				 :1; //
		uint32 Unk_0x8000				 :1; //
		uint32 RngTexture_0x10000		 :1; //ChooseRandomTexture
		uint32 Outwards_x20000			 :1; //STYLE: "Outward" particles, most emitters have this and their particles move away from the origin, when they don't the particles start at origin+(speed*life) and move towards the origin.
		uint32 Inwards_0x40000			 :1; //STYLE: unknown. In a large proportion of particles this seems to be simply the opposite of the above flag, but in some (e.g. voidgod.m2 or wingedlionmount.m2) both flags are true.
		uint32 DisableScaleVary_0x80000  :1; //If set, ScaleVary affects x and y independently; if not set, ScaleVary.x affects x and y uniformly, and ScaleVary.y is not used.
		uint32 RngFlip_0x200000 		 :1; //Random FlipBookStart
		uint32 IgnoreDistance_0x400000	 :1; //Ignores Distance (or 0x4000000?!, CMapObjDef::SetDoodadEmittersIgnoresDistance has this one)
		uint32 GravityComp_0x800000 	 :1; //Gravity values are compressed vectors instead of z-axis values (see Compressed Particle Gravity below)
		uint32 BoneGen_0x1000000		 :1; //Bone generator = bone, not joint
		uint32 NoThrottle_0x4000000 	 :1; //Do not throttle emission rate based on distance
		uint32 Multitexturing_0x10000000 :1; //Particle uses multi-texturing (could be one of the other WoD-specific flags), see multi-textured section.
	}Particle_Flags;
	C3Vector Pos;
	int16 Parent_Bone;
	if(xpac >= CATA){		// Im not sure about this part tho
		struct{
			uint16 Texture_0 : 5;
			uint16 Texture_1 : 5;
			uint16 Texture_2 : 5;
			uint16 Unk       : 1;
		}Multitexture;
	}else{
		uint16 texture;
	}

	int32 GeometryModel_length;
	int32 GeometryModel_offset<format=hex>;

	if(GeometryModel_length > 1){
		struct{
			local int oldpos = FTell();
			FSeek(GeometryModel_offset + ofsMD21_8);
			string Texture;
			FSeek(oldpos);
		}GeometryModelName;
	}

	int32 RecursionModel_length;
	int32 RecursionModel_offset<format=hex>;

	if(RecursionModel_length > 1){
		struct{
			local int oldpos=FTell();
			FSeek(RecursionModel_offset + ofsMD21_8);
			string texture;
			FSeek(oldpos);
		}RecursionModelName;
	}
	if( ReadInt(0x4 + ofsMD21_8) >= 262 ){ // Late TBC+ only
		PARTICLE_BLENDING Blending;
	}else{
		PARTICLE_BLENDING_TBC Blending;
	}

	if((xpac <= WOTLK) && (Blending >=5)){   // Blending Higher than LK
		if(MessageBoxMask==0){
			 MessageBoxMask = MessageBox(idYes | idOk | idNo,
			 "Invalid Blending",
			 "Emitter_type has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n" +
			 "Do you want this template to output a script to set default value? If Yes then press Ok\n" +
			 "In case you want to repair all particles as they are found then press Yes",
			 FTell());
		}
		if(MessageBoxMask==idOk){
			Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
			ParticleArrayIndex1++;
			Printf("Blending at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
			MessageBoxMask=0;
		}
		if(MessageBoxMask==idYes){
			Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
			ParticleArrayIndex1++;
			Printf("Blending at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
		}
		if(MessageBoxMask==idNo){
			Printf("Particles Error: Blending has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n", FTell());
			MessageBoxMask=0;
		}
	}

	if( ReadInt(0x4 + ofsMD21_8) >= 262 ){  // Late TBC+ only
		EMITTER_TYPE Emitter_type;
	}else{
		EMITTER_TYPE_TBC Emitter_type;
	}

	if((xpac <= WOTLK) && ((Emitter_type >=4) | (Emitter_type ==0)) ){   // Emitter_type Higher than LK
		if(MessageBoxMask==0){
			 MessageBoxMask = MessageBox(idYes | idOk | idNo,
			 "Invalid Emitter type",
			 "Emitter_type has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n" +
			 "Do you want this template to output a script to set default value? If Yes then press Ok\n" +
			 "In case you want to repair all particles as they are found then press Yes",
			 FTell());
		}
		if(MessageBoxMask==idOk){
			Particle_ItemsFix2[ParticleArrayIndex2] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
			ParticleArrayIndex2++;
			Printf("Emitter_type at: 0x%LX listed for fix default value will be: 1\n", (FTell()-0x1));
			MessageBoxMask=0;
		}
		if(MessageBoxMask==idYes){
			Particle_ItemsFix2[ParticleArrayIndex2] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
			ParticleArrayIndex2++;
			Printf("Emitter_type at: 0x%LX listed for fix default value will be: 1\n", (FTell()-0x1));
		}
		if(MessageBoxMask==idNo){
			Printf("Particles Error: Emitter_type has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n", FTell());
			MessageBoxMask=0;
		}
	}

	if( ReadInt(0x4 + ofsMD21_8) >= 262 ){   // Late TBC+ only
		uint16 ParticleColorReplaceable;
	}

	if( xpac >= CATA ){
		struct{
			ubyte MultiTextureParam1_2 : 2;
			ubyte MultiTextureParam1_5 : 5;
			ubyte MultiTextureParam2_2 : 2;
			ubyte MultiTextureParam2_5 : 5;
		}MultiTextureParams;
	}else{
		PARTICLE_TYPE Particle_type;
		if(/*(xpac <= WOTLK) &&*/ (Particle_type >=3)){   // Particle_type Higher than LK
			if(MessageBoxMask==0){
				 MessageBoxMask = MessageBox(idYes | idOk | idNo,
				 "Invalid Particly type",
				 "Particle_type has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n" +
				 "Do you want this template to output a script to set default value? If Yes then press Ok\n" +
				 "In case you want to repair all particles as they are found then press Yes",
				 FTell());
			}
			if(MessageBoxMask==idOk){
				Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
				ParticleArrayIndex1++;
				Printf("Particle_type at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
				MessageBoxMask=0;
			}
			if(MessageBoxMask==idYes){
				Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
				ParticleArrayIndex1++;
				Printf("Particle_type at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
			}
			if(MessageBoxMask==idNo){
				Printf("Particles Error: Particle_type has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n", FTell());
				MessageBoxMask=0;
			}
		}
		E_HEAD_OR_TAIL Head_or_Tail;
		if(/*(xpac <= WOTLK) &&*/ (Head_or_Tail >=3)){   // Head_or_Tail Higher than LK
			if(MessageBoxMask==0){
				 MessageBoxMask = MessageBox(idYes | idOk | idNo,
				 "Invalid Head or Tail",
				 "Head_or_Tail has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n" +
				 "Do you want this template to output a script to set default value? If Yes then press Ok\n" +
				 "In case you want to repair all particles as they are found then press Yes",
				 FTell());
			}
			if(MessageBoxMask==idOk){
				Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
				ParticleArrayIndex1++;
				Printf("Head_or_Tail at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
				MessageBoxMask=0;
			}
			if(MessageBoxMask==idYes){
				Particle_ItemsFix1[ParticleArrayIndex1] = ((FTell()-0x1)); //Printf("test adr: %LX\n", Particle_ItemsFix[ParticleArrayIndex]);
				ParticleArrayIndex1++;
				Printf("Head_or_Tail at: 0x%LX listed for fix default value will be: 0\n", (FTell()-0x1));
			}
			if(MessageBoxMask==idNo){
				Printf("Particles Error: Head_or_Tail has higher value than Wotlk 3.3.5 Supports at: 0x%LX\n", FTell());
				MessageBoxMask=0;
			}
		}
	}

	int16 TextureTileRotation;
	int16 TextureDimensions_rows;
	int16 TextureDimensions_columns;
	M2Track Emissionspeed("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Speed_var("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Vertical_range("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Horizontal_range("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Gravity("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Lifespan("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	if(xpac >= WOTLK){ float LifespanVary; }
	M2Track EmissionRate("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	if(xpac >= WOTLK){ float EmissionRateVary; }
	M2Track Emissionarea_length("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Emissionarea_width("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track zSource("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	if(xpac >= WOTLK){
		M2Track ColorTrack("sT", "sTimestamp", "sV", "RGB", 0)<fgcolor=0x2828FF, bgcolor=0x191919>;
		M2Track AlphaTrack("sT", "sTimestamp", "sV", "int16", 0)<fgcolor=0x2828FF, bgcolor=0x191919>;
		M2Track ScaleTrack("sT", "sTimestamp", "sV", "C2Vector", 0)<fgcolor=0x2828FF, bgcolor=0x191919>;
		C2Vector ScaleVary;
		M2Track HeadCellTrack("sT", "sTimestamp", "sV", "int16", 0)<fgcolor=0x2828FF, bgcolor=0x191919>;
		M2Track TailCellTrack("sT", "sTimestamp", "sV", "int16", 0)<fgcolor=0x2828FF, bgcolor=0x191919>;
	}else{
        float midPoint;			   // MiddleTime; Middle point in lifespan (0 to 1). Time (parametric) Middle â€“ The relative time of the middle key to the life.[1]								 
        C4Byte colorValues[3];	   // Color, Start/Middle/End â€“ Three values of BGRA Multiply for the particle.[1]
        float  ScaleValues[3];	   // Scale, Start/Middle/End â€“ Scale of the particle in units across.[1]
        uint16 LifespanUVAnim[3];  // Lifespan Head UV Anim â€“ Starting, middle and ending cell number for animating texture sequence of the first half of the Head particleâ€™s life. Repeat will cause this animating texture to cycle.[1]
        uint16 DecayUVAnim[3];	   // Decay Head UV Anim - Starting, middle and ending cell number for animating texture sequence of the second half of the Head particleâ€™s life. Repeat will cause this animating texture to cycle.[1]
        int16  TailUVAnim[2];	   // Lifespan Tail UV Anim - Starting and ending cell number for animating texture sequence of the first half of the Tail particleâ€™s life. Repeat will cause this animating texture to cycle.[1]
        int16  TailDecayUVAnim[2]; // Decay Tail UV Anim - Starting and ending cell number for animating texture sequence of the second half of the Tail particleâ€™s life. Repeat will cause this animating texture to cycle.[1]
	}
	float TailLength;
	float TwinkleSpeed;
	float TwinklePercent;
	C2Vector TwinkleScale;
	float BurstMultiplier;
	float Drag;
	if(xpac >= WOTLK){
		float BaseSpin;
		float BaseSpinVary;
		float Spin;
		float SpinVary;
	}else{
		float Spin;
	}
	C3Vector TumbleMin;
	C3Vector TumbleMax;
	C3Vector WindVector;
	float WindTime;
	float FollowSpeed1;
	float FollowScale1;
	float FollowSpeed2;
	float FollowScale2;
	int32 nSplinePoints;
	int32 ofsSplinePoints<format=hex>;

	if(nSplinePoints!=0){
		local int oldpos = FTell();
		FSeek(ofsSplinePoints + ofsMD21_8);
		C3Vector Spline_Points[nSplinePoints];
		FSeek(oldpos);
	}

	M2Track EnabledIn("T", "Timestamp", "V", "byte", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;

	if(xpac >= CATA){
		ushort unk1_1<comment="Cata+ Filler">; //03.12.2021
		ushort unk1_2<comment="Cata+ Filler">; //Trimitor: According to some information, this is "multi_texture_params"
		ushort unk2_1<comment="Cata+ Filler">;
		ushort unk2_2<comment="Cata+ Filler">; //Nix: textureIndex? The single uint16 is split into 3x5 bit values each texture id goes from 0..31?
		ushort unk3_1<comment="Cata+ Filler">;
		ushort unk3_2<comment="Cata+ Filler">;
		ushort unk4_1<comment="Cata+ Filler">;
		ushort unk4_2<comment="Cata+ Filler">;
	}
}sParticles<optimize=false>;

typedef struct{
	int32 RibbonID;					 // Always (as I have seen): -1.
	int32 Parent_Bone;				 // A bone to attach to.
	C3Vector Position;				 // And a position, relative to that bone.
	int32 nTextures;				 // Into textures
	int32 ofsTextures<format=hex>;
    local int oldpos;
	if(nTextures != 0){
		if(nTextures==1){
			oldpos = FTell();
			FSeek(ofsTextures + ofsMD21_8);
			int16 TextureIndex;
			FSeek(oldpos);
		}else{
			struct{
				oldpos = FTell();
				FSeek(ofsTextures + ofsMD21_8);
				local int i = 0;
				while(i < nTextures){
					int16 TextureIndex;
					i++;
				}
				FSeek(oldpos);
			}TextureIndices;
		}
	}
	int32 nMaterial;				 // Into materials
	int32 ofsMaterial<format=hex>;
	if(nMaterial != 0){
		if(nMaterial==1){
			oldpos = FTell();
			FSeek(ofsMaterial + ofsMD21_8);
			int16 MaterialIndex;
			FSeek(oldpos);
		}else{
 			struct{
				local int oldpos = FTell();
				FSeek(ofsMaterial + ofsMD21_8);
				local int i = 0;
				while(i < nMaterial){
					int16 MaterialIndex;
					i++;
				}
				FSeek(oldpos);
			}MaterialIndices;
		}
	}
    
    if(xpac >= WOTLK){
		M2Track ColorTrack("sT", "sTimestamp", "V", "C3RGB", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;     // An RGB multiple for the material.
        M2Track AlphaTrack("sT", "sTimestamp", "sV", "int16", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;   // And an alpha value in a short, where: 0 - transparent, 0x7FFF - opaque.
    }else{
		M2Track ColorTrack("T", "Timestamp", "V", "RGB", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;     // An RGB multiple for the material.
		M2Track AlphaTrack("T", "Timestamp", "V", "int16", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;   // And an alpha value in a short, where: 0 - transparent, 0x7FFF - opaque.
    }
	M2Track heightAboveTrack("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;   // Above and Below â€“ These fields define the width of a ribbon in units based on their offset from the origin.
	M2Track heightBelowTrack("T", "Timestamp", "V", "float", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;   // do not set to same!
	float EdgesPerSec;       // This defines how smooth the ribbon is. A low value may produce a lot of edges.  Edges/Sec â€“ The number of quads generated.
	float EdgeLifeSpanInSec; // The length aka Lifespan. in seconds Time in seconds that the quads stay around after being generated.
	float Gravity;		     // Use arcsin(val) to get the emission angle in degree Can be positive or negative. Will cause the ribbon to sink or rise in the z axis over time.
	int16 TextureRows;	     // Tiles in texture
	int16 TextureCols;	     // Texture Rows and Cols â€“ Allows an animating texture similar to BlizParticle. Set the number of rows and columns equal to the texture.
	M2Track TexSlotTrack("T", "Timestamp", "V", "uint16", 1)<bgcolor=0x2828FF, bgcolor=0x191919>;   // Pick the index number of rows and columns, and animate this number to get a cycle.
	M2Track VisibilityTrack("T", "Timestamp", "V", "byte", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	if(xpac >= WOTLK){
		int16 PriorityPlane;
		byte RibbonColorIndex;
		byte TextureTransformLookupIndex; // Index into m2data.header.textureTransformCombos. Applied only if m2data.header.global_flags.flag_unk_0x20000 flag is set
	}
}sRibbons;

typedef struct{
	M2Track Color("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
	M2Track Alpha("T", "Timestamp", "V", "uint16", 1)<fgcolor=0x2828FF, bgcolor=0x191919>;
}sColors;

typedef struct{
	M2Track Translation("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xF9F934, bgcolor=0x191919>;
	M2Track Rotation("T", "Timestamp", "V", "C4CompQuatVector", 1)<fgcolor=0xF9F934, bgcolor=0x191919>;
	M2Track Scaling("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xF9F934, bgcolor=0x191919>;
}Texture_Animations;

typedef struct{
	E_CAMERATYPE Type;
	if(xpac < CATA){
	    local uint32 pos = FTell();
	    float Diag_FOV<read=Str("Rad: %f Deg: %f", this, (this*180/PI)), comment="Diagonal FOV, Wotlk">;
	    FSeek(pos);
	    float Vert_FOV<read=Str("Rad: %f Deg: %f", (this)/Sqrt(1+Pow((1.77777),2)), ((this)/Sqrt(1+Pow((1.77777),2))*180/PI)), comment="Vertical FOV, Wotlk">;
	    //vFoV = (FoV)/Sqrt(1+Pow((res_x/res_y),2));
	    FSeek(pos);
	    float Hori_FOV<read=Str("Rad: %f Deg: %f", ((this)/Sqrt(1+Pow((1.77777),2))*(1.77777)), (((this)/Sqrt(1+Pow((1.77777),2))*180/PI))*(1.77777)), comment="Horizontal FOV, Wotlk">;
	    //hFoV = vFoV*(res_x/res_y);
    
	    /*  Export conversion:
		    Convert horizontal to vertical:
		    vFoV = hFoV / ( res_x / res_y );
		    Convert vertical to diagonal:
		    FoV = vFoV * Sqrt( 1 + Pow(( res_x / res_y ), 2)); */
	}
	float FarClipping;
	float NearClipping;
	M2Track TranslationPos("T", "Timestamp", "V", "C3VectorBF", 1)<fgcolor=0xFF0C00, bgcolor=0x191919>;
	C3Vector Pos;
	M2Track TranslationTar("T", "Timestamp", "V", "C3VectorBF", 1)<fgcolor=0xFF0C00, bgcolor=0x191919>;
	C3Vector Target;
	M2Track RollEffect("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xFF0C00, bgcolor=0x191919>;
	if(xpac >= CATA){
		M2Track FOV("T", "Timestamp", "V", "C3Vector", 1)<fgcolor=0xFF0C00, bgcolor=0x191919, comment="Cata+">;
	}
}sCameras<read=ReadCam>;

string ReadCam(sCameras &c){
	return EnumToString(c.Type);
}

typedef int16 CameraIndicesByIDRec<read=readCameraIndicesByIDRec>;

string readCameraIndicesByIDRec( CameraIndicesByIDRec v ){
	string s;
	if(v!=-1){
		local uint32 ofsCameraTemp = ReadUInt(0x114 + ofsMD21_8);
		local E_CAMERATYPE CameraType = ReadUInt(0x0 + ofsCameraTemp + ( v * 0x64) + ofsMD21_8);
		SPrintf(s, "%d : %s", v, EnumToString(CameraType));
	}else{
		SPrintf(s, "%d", v);
	}
	return s;
}

typedef struct{
	union{
		E_RENDERFLAGS Enum_flag;
		struct{
			uint16 Unlit_0x1							:1; 
			uint16 Unfogged_0x2							:1; 
			uint16 TwoSided_0x4 						:1; // (No backface culling if set)
			uint16 DepthTest_0x8						:1;
			uint16 DepthWrite_0x10					    :1;
			uint16 Unk_0x20							    :1;
			uint16 ShadowBatch_0x40			            :1; // Shadow batch related ??? (seen in WoD) (seen in 31 models in Wrath)
			uint16 ShadowBatch_0x80 	 		        :1; // Shadow batch related ??? (seen in WoD) (seen in 2 models in Wrath : SpectralTiger.m2 and SpectralTigerEpic.m2)
			uint16 UNK_Fog_0x100					    :1<comment="LK+">;  // (seen in 1 model in Wrath : HFjord_Fog_02.m2)
			uint16 ShadowBatch_0x200					:1<comment="WoD+">; // shadow batch related ??? (seen in WoD)
			uint16 Unk_0x400 							:1<comment="WoD+">;
			uint16 PreventAlphaForCustomElements_0x800	:1<comment="MoP+">;
			uint16 Unk_0x1000                           :1;
		}E_MaterialFLAGS<format=binary>;  // <read=Str("%f", (this*1.0))>;
	}flags<read=(Str("%s (%d)", EnumToString(Enum_flag), ReadUShort(startof(this)) )), open=true>;
	//E_RENDERFLAGS flag;
	E_RENDERMODES blendingmode;
}sMaterials<read=ReadMaterial>;

string ReadMaterial(sMaterials &m){ //TODO
	return Str("%s (%d) \t\t %s (%d)", EnumToString(m.blendingmode), m.blendingmode, EnumToString(m.flags.Enum_flag), m.flags.Enum_flag) ;
}

struct{ // Start of 'M2_file.' structure
if(ReadString(0x0,4) == "MD21"){
	CHAR MD21Magic[4]<fgcolor=cYellow>;
	uint ofsMD21<format=hex, fgcolor=cYellow>;
	ofsMD21_8 = 0x8;
}else{
	ofsMD21_8 = 0x0;
}

CHAR MD20Magic[4]<fgcolor=0x5050DD>;	   // 0x0
if(xpac == VANILLA){ uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=0x98391A>; } // 0x4
if(xpac == TBC)    { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=cLtGreen>; }
if(xpac == WOTLK)  { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=cAqua>;	}
if(xpac == CATA)   { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=0xFF0000>; }
if(xpac == MOP)    { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=609805>;   }
if(xpac == WOD)    { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=0xFFA07A>; }
if(xpac == LEGION) { uint Version<comment=Str("%s", EnumToString(xpac)), fgcolor=cGreen>;   }
if(exists(Version)!=1 ){ uint Version<comment="Unk", fgcolor=0x5050DD>; }

SetForeColor(0x5050DD);
uint lName; 							   // 0x8
uint ofsName<format=hex>;				   // 0xC
struct{									   // 0x10
	uint32 Tilt_X_0x1						   :1<comment="Vanila">;   // model will tilt according to terrain on X axis
	uint32 Tilt_Y_0x2						   :1<comment="Vanila">;   // model will tilt according to terrain on Y axis
	uint32 Unk_0x4							   :1<comment="Vanila">;
	uint32 Texture_Combiner_0x8 			   :1<comment="TBC">;	   // add textureCombinerCombos array to end of header
	uint32 Unk_0x10 						   :1<comment="TBC">;
	uint32 Load_Phys_Data_Mop_0x20			   :1<comment="MoP">;
	uint32 Unk_0x40 						   :1<comment="MoP">;
	uint32 Unk_Wod_0x80 					   :1<comment="WoD">;
	uint32 CameraReleated_0x100 			   :1<comment="WoD">;
	uint32 New_Particle_Record_0x200		   :1<comment="Legion">;
	uint32 Unk_0x400						   :1<comment="Legion">;
	uint32 TexTransformsUseBoneSequences_0x800 :1<comment="Legion">;
	uint32 Unk_0x1000						   :1<comment="Legion">;
	uint32 ChunkedAnimFiles_0x2000			   :1<comment="Legion">;   // seen in various legion models
	uint32 Unk_0x4000						   :1<comment="Legion">;   // "armor2 model"?
	uint32 Unk_0x8000						   :1<comment="Legion+">;  // seen in UI_MainMenu_Legion
	uint32 Unk_0x10000						   :1;
	uint32 Unk_0x20000						   :1;
	uint32 Unk_0x40000						   :1;
	uint32 Unk_0x80000						   :1;
	uint32 Unk_0x100000 					   :1;
	uint32 Unk_0xNewChunks 					   :1; // Apparently: use 24500 upgraded model format: chunked .anim files, change in the exporter reordering sequence+bone blocks before name or if the M2 has a .skel file
	uint32 Unk_0x400000 					   :1;
	uint32 Unk_0x800000 					   :1;
	uint32 Unk_0x1000000 					   :1;
	uint32 Unk_0x2000000 					   :1;
	uint32 Unk_0x4000000 					   :1;
	uint32 Unk_0x8000000 					   :1;
	uint32 Unk_0x10000000 					   :1;
	uint32 Unk_0x20000000 					   :1;
	uint32 Unk_0x40000000 					   :1;
	uint32 Unk_0x80000000 					   :1;
}Flags<read=Str("%Xh", ReadUInt(0x10+ofsMD21_8))>; // WIP
uint nLoops<comment="GlobalSequneces">;	   // 0x14
uint ofsLoops<format=hex>;				   // 0x18
uint nSequences<comment="Animations">;	   // 0x1C
uint ofsSequences<format=hex>; 			   // 0x20
uint nSequenceIdxHashByID<comment="AnimLookUp">;// 0x24
uint ofsSequenceIdxHashByID<format=hex>;   // 0x28
if(xpac <= TBC){   // M2SequenceFallback TBC insert
	uint nSequenceFallback<format=hex, comment="TBC">;
	uint ofsSequenceFallback<format=hex>;
}
uint nBones;								// 0x2C
uint ofsBones<format=hex>;					// 0x30
uint nBoneIndicesByID<comment="KeyBones">; 	// 0x34
uint ofsBoneIndicesByID<format=hex>;		// 0x38
uint nVertices; 							// 0x3C
uint ofsVertices<format=hex>;				// 0x40
uint nSkinProfiles<comment="Views">;		// 0x44
if(xpac <= TBC){   // skin_profiles TBC insert
	uint ofsSkinProfiles<format=hex, comment="TBC">;
}
uint nColors;								// 0x48
uint ofsColors<format=hex>; 				// 0x4C
uint nTextures; 							// 0x50
uint ofsTextures<format=hex>;				// 0x54
uint nTexWeights<comment="Transparency">;   // 0x58
uint ofsTexWeights<format=hex>;				// 0x5C
if(xpac <= TBC){   // M2SequenceFallback TBC insert
	uint nTextureFlipbook<format=hex, comment="TBC">;   // Never seen in file, 4 uint32_t fields. (M2Track<ushort>)
	uint ofsTextureFlipbook<format=hex>;
}
uint nTexTransforms<comment="TexAnimations">;// 0x60
uint ofsTexTransforms<format=hex>;			// 0x64
uint nTexIndicesByID<comment="ReplaceTextureLookup">;// 0x68 // (alt. name: replacable_texture_lookup)
uint ofsTexIndicesByID<format=hex>; 		// 0x6C
uint nMaterials;							// 0x70 // Blending modes / render flags.
uint ofsMaterials<format=hex>;				// 0x74
uint nBoneCombos<comment="BoneLookUp">;	    // 0x78 // (alt. name: bone_lookup_table)
uint ofsBoneCombos<format=hex>;				// 0x8C
uint nTexCombos<comment="TexLookup">;	    // 0x80 // (alt. name: texture_lookup_table)
uint ofsTexCombos<format=hex>;  			// 0x84
uint nTexCoordCombos<comment="TexUnitLookUp">;// 0x88 // (alt. name: tex_unit_lookup_table, texture_mapping_lookup_table)
uint ofsTexCoordCombos<format=hex>;			// 0x9C
uint nTexWeightCombos<comment="TransparencyLookUp">;// 0x90 // (alt. name: transparency_lookup_table)
uint ofsTexWeightCombos<format=hex>;		// 0x94
uint nTexTransformCombos<comment="TexTransformsLookUp">;// 0x98 // (alt. name: texture_transforms_lookup_table)
uint ofsTexTransformCombos<format=hex>;		// 0x9C
TheFloats Bounds<comment="ModelBox">;	    // 0xA0
uint nCollisionIndices<comment="C.triangles">; // 0xD8 // (alt. name: collision_triangles)
uint ofsCollisionIndices<format=hex>;		// 0xDC
uint nCollisionPositions<comment="C.vertices">;// 0xE0 // (alt. name: collision_vertices)
uint ofsCollisionPositions<format=hex>; 	// 0xE4
uint nCollisionFaceNormals<comment="C.normals">;// 0xE8 // (alt. name: collision_normals)
uint ofsCollisionFaceNormals<format=hex>;	// 0xEC
uint nAttachments;							// 0xF0
uint ofsAttachments<format=hex>;			// 0xF4
uint nAttachIndicesByID<comment="AttachLookUp">;// 0xF8
uint ofsAttachIndicesByID<format=hex>;		// 0xFC
uint nEvents;								// 0x100
uint ofsEvents<format=hex>; 				// 0x104
uint nLights;								// 0x108
uint ofsLights<format=hex>; 				// 0x10C
uint nCameras;								// 0x110
uint ofsCameras<format=hex>;				// 0x114
uint nCameraIndicesByID<comment="CameraLookUp">;// 0x118
uint ofsCameraIndicesByID<format=hex>;		// 0x11C
uint nRibbonEmitters;						// 0x120
uint ofsRibbonEmitters<format=hex>; 		// 0x124
uint nParticleEmitters; 					// 0x128
uint ofsParticleEmitters<format=hex>;		// 0x12C

if(ReadInt(0x10 + ofsMD21_8) & 8){
	uint nTextureCombiner;					// 0x130 // Second_Texture_Material_Override_Combos
	uint ofsTextureCombiner<format=hex>;	// 0x134
	FSeek(ofsTextureCombiner + ofsMD21_8);
	if(nTextureCombiner % 2 == 0){
		Texture_Combiner TextureCombiner[ (nTextureCombiner/2) ];
	}else{
		uint16 _TxtCombo[nTextureCombiner];
	}
}

if(ofsLoops != 0){						    // Global Sequences Block
	FSeek(ofsLoops + ofsMD21_8);
	uint32 Loops[nLoops]<fgcolor=cDkRed, bgcolor=cDkGray>;
}

if(ofsName != 0){ 						    // Internal Model Name Block
	FSeek(ofsName + ofsMD21_8);
	string ModelName<fgcolor=cWhite, bgcolor=cBlack>;
}

if(ofsSequences != 0){					    // Animations Sequences Block
	FSeek(ofsSequences + ofsMD21_8);
	sSequences Sequences[nSequences]<optimize=true, fgcolor=cAqua, bgcolor=cDkGray>;
}else{
	if(!exists(ofsMD21)) local uint64 ofsMD21;
	if(FindFirst("SKID", true, false, 0, 0.0, 1, (ofsMD21)) == -1){
		local string NoAnimWarn = "No Animations/SKID in model will result in crash!";
		Printf(NoAnimWarn + "\n");
		Warning(NoAnimWarn);
	}
}

if(ofsSequenceIdxHashByID != 0){		    // Animations LookUp Block
	FSeek(ofsSequenceIdxHashByID + ofsMD21_8);
	struct{
	    local int16 i=0;
        //local E_SEQUENCES eSequenceIDxHashId_reader;
	    while(i < nSequenceIdxHashByID){
            //eSequenceIDxHashId_reader = i;
            SequenceIdxHashByIdEntry_rec eSequenceIDxHashId_record;
            //int16 Data<name=EnumToString(eSequenceIDxHashId_reader)>;
		    i++;
	    }
		//SequenceIdxHashByIDEntry(nSequenceIdxHashByID);
	}SequenceIDxHashByID<name=(Str("SequenceIDxHashByID[%d]", M2_file.nSequenceIdxHashByID)), fgcolor=0xFFAA00, bgcolor=cDkGray>;
}

if(xpac <= TBC){   // M2SequenceFallback TBC insert
	if(ofsSequenceFallback != 0){		    // playable_animation_lookup
		FSeek(ofsSequenceFallback + ofsMD21_8);
		sSequenceFallback SequenceFallback[nSequenceFallback]<fgcolor=cAqua, bgcolor=cDkGray>;
	}
}

if(nBones !=0){    // nBoneLimiter
	if(nBones > nBoneLimiter){
		FSeek(ofsBones + ofsMD21_8);	    // Bone Block - short
		sBone Bones(0)[nBones]<optimize=false, fgcolor=0xFF00FF, bgcolor=0x331900>;
        Printf("Loaded Keyframeless Bone M2Tracks, Current Limit is: %d\n", nBoneLimiter);
	}else{
		FSeek(ofsBones + ofsMD21_8);	    // Bone Block - complete
		struct{
			local int n=0;
			while(n < nBones){
				sBone Bones(1)<optimize=false, fgcolor=0xFF00FF, bgcolor=0x331900>;
				n++;
			}
            Printf("Loaded Keyframe Bone M2Tracks\n");
		}Bones<name=(Str("Bones[%d]", M2_file.nBones))>;
	}

/*	if(nBones > 100){
	    if(MessageBox(idYes | idNo, "Bone Count",
	    "M2 ('%s') has 100+ bones do you wish to skip bone timestamps ?",
	    FileNameGetBase(GetFileName()))  == idYes){
		    FSeek(ofsBones + ofsMD21_8);	   // Bone Block - short
		    sBone Bones(0)[nBones]<optimize=false, fgcolor=0xFF00FF, bgcolor=0x331900>;
	    }else{
		    FSeek(ofsBones + ofsMD21_8);	   // Bone Block - complete
		    struct{
			    local int n=0;
			    while(n < nBones){
				    sBone Bones(1)<optimize=false, fgcolor=0xFF00FF, bgcolor=0x331900>;
				    n++;
			    }
		    }Bones<name=(Str("Bones[%d]", M2_file.nBones))>;
	    }
	}else{
		FSeek(ofsBones + ofsMD21_8);		   // Bone Block - complete
		struct{
			local int n=0;
			while(n < nBones){
				sBone Bones(1)<optimize=false, fgcolor=0xFF00FF, bgcolor=0x331900>;
				n++;
			}
		}Bones<name=(Str("Bones[%d]", M2_file.nBones))>;
	}
*/    
}

if(ofsBoneIndicesByID != 0){ 				 // KeyBoneLookup Block BoneIndicesByID
	FSeek(ofsBoneIndicesByID + ofsMD21_8);
	struct{
		//BoneIndicesByIDEntry(nBoneIndicesByID);
        local int i=0;
	    while(i < nBoneIndicesByID){
            BoneIndicesID_rec eBoneIndicesByID_record;
		    i++;
	    }
	}BoneIndicesByID<name=(Str("BoneIndicesByID[%d]", M2_file.nBoneIndicesByID)), fgcolor=0xFF00FF, bgcolor=0x331900, comment="KeyBones">;
}

if(ofsVertices !=  0){ 						 // Vertices Block
	FSeek(ofsVertices + ofsMD21_8);
	sVertices Vertices[nVertices]<fgcolor=0x00FFFF, bgcolor=0x330033, read=Str("(%f %f %f)", this.Position.x, this.Position.y, this.Position.z)>;
}

if(xpac <= TBC){
	if(ofsSkinProfiles !=  0){ 				 // Vertices Block
		FSeek(ofsSkinProfiles + ofsMD21_8);
		struct{
			local int n = 0;
			while(n < nSkinProfiles){
				sSkinProfiles SkinProfiles(n)<fgcolor=0x00FFFF, bgcolor=0x330033>;
				n++;
			}
		}SkinProfiles<name=(Str("SkinProfiles[%d]", M2_file.nSkinProfiles))>;
	}
}

if(ofsColors != 0){						    // Color Block
	FSeek(ofsColors + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nColors){
			sColors Color<fgcolor=0xFFFFFF, bgcolor=cDkGray>;
			n++;
		}
	}Color<name=(Str("Color[%d]", M2_file.nColors))>;
}

if((nTextures!=0) && (ofsTextures!=0)){	    // Texture Block
	FSeek(ofsTextures + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nTextures){
			sTexture Texture(n)<fgcolor=0xFF00BF, bgcolor=0x112200>;
			n++;
		}
	}Textures<name=(Str("Textures[%d]", M2_file.nTextures))>;
}

if(ofsTexWeights != 0){ 					// Transparency Block  --> texture_weights
	FSeek(ofsTexWeights + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nTexWeights){
			M2Track TexWeights("T", "Timestamp", "V", "uint16", 1)<fgcolor=0xF9F934, bgcolor=0x191919>;
			n++;
		}
	}TexWeights<name=(Str("TexWeights[%d]", M2_file.nTexWeights)), comment="Transparency">;
}

if(ofsTexTransforms != 0){					// Texture Animation Block --> texture_flipbooks
	FSeek(ofsTexTransforms + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nTexTransforms){
			Texture_Animations TexAnim<fgcolor=0xF9F934, bgcolor=0x191919>;
			n++;
		}
	}TextureTransforms<name=(Str("TextureTransforms[%d]", M2_file.nTexTransforms))>;
}

if(ofsTexIndicesByID != 0){					// Texture Replacement Block --> texture_transforms
	FSeek(ofsTexIndicesByID + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nTexIndicesByID){
			TexIndicesByIDRec TexIndicesByID;
			n++;
		}
	}TexIndicesByIDTable<name=(Str("TexIndicesByIDTable[%d]", M2_file.nTexIndicesByID)), fgcolor=0xF9F934, bgcolor=0x191919, comment="ReplacableTextureLookup">;
}

if(ofsMaterials != 0){						// Texture materials
	FSeek(ofsMaterials + ofsMD21_8);
	sMaterials Materials[nMaterials]<fgcolor=0xFF00BF, bgcolor=0x000000>;
}

if(ofsBoneCombos != 0){						// BoneLookup Block
	FSeek(ofsBoneCombos + ofsMD21_8);
	int16 BoneCombosTable[nBoneCombos]<comment="BoneLookup" ,fgcolor=0xFF00FF, bgcolor=0x331900>;
}

if(ofsTexCombos != 0){						// Texture lookup
	FSeek(ofsTexCombos + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nTexCombos){
			TexComboIDRec TexComboID;
			n++;
		}
	}TexComboTableID<name=(Str("TexComboTableID[%d]", M2_file.nTexCombos)), comment="TexLookup" ,fgcolor=0xF9F934, bgcolor=0x191919>;
}

if(ofsTexCoordCombos != 0){ 				// Texture units
	FSeek(ofsTexCoordCombos + ofsMD21_8);
	E_Mapping TexCoordCombosTable[nTexCoordCombos]<comment="TexUnitLookup" ,fgcolor=0xF9F934, bgcolor=0x191919>;
}

if(ofsTexWeightCombos != 0){				// Transparency lookup
	FSeek(ofsTexWeightCombos + ofsMD21_8);
	int16 TexWeightCombosTable[nTexWeightCombos]<comment="TranspLookup" ,fgcolor=0xF9F934, bgcolor=0x191919>;
}

if(ofsTexTransformCombos != 0){				// Texture animation lookup
	FSeek(ofsTexTransformCombos + ofsMD21_8);
	int16 TexTransformCombosTable[nTexTransformCombos]<comment="TexAnimLookup" ,fgcolor=0xF9F934, bgcolor=0x191919>;
}

if(ofsCollisionIndices != 0){ 				// Collision_triangles
	FSeek(ofsCollisionIndices + ofsMD21_8);
	C3sVector CollisionIndices[nCollisionIndices/3]<optimize=false, fgcolor=0xFFFFFF, bgcolor=0xf995d8, comment="Triangles">;
}

if(ofsCollisionPositions != 0){				// Collision_vertices
	FSeek(ofsCollisionPositions + ofsMD21_8);
	C3Vector CollisionPositions[nCollisionPositions]<optimize=false, fgcolor=0xFFFFFF, bgcolor=0xf995d8, comment="Vertices">;
}

if(ofsCollisionFaceNormals != 0){ 			// Collision_normals
	FSeek(ofsCollisionFaceNormals + ofsMD21_8);
	C3Vector CollisionFaceNormals[nCollisionFaceNormals]<optimize=false, fgcolor=0xFFFFFF, bgcolor=0xf995d8, comment="Normals">;
}

if(ofsAttachments != 0){					// Attachment position of equipped weapons or effects
	FSeek(ofsAttachments + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nAttachments){
			sAttachments Attachment<fgcolor=0x0B9AED, bgcolor=cBlack>;
			n++;
		}
	}Attachments<name=(Str("Attachments[%d]", M2_file.nAttachments))>;
}

if(nAttachIndicesByID != 0){				// Attachment_lookup_table
	FSeek(ofsAttachIndicesByID + ofsMD21_8);
	struct{
        local int i = 0;
        while( i < nAttachIndicesByID ){
            ATTACHMENT_ID_rec AttachIndicesByID_rec;
            i++;
        }
		//AttachmentLookUpEntry(nAttachIndicesByID);
	}AttachIndicesByID<name=(Str("AttachIndicesByID[%d]", M2_file.nAttachIndicesByID)), fgcolor=0x96D8FF, bgcolor=cBlack>;
}

if(ofsEvents!=0){
	FSeek(ofsEvents + ofsMD21_8);			// Used for playing sounds when dying and a lot else
	struct{
		local int n = 0;
		while(n < nEvents){
			sEvents Event<fgcolor=0xA3FF87, bgcolor=0x1E1E1E>;
			n++;
		}
	}Events<name=(Str("Events[%d]", M2_file.nEvents))>;
}

if(ofsLights != 0){							// Lights are mainly used in loginscreens but in wands and some doodads too
	FSeek(ofsLights + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nLights){
			sLights Light<fgcolor=0x80FFFF, bgcolor=0x008080>;
			n++;
		}
	}Light<name=(Str("Light[%d]", M2_file.nLights))>;
}

if(ofsCameras != 0){						// The Cameras are present in most models for having a model in the character tab
	FSeek(ofsCameras + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nCameras){
			sCameras Camera<fgcolor=0xFF0C00, bgcolor=0x191919>;
			n++;
		}
	}Camera<name=(Str("Camera[%d]", M2_file.nCameras))>;
}

if(ofsCameraIndicesByID != 0){
	FSeek(ofsCameraIndicesByID + ofsMD21_8); // Camera_lookup_table
	struct{
		local int n = 0;
		while(n < nCameraIndicesByID){
			CameraIndicesByIDRec CameraIndicesByID;
			n++;
		}
	}CameraIndicesByID<name=(Str("CameraIndicesByID[%d]", M2_file.nCameraIndicesByID)), fgcolor=0x80FFFF, bgcolor=0x008080>;
}

if(ofsRibbonEmitters != 0){					 //Things swirling around. See the CoT-entrance for light-trails
	FSeek(ofsRibbonEmitters + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nRibbonEmitters){
			sRibbons Ribbon<fgcolor=0x6D6DFF, bgcolor=0x191919>;
			n++;
		}
	}Ribbon<name=(Str("Ribbon[%d]", M2_file.nRibbonEmitters))>;
}

if(ofsParticleEmitters != 0){ 				 // Particle generation system
	local int64 Particle_ItemsFix1[256];
	local ubyte ParticleArrayIndex1 = 0;
	local int64 Particle_ItemsFix2[256];
	local ubyte ParticleArrayIndex2 = 0;
	FSeek(ofsParticleEmitters + ofsMD21_8);
	struct{
		local int n = 0;
		while(n < nParticleEmitters){
			sParticles Particle<fgcolor=0x2828FF, bgcolor=0x191919>;
			n++;
		}
	}Particle<name=(Str("Particle[%d]", M2_file.nParticleEmitters))>;
}

