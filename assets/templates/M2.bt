typedef struct{ //<read=Str("us: %u f: %f\n", this, stf(this)), comment="Comp short to float">
	uint16 x<read=Str("%f", stf(this)), write=(this=fts(Atof(value))), comment="Comp ushort to float X">;
	uint16 y<read=Str("%f", stf(this)), write=(this=fts(Atof(value))), comment="Comp ushort to float Y">;
	uint16 z<read=Str("%f", stf(this)), write=(this=fts(Atof(value))), comment="Comp ushort to float Z">;
	uint16 w<read=Str("%f", stf(this)), write=(this=fts(Atof(value))), comment="Comp ushort to float W">;
}C4CompQuatVector<read=C4CompQuatVectorRead, optimize=false>;

string C4CompQuatVectorRead(C4CompQuatVector& rec){
	string a;
	SPrintf(a, "(%f %f %f %f)\n", stf(rec.x), stf(rec.y), stf(rec.z), stf(rec.w));
	return a;
}

