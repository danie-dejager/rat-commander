}M2_file<open=true>;

void FindMD21Chunk(string ChunkName){
	local int64 pos = FindFirst(ChunkName, true, false, 0, 0.0, 1, (ofsMD21));
	if(pos != -1){
		local uint32 ChunkSize = ReadUInt(pos+0x4);
		if((pos + 0x8 + ChunkSize) > FileSize()) return;
		FSeek(pos);
		switch(ChunkName){
			case "PFID":
				PFID_C PFID<fgcolor=0x80FF00, comment="PHYS FID">;
				break;
			case "SFID":
				SFID_C SFID<fgcolor=0x80FF0A, comment="SKIN FID">;
				break;
			case "AFID":
				AFID_C AFID<fgcolor=0x80FF00, comment="ANIM FID">;
				break;
			case "BFID":
				BFID_C BFID<fgcolor=0x80FF1E, comment="BONE FID">;
				break;
			case "TXAC":
				TXAC_C TXAC<fgcolor=0x80FF28, comment="Texture_AC">;
				break;
			case "EXPT":
				EXPT_C EXPT<fgcolor=0x80FF32, comment="M2ExtendedParticle">;
				break;
			case "EXP2":
				EXPT_C EXP2<fgcolor=0x80FF3C, comment="M2ExtendedParticle2">;
				break; //not making EXP2 struc it looks same as EXPT
			case "PABC":
				PABC_C PABC<fgcolor=0x80FF46, comment="M2InitBlacklistAnimData">;
				break;
			case "PADC":
				PADC_C PADC<fgcolor=0x80FF50, comment="M2InitParentAnimData">;
				break;
			case "PSBC":
				PSBC_C PSBC<fgcolor=0x80FF5A, comment="M2InitParentSequenceBoundsData">;
				break;
			case "PEDC":
				PEDC_C PEDC<fgcolor=0x80FF64, comment="M2InitParentEventData">;
				break;
			case "SKID":
				SKID_C SKID<fgcolor=0x80FF6E, comment="SKEL FID">;
				break;
			case "TXID":
				TXID_C TXID<fgcolor=0x80FF78, comment="Texture FID">;
				break;
			case "LDV1":
				LDV1_C LDV1<fgcolor=0x80FF82, comment="LOD skin">;
				break;
			case "RPID":
				RPID_C RPID<fgcolor=0x80FF8C, comment="RecursiveParticleModel">;
				break;
			case "GPID":
				GPID_C GPID<fgcolor=0x80FF96, comment="ParticleModel">;
				break;
			case "WFV1":
				WFV1_C WFV1<fgcolor=0x80FFA0, comment="Waterfall">;
				break;
			case "WFV2":
				WFV2_C WFV2<fgcolor=0x80FFAA, comment="Waterfall">;
				break;
			case "PGD1":
				PGD1_C PGD1<fgcolor=0x80FFB4, comment="ParticleGeoset">;
				break;
			case "WFV3":
				WFV3_C WFV3<fgcolor=0x80FFBE, comment="Waterfall">;
				break;
			case "PFDC":
				PFDC_C PFDC<fgcolor=0x80FFC8, comment="Phys">;
				break;
			case "EDGF":
				EDGF_C EDGF<fgcolor=0x80FFD2, comment="EdgeFade">;
				break;
			case "NERF":
				NERF_C NERF<fgcolor=0x80FFDC, comment="Alpha?">;
				break;
			case "DETL":
				DETL_C DETL<fgcolor=0x80FFDC, comment="Lights?">;
				break;
			case "DBOC":
				DBOC_C DBOC<fgcolor=0x80FFE6, comment="Unk">;
				break;
			case "AFRA":
				AFRA_C AFRA<fgcolor=0x80FFF0, comment="Unk">;
				break;
			case "PCOL":
				PCOL_C PCOL<fgcolor=0x80FFFA, comment="CollisionMesh">;
				break;                
			case "DPIV":
				DPIV_C DPIV<fgcolor=0x60FFFA, comment="Unk">;
				break;                
		}
		Printf("Pos of %s: 0x%LX\n", ChunkName, pos);
	}
}

/***********************************
*  5. Automated Script Fix Creator *
************************************/
if(M2_file.nParticleEmitters>0){
	local int PAI1 = 0;
	while(PAI1<M2_file.ParticleArrayIndex1){
		Printf("WriteByte(0x%X, 0);\n", M2_file.Particle_ItemsFix1[PAI1]);
		PAI1++;
	}

	local int PAI2 = 0;
	while(PAI2<M2_file.ParticleArrayIndex2){
		Printf("WriteByte(0x%X, 1);\n", M2_file.Particle_ItemsFix2[PAI2]);
		PAI2++;
	}
}

/************************************
*  6. Debug values for testing      *
*************************************/

// Function to parse time string "hh:mm:ss:zzz" into total milliseconds
int ParseTimeToMilliseconds(string timeStr){
    local int hours, minutes, seconds, milliseconds;
    local int parsed = SScanf(timeStr, "%d:%d:%d:%d", hours, minutes, seconds, milliseconds);
    
    if(parsed != 4){
        Printf("Error: Invalid time format - expected hh:mm:ss:zzz\n");
        return -1;
    }
    
    // Validate time components
    if(hours < 0 || hours > 23 || minutes < 0 || minutes > 59 || 
        seconds < 0 || seconds > 59 || milliseconds < 0 || milliseconds > 999){
        Printf("Error: Invalid time values\n");
        return -1;
    }
    
    return (hours * 3600 + minutes * 60 + seconds) * 1000 + milliseconds;
}

// Function to format milliseconds into "hh:mm:ss:zzz"
string FormatMilliseconds(int totalMs) {
    if(totalMs < 0) return "Invalid duration";
    
    local int ms = totalMs % 1000;
    local int totalSeconds = totalMs / 1000;
    local int hours = totalSeconds / 3600;
    local int minutes = (totalSeconds % 3600) / 60;
    local int seconds = totalSeconds % 60;
    
    return Str("%02d:%02d:%02d:%03d", hours, minutes, seconds, ms);
}

// Main function to calculate time difference
void CalculateRuntime(string startTimeStr, string endTimeStr) {
    local int startMs = ParseTimeToMilliseconds(startTimeStr);
    local int endMs = ParseTimeToMilliseconds(endTimeStr);
    
    if(startMs == -1 || endMs == -1){
        Printf("Error parsing time strings\n");
        return;
    }
    
    if(endMs < startMs){
        Printf("Warning: End time is before start time\n");
    }
    
    local int durationMs = endMs - startMs;
    local string durationStr = FormatMilliseconds(durationMs);
    Printf("Runtime: %s (%dms)\n", durationStr, durationMs);
}

local string endTime = GetCurrentDateTime("hh:mm:ss:zzz");
CalculateRuntime(startTime, endTime);
