UBYTE   gameTime[2] <bgcolor=cBlue>;

int     unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;

long    endTime <bgcolor=cPurple>;

float   unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;
float   unk <bgcolor=cYellow>;

int     packetsCount <bgcolor=cPurple>;
local int p;
for (p = 0; p < packetsCount; p++){
        PACKET packet <comment=CommentPACKET>;
}
 
int     camCount <bgcolor=cPurple>;
local int c;
for (c = 0; c < camCount; c++){
        CAMERA cam <bgcolor=cYellow>;
}

int     itemCount <bgcolor=cPurple>;
local int y;
for (y = 0; y < itemCount; y++){
        int item <bgcolor=cGreen>;
}
string footer <bgcolor=cGreen>;


