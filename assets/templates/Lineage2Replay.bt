typedef struct {
    CHAR    date[8]                     <bgcolor=cBlue>;
} TIME;

typedef struct {
    ULONG time;
    INT yaw;
    INT pitch;
    INT distance;
    INT distance1;
} CAMERA;

typedef short location <bgcolor=cRed>;

typedef struct {
    TIME    packettime;                       
    UBYTE   packetOpcode[3]             <bgcolor=cGreen>;
    DWORD   packetSize                  <bgcolor=cRed>;
    UBYTE   packetData [packetSize]     <bgcolor=cYellow>;
    UBYTE   unkType[1]                  <bgcolor=cGray, fgcolor=cRed>;
} PACKET;

string CommentPACKET(PACKET& packet)
{
    local string sComment = "";
    switch(packet.packetOpcode[0])
    {
        case 0x32:
            sComment = "UserInfo ";
            break;
        case 0x0C:
            sComment = "NpcInfo ";
            break;
        case 0x92:
            sComment = "ServerObjectInfo ";
            break;
        case 0x9F:
            sComment = "StaticObject ";
            break;
        case 0xFE:
            sComment = "Ex";
            switch(packet.packetOpcode[2]){
                case 0x01:
                    switch(packet.packetOpcode[1]){
                        case 0x56:
                            sComment += "_UserInfo_EquipSlot";
                            break;
                        case 0x58:
                            sComment += "_UserInfo_AbnormalVisualEffect";
                            break;
                        default:
                        break;
                    }
                    break;
                case 0x02:
                    switch(packet.packetOpcode[1]){
                        case 0x54:
                            sComment += "_CharInfo";
                            break;
                    }
                    break;
                default:
                    sComment = SPrintf(sComment, "Ex 0x%X%X: Unknown", packet.packetOpcode[2], packet.packetOpcode[1]);
                break;
            }
            break;
        default:
            sComment = SPrintf(sComment, "0x%X: Unknown", packet.packetOpcode[0]);
            break;
    }

    return sComment;
}
//---------------------------------------------

LittleEndian(); 
string  header <bgcolor=cGreen>;
int     replayVersion <bgcolor=cPurple>;
float   loc_x <bgcolor=cGreen>;
float   loc_y <bgcolor=cGreen>;
