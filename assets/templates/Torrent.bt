/*
    Bencode
    https://en.wikipedia.org/wiki/Bencode
    
    Bittorrent Protocol Specification v1.0
    https://wiki.theory.org/BitTorrentSpecification
    
    Torrent file
    https://en.wikipedia.org/wiki/Torrent_file
*/

RequiresVersion(12, 0, 0);

// color
local int Int_Initial  <hidden=true> = 0x79C398;
local int Int_RawData  <hidden=true> = 0xFFB879;
local int Int_Trailing <hidden=true> = 0x79C398;
local int Str_Length   <hidden=true> = 0xFF7FAA;
local int Str_Delimiter<hidden=true> = 0xB000B0;
local int Str_RawData  <hidden=true> = 0x008000;
local int List_Prefix  <hidden=true> = 0xF092B3;
local int List_Suffix  <hidden=true> = 0xF092B3;
local int Dict_Prefix  <hidden=true> = 0x70ABFF;
local int Dict_Suffix  <hidden=true> = 0x70ABFF;


enum beType {Unknow, String, Integer, List, Dictionary};

string checksum(int algorithm, int64 start, int64 size){
    local char Hash[];
    ChecksumAlgStr(algorithm, Hash, start, size);
    return StrDel(Hash, sizeof(Hash) - 2, 2);
}

int valid_utf8(char data[]) {
    local int i = 0, x = 0, cnt = 0;
    for (i = 0; i < sizeof(data); i++) {
        x = (ubyte)data[i];
        if (!cnt) {
            if ((x >> 5) == 0b110) {
                cnt = 1;
            } else if ((x >> 4) == 0b1110) {
                cnt = 2;
            } else if ((x >> 3) == 0b11110) {
                cnt = 3;
            } else if ((x >> 7) != 0) return false;
        } else {
            if ((x >> 6) != 0b10) return false;
        cnt--;
        }
    }
    return cnt == 0;
}

int64 GetDataLen(char terminator) {
    local int64 pos = FTell(), len = 0;
    
    while(ReadByte(pos + len) != terminator)
        len++;
    
    return len;
}

int64 Atoi64(const char s[])
{
    local int64 n;
    SScanf(s, "%Ld", n);
    return n;
}

string FormatBytes(uint64 bytes)
{
	local const char units[6] = {' ', 'K', 'M', 'G', 'T', 'P'};
	local char length = sizeof(units) / sizeof(units[0]);
    local string suffix = "", fmt = "%.00lf %s";
	local int i = 0;
	local double dblBytes = bytes;
    
	if (bytes >= 1024) {
        fmt = "%.02lf %s";
		for (i = 0; (bytes / 1024) > 0 && i< length - 1; i++, bytes /= 1024)
			dblBytes = bytes / 1024.0;

        suffix += units[i];
        suffix += "B";
	} else suffix = "Bytes";

	local char output[200];
	SPrintf(output, fmt, dblBytes, suffix);
	return output;
}

char[] bin2hex(char buf_in[]) {
    local const char hex_asc[] = "0123456789ABCDEF";
    local char result[sizeof(buf_in) * 2] = {0};
    local int i;
    for (i = 0; i < sizeof(buf_in); i++) {
        result[i * 2 + 0] = hex_asc[((ubyte)buf_in[i] >> 4) & 0x0F];
        result[i * 2 + 1] = hex_asc[((ubyte)buf_in[i]     ) & 0x0F];
    }
    return result;
}

wstring GetKeyString(char s[]) {
    if (valid_utf8(s))
        return StringToWString(s, CHARSET_UTF8);
    else
        return bin2hex(s);
}

typedef struct (int size){
    local beType type               <name="Type"> = 1;
    char length[GetDataLen(':')]    <name="Length", fgcolor=Str_Length>;
    local int count                 <name="Count",  hidden=true> = Atoi64(length) / size;
    char delimiter                  <name="Delimiter", fgcolor=Str_Delimiter>;
    while (count--) {
        struct (int len) { char data[len]; } hash(size) <read=bin2hex(this.data), fgcolor=Str_RawData>;
    }
    count = Atoi64(length) / size;
} HashData;

typedef struct {
    local beType type<name="type"> = 4;
    local int count               <name="Count", hidden=true> = 0;
    char initial                  <name="Dict Initial", comment="Initial", fgcolor=Dict_Prefix>;
    while (ReadByte() != 'e') {
        count++;
        struct BDecoder Key       <name="Key",   read=bin2hex(this.rawdata)>; 
        struct HashData value(32) <name="Value", read=Str("Count: %d", this.count)>;
        }
    char trailing                 <name="Dict Trailing", comment="Trailing", fgcolor=Dict_Suffix>;
} Layers <read=Str("Dict Count: %d", this.count)>;

typedef struct {
    switch (ReadByte()) {
        // Byte strings are encoded as follows: <string length encoded in base ten ASCII>:<string data>
        // Note that there is no constant beginning delimiter, and no ending delimiter.
        case '0': case '1': case '2': case '3': case '4':
        case '5': case '6': case '7': case '8': case '9': {
            local beType type               <name="Type"> = 1;
            local int64  dataLen            <name="DataLength", hidden=true> = 0;
            local wstring value             <name="Value",      hidden=false> = L"";

            char length[GetDataLen(':')]    <name="Length",     fgcolor=Str_Length,      comment="length">;
            char delimiter                  <name="Delimiter",  fgcolor=Str_Delimiter,   comment="string length encoded in base ten ASCII">;
            dataLen = Atoi64(length);
            if (dataLen)
                char rawdata[dataLen]       <name="RawData",    fgcolor=Str_RawData,     comment="string data">;
            else
                local char rawdata[1]       <name="RawData",    fgcolor=Str_RawData,     hidden=true> = 0;          

            value = StringToWString(rawdata, CHARSET_UTF8);
            break;
        }

        // Integers are encoded as follows: i<integer encoded in base ten ASCII>e
        // The initial i and trailing e are beginning and ending delimiters.
        case 'i': {
            local beType type               <name="Type"> = 2;
            local int64 value               <name="Value",      hidden=true> = 0;

            char initial                    <name="Initial",    fgcolor=Int_Initial,  comment="Initial">;
            char rawdata[GetDataLen('e')]   <name="RawData",    fgcolor=Int_RawData,  comment="integer encoded in base ten ASCII">;
            char trailing                   <name="Trailing",   fgcolor=Int_Trailing, comment="Trailing">;

            value = Atoi64(rawdata);
            break;
        }

        // Lists are encoded as follows: l<bencoded values>e
        // The initial l and trailing e are beginning and ending delimiters. 
        // Lists may contain any bencoded type, including integers, strings, dictionaries, and even lists within other lists.
        case 'l': {
            local beType type           <name="Type"> = 3;
            local int    count          <name="Count", hidden=true> = 0;

            char initial                <name="List Initial", fgcolor=List_Prefix, comment="Initial">;
            while (ReadByte() != 'e') {
                struct BDecoder item    <name="Item", read=get_string>;
                count++;
            }
            char trailing              <name="List Trailing", fgcolor=List_Suffix, comment="Trailing">;

            break;
        }

        // Dictionaries are encoded as follows: d<bencoded string><bencoded element>e
        // The initial d and trailing e are the beginning and ending delimiters.
        // Note that the keys must be bencoded strings.
        // The values may be any bencoded type, including integers, strings, lists, and other dictionaries.
        // Keys must be strings and appear in sorted order (sorted as raw strings, not alphanumerics).
        // The strings should be compared using a binary comparison, not a culture-specific "natural" comparison.
        case 'd': {
            local beType type           <name="Type"> = 4;
            local int    count          <name="Count", hidden=true> = 0;

            char initial                <name="Dict Initial", comment="Initial", fgcolor=Dict_Prefix>;
            while (ReadByte() != 'e') {
                struct BDecoder key      <name="Key", read=GetKeyString(this.rawdata), comment="Byte string">;
                switch (key.value) {
                    case "creation date": {
                        struct BDecoder value    <name="Value", read=TimeTToString(this.value, "yyyy/MM/dd hh:mm:ss UTC")>; 
                        break;
                    }
                    
                    case "length": {
                        struct BDecoder value    <name="Value", read=FormatBytes(this.value)>;
                        break;
                    }
                    
                    case "ed2k"       : 
                    case "md5sum"     :
                    case "filehash"   : 
                    case "pieces root": {
                        struct BDecoder value    <name="Value", read=bin2hex(this.rawdata)>;
                        break;
                    }

                    case "pieces": {
                        struct HashData value(20)<name="Value",     read=Str("Piece Count: %d", this.count)>;
                        break;
                    }
                    
                    case "piece layers": {
                        struct Layers piece_layers<name="Value">;
                        break;
                    }

                    default: {
                        struct BDecoder value    <name="Value">;
                    }
                }
                count++;
            }
            char trailing               <name="Dict trailing", comment="Trailing", fgcolor=Dict_Suffix>;

            break;
        }

        default: {
            Printf("%s\n", "error");
            Exit(0);
        }
    }    
} BDecoder <read=get_string>;

wstring get_string(const struct BDecoder &v) {
    local wstring str = "";
    switch (v.type) {
        case 1: {
            str = v.value;
            break;
        }
        case 2: {
            str = Str("%Ld (%#LX)", v.value, v.value);
            break;
        }
        case 3: 
        case 4: {
            str = Str("(%s Count: %d)", EnumToString(v.type), v.count);
            break;
        }
        default: str = "unknow";
    }
    return (str);
}

int find_key(struct BDecoder &dict, string key) {
    local int index = -1, i;
    for (i = 0; i < dict.count; i++) {
        if (Stricmp(dict.key[i].rawdata, key) == 0) {
            index = i;
            break;
        }
    }
    return index;
}

BDecoder get_value(const struct BDecoder &v, string key_name) {
    local int key_index;
    key_index = find_key(v, key_name);
    if (key_index != -1)
        return v.value[key_index];
    else
        return -1;
}

BDecoder contents <name="Torrent File Struct", comment="Torrent Struct", open=true>;
