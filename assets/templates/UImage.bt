string compressType(uint8_t &c)
{
    switch (c)
    {
    case IH_COMP_NONE:
        return "No Compression Used";
    case IH_COMP_GZIP: /* gzip	 Compression Used	*/
        return "gzip";
    case IH_COMP_BZIP2: /* bzip2 Compression Used	*/
        return "bzip2";
    case IH_COMP_LZMA: /* lzma  Compression Used	*/
        return "lzma";
    case IH_COMP_LZO: /* lzo   Compression Used	*/
        return "lzo";
    case IH_COMP_LZ4: /* lz4   Compression Used	*/
        return "lz4";
    }
    return "Invalid value";
}

//-----------------------------------------------------------
// LittleEndian();
BigEndian();
image_header_t header<bgcolor = 0x22ddff>;

// Printf("%x, %x\n", IH_MAGIC, header.ih_magic);
if (header.ih_magic != IH_MAGIC)
{
    Printf("bad uboot header magic\n");
    return -1;
}
DisplayFormatHex();
char kernel[header.ih_size]<bgcolor = 0xffcc00>;
DisplayFormatHex();
local long pad = FileSize() - sizeof(image_header_t) - header.ih_size;
if (pad > 0)
{

    char padding[pad] <bgcolor = 0x229900>;
}
